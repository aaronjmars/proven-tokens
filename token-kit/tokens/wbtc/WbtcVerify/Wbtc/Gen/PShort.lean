/-!
# The paths of short and their completeness

Generated by `scripts/gen_paths.py` from the runtime bytecode; do not edit. Lean checks every
statement against `CODE`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace WbtcVerify.Paths

open UsdtVerify
open TokenKit
open WbtcVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic
open GasCosts

variable {fork : Fork} {message : Message fork}

open WbtcVerify.Blocks UsdtVerify.Complete UsdtVerify.Gas TokenKit.Complete

variable {state : State.TransactionState} {substate : Substate}

variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

theorem short_p0
    (hfork : .berlin ≤ fork)
    (hsize : message.data.size < 4)
    {gas : Nat} (hg : 46 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 46) state substate) := by
  have hd1 : (lessThan (BitVec.ofNat 256 message.data.size) (4 : U256)) ≠ 0 := by exact size_lt4_ne hsize
  step b0_1 hd1 (by simp) (by omega)
  exact haltGasL (b317_0 hfork (by simp) (by omega)) (by omega)

theorem ok_short (hfork : .berlin ≤ fork)
    (hsize : message.data.size < 4)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    False := by
  exact (no_okLE (B := 46) (fun g hg => short_p0 hfork hsize (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim

end WbtcVerify.Paths
