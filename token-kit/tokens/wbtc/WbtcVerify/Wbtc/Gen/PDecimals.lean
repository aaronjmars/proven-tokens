theorem decimals_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 241 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 241) state substate) := by
  have hd1 : (lessThan (BitVec.ofNat 256 message.data.size) (4 : U256)) = 0 := by exact size_lt4_zero hsize hsize'
  step b0_0 hd1 (by simp) (by omega)
  have hd2 : (equal (BitVec.ofNat 256 (selector message.data)) (97649499 : U256)) = 0 := by rw [hsel]; decide +kernel
  step b13_1 hd2 (by simp) (by omega)
  have hd3 : (equal (117300739 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b64_0 hd3 (by simp) (by omega)
  have hd4 : (equal (157198259 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b75_1 hd4 (by simp) (by omega)
  have hd5 : (equal (402637600 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b86_0 hd5 (by simp) (by omega)
  have hd6 : (equal (404098525 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b97_1 hd6 (by simp) (by omega)
  have hd7 : (equal (599290589 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b108_1 hd7 (by simp) (by omega)
  have hd8 : (equal (826074471 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b119_0 hd8 (by simp) (by omega)
  step b653_0 hc1 (by simp) (by omega)
  exact haltGasL (b661_0 hfork (by simp) (by omega)) (by omega)

