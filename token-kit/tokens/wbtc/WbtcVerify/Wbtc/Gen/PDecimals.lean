theorem ok_decimals (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (331 + (slotCost (coldIn substate message.currentTarget (5 : U256)))) ≤ gas ∧
        s.output = (wordBytes (bitwiseAnd (bitwiseAnd (255 : U256) (storageAt state message.currentTarget (5 : U256))) (255 : U256))) ∧
        s.gas = gas - (331 + (slotCost (coldIn substate message.currentTarget (5 : U256)))) ∧
        s.state = (readSlot state message.currentTarget (5 : U256)) ∧
        s.substate = (accessSlot substate message.currentTarget (5 : U256))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 241) (fun g hg => decimals_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (331 + (slotCost (coldIn substate message.currentTarget (5 : U256))))) (cost := (331 + (slotCost (coldIn substate message.currentTarget (5 : U256))))) (fun g hg => decimals_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

