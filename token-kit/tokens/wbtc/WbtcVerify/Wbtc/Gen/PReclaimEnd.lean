theorem ok_reclaimEnd {n bal owner t2 t sel ret : U256} {mem : ByteArray} (hfork : .berlin ≤ fork)
    (hmem_size : mem.size = 224)
    (hmem_fp : loadWord (memoryReadBytes mem 64 32) 0 32 = (128 : U256))
    (hmem_w128 : loadWord (memoryReadBytes mem 128 32) 0 32 = ret)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 3237 [n, (128 : U256), bal, owner, t2, (1617 : U256), bal, t, (570 : U256), sel] mem gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero (lessThan n (32 : U256))) ≠ 0 ∧
        (isZero (isZero ret)) ≠ 0 ∧
        79 ≤ gas ∧
        s.output = ByteArray.empty ∧
        s.gas = gas - 79 ∧
        s.state = state ∧
        s.substate = substate) := by
  by_cases hc1 : (isZero (lessThan n (32 : U256))) = 0
  ·
    exact (no_okLE (B := 31) (fun g hg => reclaimEnd_p0 hfork hmem_size hmem_fp hmem_w128 hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    by_cases hc2 : (isZero (isZero ret)) = 0
    ·
      exact (no_okLE (B := 56) (fun g hg => reclaimEnd_p1 hfork hmem_size hmem_fp hmem_w128 hc1 hc2 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
    ·
      obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := 79) (cost := 79) (fun g hg => reclaimEnd_p2 hfork hmem_size hmem_fp hmem_w128 hc1 hc2 (by omega)) start hrun hok
      exact ⟨hc1, hc2, hcg, ho, hgas, hst, hss⟩

/-- The conclusion of `ok_reclaimEnd`, as a predicate of the state, the substate and the gas of the
frame at the start of the segment and of the frame `s` that ends the run. -/
def reclaimEnd_ends (fork : Fork) (message : Message fork) (state : State.TransactionState)
    (substate : Substate) (gas : Nat) (s : Evm fork Nat) (n bal owner t2 t sel ret : U256) : Prop :=
    ((isZero (lessThan n (32 : U256))) ≠ 0 ∧
        (isZero (isZero ret)) ≠ 0 ∧
        79 ≤ gas ∧
        s.output = ByteArray.empty ∧
        s.gas = gas - 79 ∧
        s.state = state ∧
        s.substate = substate)

/-- `ok_reclaimEnd`, stated with `reclaimEnd_ends`. -/
theorem ok_reclaimEnd_ends {n bal owner t2 t sel ret : U256} {mem : ByteArray} (hfork : .berlin ≤ fork)
    (hmem_size : mem.size = 224)
    (hmem_fp : loadWord (memoryReadBytes mem 64 32) 0 32 = (128 : U256))
    (hmem_w128 : loadWord (memoryReadBytes mem 128 32) 0 32 = ret)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 3237 [n, (128 : U256), bal, owner, t2, (1617 : U256), bal, t, (570 : U256), sel] mem gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    reclaimEnd_ends fork message state substate gas s n bal owner t2 t sel ret :=
  ok_reclaimEnd hfork hmem_size hmem_fp hmem_w128 start hrun hok

