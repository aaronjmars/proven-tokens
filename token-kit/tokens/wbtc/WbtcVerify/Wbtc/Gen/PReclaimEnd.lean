theorem reclaimEnd_p0
    {n bal owner t2 t sel ret : U256}
    {mem : ByteArray}
    (hfork : .berlin ≤ fork)
    (hmem_size : mem.size = 224)
    (hmem_fp : loadWord (memoryReadBytes mem 64 32) 0 32 = (128 : U256))
    (hmem_w128 : loadWord (memoryReadBytes mem 128 32) 0 32 = ret)
    (hc1 : (isZero (lessThan n (32 : U256))) = 0)
    {gas : Nat} (hg : 31 ≤ gas) :
    Logic.SpecG fork (At CODE message 3237 [n, (128 : U256), bal, owner, t2, (1617 : U256), bal, t, (570 : U256), sel] mem gas state substate)
      (Halted true ByteArray.empty (gas - 31) state substate) := by
  step b3237_0 hc1 (by simp) (by omega)
  exact haltGasL (b3246_0 hfork (by simp) (by omega)) (by omega)

