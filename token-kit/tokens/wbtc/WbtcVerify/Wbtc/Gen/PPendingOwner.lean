theorem ok_pendingOwner (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xe30c3978)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (821 + (slotCost (coldIn substate message.currentTarget (6 : U256)))) ≤ gas ∧
        s.output = (wordBytes (bitwiseAnd (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (storageAt state message.currentTarget (6 : U256))) (1461501637330902918203684832716283019655932542975 : U256))) ∧
        s.gas = gas - (821 + (slotCost (coldIn substate message.currentTarget (6 : U256)))) ∧
        s.state = (readSlot state message.currentTarget (6 : U256)) ∧
        s.substate = (accessSlot substate message.currentTarget (6 : U256))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 593) (fun g hg => pendingOwner_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (821 + (slotCost (coldIn substate message.currentTarget (6 : U256))))) (cost := (821 + (slotCost (coldIn substate message.currentTarget (6 : U256))))) (fun g hg => pendingOwner_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

