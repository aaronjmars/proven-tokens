theorem ok_symbolEntry (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    (477 ≤ gas ∧
        ∃ z : Evm fork Nat,
          At CODE message 1000 [(BitVec.ofNat 256 (selector message.data))] (memW [(0 : U256), (0 : U256), (128 : U256)]) (gas - 477) state substate z ∧
          EndsL runChild z s) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  obtain ⟨hcg, z, hz, hzr⟩ := ok_splitLE (B := 477) (c := 477) (by omega) (fun g hg => symbolEntry_p0 hfork hsize hsize' hsel (by omega)) start hrun hok
  exact ⟨hcg, z, hz, hzr⟩

