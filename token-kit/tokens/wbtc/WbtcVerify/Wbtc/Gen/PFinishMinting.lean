theorem ok_finishMinting (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x7d64bcb4)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (equal message.caller.toU256 (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (div (storageAt state message.currentTarget (5 : U256)) (256 : U256)))) ≠ 0 ∧
        (636 + (slotCost (coldIn substate message.currentTarget (5 : U256)))) ≤ gas ∧
        s.output = (wordBytes (0 : U256)) ∧
        s.gas = gas - (636 + (slotCost (coldIn substate message.currentTarget (5 : U256)))) ∧
        s.state = (readSlot state message.currentTarget (5 : U256)) ∧
        s.substate = (accessSlot substate message.currentTarget (5 : U256))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 439) (fun g hg => finishMinting_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    by_cases hc2 : (equal message.caller.toU256 (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (div (storageAt state message.currentTarget (5 : U256)) (256 : U256)))) = 0
    ·
      exact (no_okLE (B := (570 + (slotCost (coldIn substate message.currentTarget (5 : U256))))) (fun g hg => finishMinting_p1 hfork hsize hsize' hsel hc1 hc2 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
    ·
      obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (636 + (slotCost (coldIn substate message.currentTarget (5 : U256))))) (cost := (636 + (slotCost (coldIn substate message.currentTarget (5 : U256))))) (fun g hg => finishMinting_p2 hfork hsize hsize' hsel hc1 hc2 (by omega)) start hrun hok
      exact ⟨hc1, hc2, hcg, ho, hgas, hst, hss⟩

