  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, mask_toU256', and_255_comm, and_255_idem, slot_5_6, slot_6_5, paused_pause, owner_pause, minting_pause, decimals_pause, paused_unpause, owner_unpause, minting_unpause, decimals_unpause, owner_claim, paused_claim, minting_claim, decimals_claim, mask_and_high, mask_or_high, logs_logSub1, Readable.logs_logSub2, log1, Readable.log2, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2
