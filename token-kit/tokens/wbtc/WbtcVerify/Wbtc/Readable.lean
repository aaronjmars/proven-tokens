/-- `_balances[a]` of the called contract in the state `S`. -/
abbrev balance (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot a 0)

/-- `_allowances[o][sp]` of the called contract in the state `S`. -/
abbrev allowance (m : Message fork) (S : State.TransactionState) (o sp : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot sp (mapSlot o 2))

/-- `_totalSupply` of the called contract in the state `S`. -/
abbrev totalSupply (m : Message fork) (S : State.TransactionState) : U256 :=
  storageAt S m.currentTarget 1

/-- The caller, as an address word. -/
abbrev sender (m : Message fork) : U256 := m.caller.toU256

/-- The first argument, masked to an address word. -/
abbrev addrArg1 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 4 32)

/-- The second argument, masked to an address word. -/
abbrev addrArg2 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 36 32)

/-- The argument words. -/
abbrev arg1 (m : Message fork) : U256 := loadWord m.data 4 32
abbrev arg2 (m : Message fork) : U256 := loadWord m.data 36 32
abbrev arg3 (m : Message fork) : U256 := loadWord m.data 68 32

/-- `owner` of the called contract in the state `S`: bits 8 to 167 of slot 5. -/
abbrev ownerOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (div (storageAt S m.currentTarget 5) (256 : U256))

/-- The byte of `paused` of the called contract in the state `S` (byte 22 of slot 5; not 0:
paused). -/
abbrev pausedOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (255 : U256) (div (storageAt S m.currentTarget 5)
    (95780971304118053647396689196894323976171195136475136 : U256))

/-- The byte of `mintingFinished` of the called contract in the state `S` (byte 21 of slot 5;
not 0: minting is finished). -/
abbrev mintingFinishedOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (255 : U256) (div (storageAt S m.currentTarget 5)
    (374144419156711147060143317175368453031918731001856 : U256))

/-- `decimals` of the called contract in the state `S`: byte 0 of slot 5. -/
abbrev decimalsOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (255 : U256) (storageAt S m.currentTarget 5)

/-- `pendingOwner` of the called contract in the state `S`: the low 160 bits of slot 6. -/
abbrev pendingOwnerOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (storageAt S m.currentTarget 6)

/-- The topic of the event `Transfer(address,address,uint256)`. -/
