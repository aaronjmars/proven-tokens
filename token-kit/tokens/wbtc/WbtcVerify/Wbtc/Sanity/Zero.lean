variable {fork : Fork}

/-- The four bytes of the selector of `mintingFinished()`. -/
def SEL_mintingFinished : ByteArray := ⟨#[0x05, 0xd2, 0x03, 0x5b]⟩

theorem size_SEL_mintingFinished : SEL_mintingFinished.size = 4 := by decide

/-- The call `mintingFinished()` from `Witness.CALLER1` to `C`. -/
abbrev m_mintingFinished (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C : Address) : Message fork :=
  sMsg b t C Witness.CALLER1 CODE SEL_mintingFinished

set_option maxHeartbeats 1000000 in
/-- The success path `mintingFinished_p1` is not empty: this call runs to the end with no error. -/
theorem mintingFinished_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_mintingFinished b t C) 0 [] .empty gas (sState C []) ss evm ∧
      (∀ {bound : Nat} (runChild : MessageRunner fork Nat bound),
        GasMeter.gasHeld evm.gas ≤ bound → EndsL runChild evm s) ∧ s.error = none ∧
      s.output = (wordBytes (isZero (isZero (bitwiseAnd (255 : U256) (div (storageAt (sState C []) (m_mintingFinished b t C).currentTarget (5 : U256)) (374144419156711147060143317175368453031918731001856 : U256)))))) ∧
      s.state = (readSlot (sState C []) (m_mintingFinished b t C).currentTarget (5 : U256)) := by
  have hdata : (m_mintingFinished b t C).data = SEL_mintingFinished := rfl
  have hsz : (m_mintingFinished b t C).data.size = 4 := size_SEL_mintingFinished
  have hsl : selector (m_mintingFinished b t C).data = selector SEL_mintingFinished := rfl
  have hval : (m_mintingFinished b t C).value = 0 := rfl
  have hcw : (m_mintingFinished b t C).caller.toU256 = Witness.CALLER1W := Witness.caller1_toU256
  have hct : (m_mintingFinished b t C).currentTarget = C := rfl
  have hacc : hasAccount (sState C []) C := hasAccount_sState C _
  have hspec := mintingFinished_p1 (fork := fork) (message := (m_mintingFinished b t C))
    (state := sState C []) (substate := ss)
    hfork
    (by rw [hsz]; decide)
    (by rw [hsz]; decide)
    (by rw [hsl]; decide)
    (by
      simp (disch := supply_side) only
        [hval, hsz, hcw, hct, storageAt_readSlot, Readable.storageAt_writeSlot_ite, storageAt_sState_cons, storageAt_sState_nil]
      <;> decide +kernel)
    (Nat.le_refl _)
  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_mintingFinished b t C) (sState C []) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, fun rc within => Witness.endsL_of_reaches hr hrun rc within, ?_,
    hH.2.2.1, hH.2.2.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

