/-- The entry of `name` (pc 363) with a nonzero value: REVERT. -/
theorem name_value {rest : List U256} {mem : ByteArray} {gas : Nat}
    (hfork : .berlin ≤ fork) (hc : (isZero message.value) = 0)
    (hrest : rest.length ≤ 900) (hg : 28 ≤ gas) :
    Logic.SpecG fork (At CODE message 363 (rest) mem gas state substate)
      (Halted true ByteArray.empty (gas - 28) state substate) := by
  step jumpdestR
  step Gas.callvalueG (by code_fact) (by code_fact) (by gas_ok) (by stk_ok)
  step dupR 0
  step unR 0x15 instruction_iszero
  step pushR 2 (375 : U256)
  at_pc 370
  step jumpi0R hc
  step pushR 1 (0 : U256)
  at_pc 373
  step dupR 0
  step Gas.reshapeG (g' := gas - 28) rfl rfl (by gas_ok)
  exact specL (revert0K hfork (by code_fact) (by code_fact))

/-- The entry of `symbol` (pc 1000) with a nonzero value: REVERT. -/
theorem symbol_value {rest : List U256} {mem : ByteArray} {gas : Nat}
    (hfork : .berlin ≤ fork) (hc : (isZero message.value) = 0)
    (hrest : rest.length ≤ 900) (hg : 28 ≤ gas) :
    Logic.SpecG fork (At CODE message 1000 (rest) mem gas state substate)
      (Halted true ByteArray.empty (gas - 28) state substate) := by
  step jumpdestR
  step Gas.callvalueG (by code_fact) (by code_fact) (by gas_ok) (by stk_ok)
  step dupR 0
  step unR 0x15 instruction_iszero
  step pushR 2 (1012 : U256)
  at_pc 1007
  step jumpi0R hc
  step pushR 1 (0 : U256)
  at_pc 1010
  step dupR 0
  step Gas.reshapeG (g' := gas - 28) rfl rfl (by gas_ok)
  exact specL (revert0K hfork (by code_fact) (by code_fact))

/-- From Berlin, a run of `CODE` from pc 0 that ends with no error has value 0: every
function of the table rejects a call that carries value. -/
theorem value_zero_of_ok (hfork : .berlin ≤ fork)
