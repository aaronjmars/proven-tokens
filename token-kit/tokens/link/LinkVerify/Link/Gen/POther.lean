    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    False := by
  exact (no_okLE (B := 327) (fun g hg => other_p0 hfork hsize hsize' hsel (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim

