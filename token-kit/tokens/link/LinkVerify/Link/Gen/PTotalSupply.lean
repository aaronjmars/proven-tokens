theorem totalSupply_p0
    (hfork : .berlin ≤ fork)
    (hsize : 1 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 147 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 147) state substate) := by
  have hd1 : (isZero (BitVec.ofNat 256 message.data.size)) = 0 := by exact size_isZero_zero hsize hsize'
  step b0_0 hd1 (by simp) (by omega)
  have hd2 : (equal (BitVec.ofNat 256 (selector message.data)) (117300739 : U256)) = 0 := by rw [hsel]; decide +kernel
  step b11_0 hd2 (by simp) (by omega)
  have hd3 : (equal (157198259 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b62_0 hd3 (by simp) (by omega)
  have hd4 : (equal (404098525 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b73_0 hd4 (by simp) (by omega)
  step b381_0 hc1 (by simp) (by omega)
  exact haltGasL (b388_0 hfork (by simp) (by omega)) (by omega)

