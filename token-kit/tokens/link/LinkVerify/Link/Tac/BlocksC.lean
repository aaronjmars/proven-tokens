    exact ⟨hsz, h64, h96⟩
  · rw [show (lg2Mem L mem F N W) = (lg2mMem L mem F N W (N % 32)) from if_neg h0]
    obtain ⟨hs, ha, hb, _⟩ := lg2m_mem (R := N % 32) hF hFm hFb hF0 hL hW hNF hsz h64 h96 (and31_toNat hL) rfl (Nat.pos_of_ne_zero h0)
    exact ⟨hs, ha, hb⟩

end LinkVerify.Tac
