/-- The substate at the end when the recipient has no code: the two writes, the two logs with
their topics and data, and the access of the recipient. -/
theorem tacDoneSs_eq (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) :
    tacDoneSs fork message state substate =
      accessAccount
        (logSub
          (logSub (tacXferSs fork message state substate) message.currentTarget (100389287136786176327247604509743168900146139575972864366142685224231313322991 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256))
            (tacLog1Data message))
          message.currentTarget (102029017914606134723578916497158998599466540794523729785997104939909681925142 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (tacTo message))
          (tacLog2Data message))
        (toAddressMasked (tacTo message)) := rfl

/-- The substate at the CALL: that of the end with no code, and the second access of the
recipient. -/
theorem tacCallSs_eq (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) :
    tacCallSs fork message state substate =
      accessAccount (tacDoneSs fork message state substate) (toAddressMasked (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256))) := rfl

/-- The state at the CALL: that of the end with no code, with the second read of the account. -/
theorem tacCallSt_eq {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    tacCallSt message state =
      (tacDoneSt message state).recordAccountRead (toAddressMasked (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256))) := rfl

