/-- The recipient, cut to 160 bits, is the zero address (the word the code tests). -/
def TacToZero {fork : Fork} (message : Message fork) : Prop :=
  (isZero (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256))) ≠ 0

/-- The recipient, cut to 160 bits, is not the zero address. -/
def TacToSet {fork : Fork} (message : Message fork) : Prop :=
  (isZero (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256))) = 0

/-- The recipient is the token itself. -/
def TacToSelf {fork : Fork} (message : Message fork) : Prop :=
  (isZero (isZero (isZero (equal (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (tacTo message)) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.currentTarget.toU256))))) = 0

/-- The recipient is not the token itself. -/
def TacToOther {fork : Fork} (message : Message fork) : Prop :=
  (isZero (isZero (isZero (equal (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (tacTo message)) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.currentTarget.toU256))))) ≠ 0

/-- The amount is above the balance of the caller. -/
def TacLow {fork : Fork} (message : Message fork) (state : State.TransactionState) : Prop :=
  (isZero (greaterThan (tacValue message) (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))))) = 0

/-- The amount is at most the balance of the caller. -/
def TacFunded {fork : Fork} (message : Message fork) (state : State.TransactionState) : Prop :=
  (isZero (greaterThan (tacValue message) (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))))) ≠ 0

/-- The new balance of the recipient wraps (the sum is below the old balance). -/
def TacOver {fork : Fork} (message : Message fork) (state : State.TransactionState) : Prop :=
  (isZero (lessThan (add (tacValue message) (storageAt (writeSlot (readSlot state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (1 : U256)) (sub (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) (tacValue message))) message.currentTarget (mapSlot (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256)))) (storageAt (writeSlot (readSlot state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (1 : U256)) (sub (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) (tacValue message))) message.currentTarget (mapSlot (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))))) = 0

/-- The new balance of the recipient does not wrap. -/
def TacFits {fork : Fork} (message : Message fork) (state : State.TransactionState) : Prop :=
  (isZero (lessThan (add (tacValue message) (storageAt (writeSlot (readSlot state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (1 : U256)) (sub (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) (tacValue message))) message.currentTarget (mapSlot (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256)))) (storageAt (writeSlot (readSlot state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (1 : U256)) (sub (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) (tacValue message))) message.currentTarget (mapSlot (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))))) ≠ 0

/-- The state gives the code `c` for the recipient. -/
def TacCode {fork : Fork} (message : Message fork) (state : State.TransactionState) (c : ByteArray) : Prop :=
  state.getCode (state.getAccount (toAddressMasked (tacTo message))).codeHash = .ok c

/-- The code of the recipient is not empty (the word the code tests). -/
def TacHasCode (c : ByteArray) : Prop :=
  (isZero (greaterThan (BitVec.ofNat 256 c.size) (0 : U256))) = 0

/-- The code of the recipient is empty. -/
def TacNoCode (c : ByteArray) : Prop :=
  (isZero (greaterThan (BitVec.ofNat 256 c.size) (0 : U256))) ≠ 0

/-- The balance of the caller: the word the code reads for the test of the amount. -/
def tacFromBal {fork : Fork} (message : Message fork) (state : State.TransactionState) : U256 :=
  (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256)))

/-- The balance of the recipient, read after the write of the new balance of the caller (so,
when the recipient is the caller, the balance less the amount). -/
def tacToBal {fork : Fork} (message : Message fork) (state : State.TransactionState) : U256 :=
  (storageAt (writeSlot (readSlot state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256) (1 : U256)) (sub (storageAt state message.currentTarget (mapSlot (bitwiseAnd message.caller.toU256 (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256))) (tacValue message))) message.currentTarget (mapSlot (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) (1 : U256)))

theorem equal_ne_zero_iff {a b : U256} : equal a b ≠ 0 ↔ a = b := by
  unfold equal
  constructor
  · intro h
    exact Classical.byContradiction fun e => h (if_neg e)
  · intro e h
    rw [if_pos e] at h
    exact absurd h (by decide)

theorem greaterThan_ne_zero_iff {a b : U256} : greaterThan a b ≠ 0 ↔ b.toNat < a.toNat := by
  unfold greaterThan
  constructor
  · intro h
    exact Classical.byContradiction fun e => h (if_neg e)
  · intro e h
    rw [if_pos e] at h
    exact absurd h (by decide)

theorem lessThan_ne_zero_iff {a b : U256} : lessThan a b ≠ 0 ↔ a.toNat < b.toNat := by
  unfold lessThan
  constructor
  · intro h
    exact Classical.byContradiction fun e => h (if_neg e)
  · intro e h
    rw [if_pos e] at h
    exact absurd h (by decide)

/-- `TacToZero`: the low 160 bits of the first argument are zero. -/
theorem tacToZero_iff {fork : Fork} (message : Message fork) :
    TacToZero message ↔ (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) = 0 :=
  isZero_ne_zero_iff

/-- `TacToSet` is the other side of `TacToZero`. -/
theorem tacToSet_iff {fork : Fork} (message : Message fork) :
    TacToSet message ↔ (bitwiseAnd (tacTo message) (1461501637330902918203684832716283019655932542975 : U256)) ≠ 0 :=
  isZero_eq_zero_iff

/-- `TacToSelf`: the recipient and the token have the same low 160 bits. -/
theorem tacToSelf_iff {fork : Fork} (message : Message fork) :
    TacToSelf message ↔ (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (tacTo message)) = (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.currentTarget.toU256) :=
  isZero_eq_zero_iff.trans (isZero_ne_zero_iff.trans (isZero_eq_zero_iff.trans equal_ne_zero_iff))

/-- `TacLow`: the balance of the caller is below the amount. -/
theorem tacLow_iff {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    TacLow message state ↔ (tacFromBal message state).toNat < (tacValue message).toNat :=
  isZero_eq_zero_iff.trans greaterThan_ne_zero_iff

/-- `TacFunded` is the other side of `TacLow`. -/
theorem tacFunded_iff {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    TacFunded message state ↔ (tacValue message).toNat ≤ (tacFromBal message state).toNat :=
  (not_congr (tacLow_iff message state)).trans Nat.not_lt

/-- `TacOver`: the sum of the amount and the balance of the recipient, modulo 2^256, is below
that balance. -/
theorem tacOver_iff {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    TacOver message state ↔
      (add (tacValue message) (tacToBal message state)).toNat < (tacToBal message state).toNat :=
  isZero_eq_zero_iff.trans lessThan_ne_zero_iff

/-- `TacFits` is the other side of `TacOver`. -/
theorem tacFits_iff {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    TacFits message state ↔
      (tacToBal message state).toNat ≤ (add (tacValue message) (tacToBal message state)).toNat :=
  (not_congr (tacOver_iff message state)).trans Nat.not_lt

/-- `TacHasCode`: the size of the code, as a word, is above zero. -/
theorem tacHasCode_iff (c : ByteArray) :
    TacHasCode c ↔ 0 < (BitVec.ofNat 256 c.size).toNat :=
  isZero_eq_zero_iff.trans greaterThan_ne_zero_iff

/-- `TacNoCode` is the other side of `TacHasCode`. -/
theorem tacNoCode_iff (c : ByteArray) : TacNoCode c ↔ ¬TacHasCode c := Iff.rfl

/-- The gas of the whole call when the recipient has no code. -/
def tacDoneGas (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) : Nat :=
  tac_noneCost fork message state substate (tacF message) (tacN message) (tacW message)

/-- The gas from the entry of the function to the GAS opcode before the CALL. -/
def tacCallGas (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) : Nat :=
  tac_callCost fork message state substate (tacF message) (tacN message) (tacW message)

/-- The gas from the entry of the function to the EXTCODESIZE of the recipient. -/
def tacExtGas (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) : Nat :=
  tac_extCost fork message state substate (tacF message) (tacN message) (tacW message)

/-- The state after the transfer and the read of the code of the recipient: the end state when
the recipient has no code. -/
def tacDoneSt {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    State.TransactionState :=
  tac_noneSt message state

/-- The state at the CALL. -/
def tacCallSt {fork : Fork} (message : Message fork) (state : State.TransactionState) :
    State.TransactionState :=
  tac_callSt message state

/-- The substate at the end when the recipient has no code. -/
def tacDoneSs (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) : Substate :=
  tac_noneSs fork message state substate (tacF message) (tacN message) (tacW message)

/-- The substate at the CALL. -/
def tacCallSs (fork : Fork) (message : Message fork) (state : State.TransactionState) (substate : Substate) : Substate :=
  tac_callSs fork message state substate (tacF message) (tacN message) (tacW message)

/-- The memory at the CALL. -/
def tacMem {fork : Fork} (message : Message fork) : ByteArray :=
  tac_callMem message (tacF message) (tacN message) (tacW message)

