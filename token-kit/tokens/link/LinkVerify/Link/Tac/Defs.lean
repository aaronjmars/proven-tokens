  memoryReadBytes (tacLogMem message) (tacF message) (tacW message + 96)

/-- The call data of the CALL to the recipient: `tacW message + 132` bytes of the memory from the
free memory pointer. -/
def tacCallData {fork : Fork} (message : Message fork) : ByteArray :=
  memoryReadBytes (tacMem message) (tacF message) (tacW message + 132)

