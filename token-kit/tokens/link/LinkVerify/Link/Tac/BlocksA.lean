  exact hoareL (restate (by decide) rfl rfl (by gas_ok) rfl rfl)

theorem vr_ok {to : U256} {value : U256} {sel : U256} {mem : ByteArray} {state : State.TransactionState} {substate : Substate}
    (hfork : .berlin ≤ fork)
    (hc1 : (isZero (bitwiseAnd to (1461501637330902918203684832716283019655932542975 : U256))) = 0)
    (hc2 : (isZero (isZero (isZero (equal (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) to) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.currentTarget.toU256))))) ≠ 0)
    {gas : Nat} (hg : vr_okCost ≤ gas) :
    Logic.HoareG fork (At CODE message 1277 [(96 : U256), value, to, (361 : U256), sel] mem gas state substate)
      (At CODE message 2618 [value, to, (2376 : U256), (0 : U256), (96 : U256), value, to, (1260 : U256), to, (0 : U256), (96 : U256), value, to, (361 : U256), sel] mem (gas - (vr_okCost)) state substate) :=
  vr_ok_raw hfork hc1 hc2 hg

end LinkVerify.Tac
