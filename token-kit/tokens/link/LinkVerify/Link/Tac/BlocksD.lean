    (hF0 : 128 ≤ F) (hFm : F % 32 = 0) (hW : W = (N + 31) / 32 * 32)
    (hsz : mem.size = S) (hSm : S % 32 = 0) (hSa : F + 160 ≤ S) (hSb : S ≤ F + W + 160)
    (h64 : loadWord (memoryReadBytes mem 64 32) 0 32 = fpw)
    (h96 : loadWord (memoryReadBytes mem 96 32) 0 32 = L) :
    (cp2Mem mem F W S).size = F + W + 160 ∧
    loadWord (memoryReadBytes (cp2Mem mem F W S) 64 32) 0 32 = fpw ∧
    loadWord (memoryReadBytes (cp2Mem mem F W S) 96 32) 0 32 = L := by
  obtain ⟨h1, h2⟩ := lp2_mem hFm hSm (W / 32) 0 mem
    (show mem.size = max S (F + 160 + 32 * 0) by rw [hsz]; omega)
  refine ⟨h1.trans (by omega), ?_, ?_⟩
  · show loadWord (memoryReadBytes (lp2Mem F S (W / 32) 0 mem) 64 32) 0 32 = fpw
    rw [h2 64 32 (by omega)]
    exact h64
  · show loadWord (memoryReadBytes (lp2Mem F S (W / 32) 0 mem) 96 32) 0 32 = L
    rw [h2 96 32 (by omega)]
    exact h96

/-- The copy loop 2, from its first round to its exit. -/
theorem cp2 {to : U256} {value : U256} {L : U256} {fpw : U256} {sel : U256} {mem : ByteArray} {state : State.TransactionState} {substate : Substate} {F : Nat} {N : Nat} {W : Nat} {S : Nat}
    (hF : fpw.toNat = F)
    (hFm : F % 32 = 0)
    (hFb : F < 2 ^ 128)
    (hF0 : 128 ≤ F)
    (hL : L.toNat = N)
    (hW : W = (N + 31) / 32 * 32)
    (hNF : W + 128 ≤ F)
    (hsz : mem.size = S)
    (hSm : S % 32 = 0)
    (hSa : F + 160 ≤ S)
    (hSb : S ≤ F + W + 160)
    {gas : Nat} (hg : cp2Cost F W S ≤ gas) :
    Logic.HoareG fork (At CODE message 2980 [(0 : U256), (128 : U256), (add (32 : U256) (add (32 : U256) (add (32 : U256) (add (32 : U256) (add (4 : U256) fpw))))), L, L, (128 : U256), (add (32 : U256) (add (32 : U256) (add (32 : U256) (add (32 : U256) (add (4 : U256) fpw))))), (add (32 : U256) (add (32 : U256) (add (4 : U256) fpw))), (add (4 : U256) fpw), (96 : U256), value, message.caller.toU256, (2764107062 : U256), (bitwiseAnd to (1461501637330902918203684832716283019655932542975 : U256)), to, (96 : U256), value, to, (2583 : U256), (0 : U256), (96 : U256), value, to, (1260 : U256), to, (0 : U256), (96 : U256), value, to, (361 : U256), sel] mem gas state substate)
      (At CODE message 3010 [L, (128 : U256), (add (32 : U256) (add (32 : U256) (add (32 : U256) (add (32 : U256) (add (4 : U256) fpw))))), (add (32 : U256) (add (32 : U256) (add (4 : U256) fpw))), (add (4 : U256) fpw), (96 : U256), value, message.caller.toU256, (2764107062 : U256), (bitwiseAnd to (1461501637330902918203684832716283019655932542975 : U256)), to, (96 : U256), value, to, (2583 : U256), (0 : U256), (96 : U256), value, to, (1260 : U256), to, (0 : U256), (96 : U256), value, to, (361 : U256), sel] (cp2Mem mem F W S) (gas - (cp2Cost F W S)) state substate) := by
  have e1 : max S (F + 160 + 32 * (0 + W / 32)) = F + W + 160 := by omega
  have e2 : max S (F + 160 + 32 * 0) = S := by omega
  have ec : cp2Cost F W S = W / 32 * 68 + 35 +
      (memoryGasCost (max S (F + 160 + 32 * (0 + W / 32))) - memoryGasCost (max S (F + 160 + 32 * 0))) := by
    simp only [cp2Cost, e1, e2]
  rw [ec] at hg ⊢
  exact lp2 hF hFm hFb hF0 hL hW hNF hSm hSa (W / 32) 0 (0 : U256) mem gas (by decide)
    (by omega) (by rw [e2]; exact hsz) hg

end LinkVerify.Tac
