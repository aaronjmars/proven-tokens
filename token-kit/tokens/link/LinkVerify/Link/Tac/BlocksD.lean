      ∀ a j, a + j ≤ F + 132 + 32 * k →
        memoryReadBytes (lp2Mem F S0 n k m) a j = memoryReadBytes m a j := by
  intro n
  induction n with
  | zero =>
    intro k m hs
    exact ⟨hs, fun _ _ _ => rfl⟩
  | succ n ih =>
    intro k m hs
    have hb : (lb2Mem m F (32 * k) (max S0 (F + 160 + 32 * k)) (max S0 (F + 160 + 32 * (k + 1)))).size = max S0 (F + 160 + 32 * (k + 1)) :=
