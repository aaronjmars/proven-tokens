def cp2Mem (mem : ByteArray) (F W S : Nat) : ByteArray := lp2Mem F S (W / 32) 0 mem

/-- The gas of the copy loop 2. -/
def cp2Cost (F W S : Nat) : Nat :=
  W / 32 * 68 + 35 + (memoryGasCost (F + W + 160) - memoryGasCost S)

