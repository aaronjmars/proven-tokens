theorem tac_call_mem_gen {F N W : Nat}
    (hL : (tacLen message).toNat = N)
    (hF : (tacFpw (tacLen message)).toNat = F)
    (hFe : F = W + 128)
    (hW : W = (N + 31) / 32 * 32)
    (hN : N < 2 ^ 64) :
    (tac_callMem message F N W).size = F + W + 160 ∧
    loadWord (memoryReadBytes (tac_callMem message F N W) 64 32) 0 32 = (tacFpw (tacLen message)) ∧
    loadWord (memoryReadBytes (tac_callMem message F N W) 96 32) 0 32 = (tacLen message) := by
  have hFm : F % 32 = 0 := by omega
  have hFb : F < 2 ^ 128 := by omega
  have hF0 : 128 ≤ F := by omega
  have hNF : W + 128 ≤ F := by omega
  obtain ⟨hsz1, h64_1, h96_1⟩ := dec_mem hL hF hFe hW hN
  obtain ⟨hsz3, h64_3, h96_3, _, _⟩ := xf1_mem hF hFm hFb hF0 hsz1 h64_1 h96_1
  obtain ⟨hsz4, h64_4, h96_4, _, _⟩ := xf2_mem hF hFm hFb hF0 hsz3 h64_3 h96_3
  obtain ⟨hsz5, h64_5, h96_5, _, _, _⟩ := xf3_mem hF hFm hFb hF0 hsz4 h64_4 h96_4
  obtain ⟨hsz6, h64_6, h96_6, _, _, _⟩ := lg1_mem hF hFm hFb hF0 hL hW hNF hsz5 h64_5 h96_5
  obtain ⟨hsz7, h64_7, h96_7⟩ := cp1_mem (S := (F + 96)) hF0 hFm hW hsz6 (by omega) (by omega) (by omega) h64_6 h96_6
  obtain ⟨hsz8, h64_8, h96_8⟩ := lg2_mem hF hFm hFb hF0 hL hW hNF hsz7 h64_7 h96_7
  obtain ⟨hsz10, h64_10, h96_10, _, _, _, _⟩ := fb1_mem (S1 := (max (F + W + 96) (F + 128))) (S2 := (max (max (F + W + 96) (F + 128)) (F + 160))) hF hFm hFb hF0 hL hW hNF hsz8 h64_8 h96_8 rfl rfl
  obtain ⟨hsz11, h64_11, h96_11⟩ := cp2_mem (S := (max (max (F + W + 96) (F + 128)) (F + 160))) hF0 hFm hW hsz10 (by omega) (by omega) (by omega) h64_10 h96_10
  obtain ⟨hsz12, h64_12, h96_12⟩ := fb2_mem hF hFm hFb hF0 hL hW hNF hsz11 h64_11 h96_11
  exact ⟨hsz12, h64_12, h96_12⟩

theorem tac_call_mem (hN : tacN message < 2 ^ 64) :
    (tac_callMem message (tacF message) (tacN message) (tacW message)).size = (tacF message) + (tacW message) + 160 ∧
    loadWord (memoryReadBytes (tac_callMem message (tacF message) (tacN message) (tacW message)) 64 32) 0 32 = (tacFpw (tacLen message)) ∧
    loadWord (memoryReadBytes (tac_callMem message (tacF message) (tacN message) (tacW message)) 96 32) 0 32 = (tacLen message) :=
  tac_call_mem_gen (F := tacF message) (N := tacN message) (W := tacW message) rfl (tacFpw_toNat rfl hN) rfl rfl hN

