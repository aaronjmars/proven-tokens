import LinkVerify.Link.Sep
import TokenKit.Evm.Readable
import TokenKit.Evm.ReadableOpt
import TokenKit.Evm.Opt06

/-!
# Facts from the jump conditions of Solidity 0.4 code compiled with the optimizer

Lemmas for the readable corollaries of LINK (`LinkVerify/Link/Readable.lean`, generated by
`scripts/gen_readable.py` with `readable_opts.facts = "checked04"`) that the shared library does
not have yet. Nothing here is about LINK alone, except the name of `mask_lt` in `slot_side`:
every lemma is a candidate for the kit.

- `ne_of_cond3`, `eq_of_cond3`: `require(a != b)` as compiled
  (`ISZERO ISZERO ISZERO (EQ a b)`), when it is not 0 and when it is 0.
- `ne_self_of_cond3`: the same when `b` is the masked address of the contract
  (`require(w != address(this))`): `w` is not the word of that address.
- `add_bound_ltc`, `add_nat_ltc`: the SafeMath addition `c = v + b; assert(c >= b)`
  (`ISZERO (LT (ADD v b) b)` is not 0): no overflow, and the sum as a natural number.
- `slot_side`: the tactic that closes the side goals of the slot rules of Sep.lean.
-/

namespace TokenKit.Readable

open TokenKit
open UsdtVerify

open EthLib.Base (Fork U256 Address)
open EthLib.Execution
open EthLib.Execution.Evm

/-- `require(a != b)` as solc 0.4 compiles it: `ISZERO ISZERO ISZERO (EQ a b)` is not 0. -/
theorem ne_of_cond3 {a b : U256} (h : isZero (isZero (isZero (equal a b))) ≠ 0) : a ≠ b := by
  intro e
  apply h
  subst e
  have e1 : equal a a = 1 := if_pos rfl
  rw [e1]
  decide

/-- `ISZERO ISZERO ISZERO (EQ a b)` is 0: `a = b`. -/
theorem eq_of_cond3 {a b : U256} (h : isZero (isZero (isZero (equal a b))) = 0) : a = b := by
  by_cases e : a = b
  · exact e
  · exfalso
    have e0 : equal a b = 0 := if_neg e
    rw [e0] at h
    exact absurd h (by decide)

/-- `require(w != address(this))` as solc 0.4 compiles it: `w` is not the word of the address of
the contract (the mask of 160 bits does not change the word of an address). -/
theorem ne_self_of_cond3 {w : U256} {c : Address}
    (h : isZero (isZero (isZero (equal w
      (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) c.toU256)))) ≠ 0) :
    w ≠ c.toU256 := by
  have e := ne_of_cond3 h
  rw [TokenKit.mask_toU256'] at e
  exact e

/-- After the SafeMath addition of Solidity 0.4 with the optimizer on (`c = v + b;
assert(c >= b)`), the sum is below `2^256`. -/
theorem add_bound_ltc {v b : U256} (h : isZero (lessThan (add v b) b) ≠ 0) :
    b.toNat + v.toNat < 2 ^ 256 := by
  have f := Supply.add_fact_ltc h
  have := (add v b).isLt
  omega

/-- After the same check, the sum as a natural number. -/
theorem add_nat_ltc {v b : U256} (h : isZero (lessThan (add v b) b) ≠ 0) :
    (add v b).toNat = v.toNat + b.toNat := by
  have f := Supply.add_fact_ltc h
  omega

end TokenKit.Readable

/-- Closes the side goals of the slot rules: a key of the call, a masked word below `2^160`, or
that the contract still has its account. -/
macro "slot_side" : tactic =>
  `(tactic| first
    | assumption
    | exact LinkVerify.mask_lt _
    | supply_side)
