theorem supply_name (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state :=
  inv_of_ro (Loops.ro_name hfork hsize' hsel start hrun hok) hinv

/-- A successful call of `symbol` keeps the invariant: it only reads. -/
