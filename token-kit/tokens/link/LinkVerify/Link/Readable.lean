import LinkVerify.Link.Invariant
import TokenKit.Evm.Readable
import TokenKit.Evm.ReadableOpt
import TokenKit.Evm.Opt06
import LinkVerify.Link.ReadableLib

/-!
# Readable corollaries of the success paths of LINK

Generated by `scripts/gen_readable.py` from the descriptions in the configuration of the token
(`readable`) and the success paths of `scripts/gen_paths.py`; do not edit. Each theorem is proved
from the raw-term theorem `ok_<fn>`.

`<fn>_readable`: a run of `CODE` from pc 0 with the selector of `<fn>` that ends with no error.
The first group of claims is what the call and the START state must satisfy; the second is the
output, the END storage as a function of the start storage, and the logs. A theorem whose
function writes two or more slots takes `Sep (callKeys message)` (the hypothesis on keccak of
Sep.lean, not proved): without it two of the slots could be the same slot.

Words of the call: `sender` is the caller, `addrArg1` and `addrArg2` the first two arguments
masked to 160 bits (as the bytecode masks them), `arg1`, `arg2`, `arg3` the argument words.
Numbers are compared as natural numbers (`.toNat`), so no claim wraps.

LINK (Solidity 0.4.16) has no check of the size of the call data: bytes of an argument past the
end of the call data read as zero, so no theorem here has a claim on `message.data.size`.
The total supply is no slot: `totalSupply()` returns the constant `10^27` of the code.
`approve`, `increaseApproval` and `decreaseApproval` write one slot, so their theorems take no
hypothesis on keccak; `transfer` and `transferFrom` take `Sep (callKeys message)`.
In `transfer`, `approve` and `transferFrom` the modifier `validRecipient` rejects the receiver
(or spender) 0 and the address of the contract itself (`message.currentTarget.toU256`).
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace LinkVerify.Readable

open UsdtVerify
open TokenKit TokenKit.Complete TokenKit.Readable
open LinkVerify LinkVerify.Paths LinkVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256 Address)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}
variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

/-- `_balances[a]` of the called contract in the state `S`. -/
abbrev balance (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot a 1)

/-- `_allowances[o][sp]` of the called contract in the state `S`. -/
abbrev allowance (m : Message fork) (S : State.TransactionState) (o sp : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot sp (mapSlot o 2))

/-- The caller, as an address word. -/
abbrev sender (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) m.caller.toU256

/-- The first argument, masked to an address word. -/
abbrev addrArg1 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 4 32)

/-- The second argument, masked to an address word. -/
abbrev addrArg2 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 36 32)

/-- The argument words. -/
abbrev arg1 (m : Message fork) : U256 := loadWord m.data 4 32
abbrev arg2 (m : Message fork) : U256 := loadWord m.data 36 32
abbrev arg3 (m : Message fork) : U256 := loadWord m.data 68 32

/-- The topic of the event `Transfer(address,address,uint256)`. -/
abbrev TRANSFER : U256 := (100389287136786176327247604509743168900146139575972864366142685224231313322991 : U256)

/-- The topic of the event `Approval(address,address,uint256)`. -/
abbrev APPROVAL : U256 := (63486140976153616755203102783360879283472101686154884697241723088393386309925 : U256)

/-- The topic of the event `Transfer(address,address,uint256,bytes)`. -/
abbrev TRANSFER_DATA : U256 := (102029017914606134723578916497158998599466540794523729785997104939909681925142 : U256)

/-- totalSupply(). Success needs no value. Then: returns the constant `10^27` held in the code (the total supply is no slot); no slot changes; no log. -/
theorem totalSupply_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((message.value = 0)) ∧
    ((s.output = wordBytes (1000000000000000000000000000 : U256)) ∧
      ((1000000000000000000000000000 : U256).toNat = 10 ^ 27) ∧
      (∀ k, storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs)) := by
  obtain ⟨hc1, hgas, hout, hg, hst, hsub⟩ :=
    ok_totalSupply hfork hsize' hsel start hrun hok
  obtain ⟨hsize, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, TRANSFER_DATA]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1
  have v1 := Readable.value_of_cond hc1
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)

/-- balanceOf(owner). Success needs no value. Then: returns `balances[owner]` (the argument masked to 160 bits); no slot changes; no log. The code has no check of the size of the call data: bytes of an argument past the end of the call data read as zero. -/
theorem balanceOf_readable (hfork : .berlin ≤ fork)
