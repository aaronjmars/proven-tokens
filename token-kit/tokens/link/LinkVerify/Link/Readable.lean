/-- transfer(to, value) with `from` the caller. Success needs: no value, a frame that may write, an account of the contract, `to` not 0 and not the contract itself (validRecipient), `value <= balances[from]`, and (when `to` is not `from`) no overflow of `balances[to]`. Then: returns 1; `balances[from]` is the old word minus `value` and `balances[to]` the old word plus `value` (when `to = from` the balance is unchanged); every other slot keeps its word; exactly one log, Transfer(from, to, value). The code has no check of the size of the call data: bytes of an argument past the end of the call data read as zero. -/
theorem transfer_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xa9059cbb)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((message.value = 0) ∧
      (message.isStatic = false) ∧
      (hasAccount state message.currentTarget) ∧
      ((addrArg1 message) ≠ 0) ∧
      ((addrArg1 message) ≠ message.currentTarget.toU256) ∧
      ((arg2 message).toNat ≤ (balance message state (sender message)).toNat) ∧
      ((addrArg1 message) ≠ (sender message) → (balance message state (addrArg1 message)).toNat + (arg2 message).toNat < 2 ^ 256)) ∧
    ((s.output = wordBytes 1) ∧
      ((addrArg1 message) ≠ (sender message) → (balance message s.state (sender message)).toNat = (balance message state (sender message)).toNat - (arg2 message).toNat ∧ (balance message s.state (addrArg1 message)).toNat = (balance message state (addrArg1 message)).toNat + (arg2 message).toNat) ∧
      ((addrArg1 message) = (sender message) → balance message s.state (sender message) = balance message state (sender message)) ∧
      (∀ k, k ≠ mapSlot (sender message) 1 → k ≠ mapSlot (addrArg1 message) 1 → storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs.push (Readable.log3 message.currentTarget TRANSFER (sender message) (addrArg1 message) (wordBytes (arg2 message))))) := by
  obtain ⟨hc1, hc2, hc3, hc4, hc5, hstatic, hacc, hgas, hout, hg, hst, hsub⟩ :=
    ok_transfer hfork hsize' hsel start hrun hok
  obtain ⟨hsize, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, TRANSFER_DATA]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2 hc3 hc4 hc5
  by_cases hd1 : (addrArg1 message) = (sender message)
  · simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, TRANSFER_DATA] at hd1
    try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2 hc3 hc4 hc5
    have v1 := Readable.value_of_cond hc1
    have v2 := Readable.ne_of_isZero0 hc2
    have e3 := Readable.ne_self_of_cond3 hc3
    have l4 := Readable.le_of_cond_gt1 hc4
    have f4 := Readable.sub_fact1 hc4
    have b5 := Readable.add_bound_ltc hc5
    have f5 := Readable.add_nat_ltc hc5
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_⟩
    all_goals first
      | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
      | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)
  · have hd1' : ¬((sender message) = (addrArg1 message)) := fun e => hd1 e.symm
    simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, TRANSFER_DATA] at hd1 hd1'
    try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, hd1, hd1', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2 hc3 hc4 hc5
    have v1 := Readable.value_of_cond hc1
    have v2 := Readable.ne_of_isZero0 hc2
    have e3 := Readable.ne_self_of_cond3 hc3
    have l4 := Readable.le_of_cond_gt1 hc4
    have f4 := Readable.sub_fact1 hc4
    have b5 := Readable.add_bound_ltc hc5
    have f5 := Readable.add_nat_ltc hc5
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_⟩
    all_goals first
      | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, hd1, hd1', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
      | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, and_mask_comm, hd1, hd1', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)

/-- approve(spender, value) from the caller `owner`. Success needs: no value, a frame that may write, an account of the contract, `spender` not 0 and not the contract itself (validRecipient). Then: returns 1; `allowed[owner][spender]` is `value`; every other slot keeps its word; exactly one log, Approval(owner, spender, value). No hypothesis on keccak is needed. The code has no check of the size of the call data: bytes of an argument past the end of the call data read as zero. -/
theorem approve_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x095ea7b3)
    {gas : Nat} {evm s : Evm fork Nat}
