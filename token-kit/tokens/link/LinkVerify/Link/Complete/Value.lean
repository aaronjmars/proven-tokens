    exact no_okLE (B := 25) (fun g hg => symbol_value hfork hc (by simp) hg)
      (fun _ e h => reverted_error e h) hz hzr hok
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    exact no_okLE (B := 301) (fun g hg => transfer_p0 hfork hsize hsize' h hc (by omega))
      (fun _ e h => reverted_error e h) start hrun hok
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0xd73dd623 := hi
    exact no_okLE (B := 323) (fun g hg => increaseApproval_p0 hfork hsize hsize' h hc (by omega))
      (fun _ e h => reverted_error e h) start hrun hok
