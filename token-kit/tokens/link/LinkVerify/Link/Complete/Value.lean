variable {state : State.TransactionState} {substate : Substate}

variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

/-- The entry of `name` (pc 188) with a nonzero value: REVERT. -/
theorem name_value {rest : List U256} {mem : ByteArray} {gas : Nat}
    (hfork : .berlin ≤ fork) (hc : (isZero message.value) = 0)
    (hrest : rest.length ≤ 900) (hg : 25 ≤ gas) :
    Logic.SpecG fork (At CODE message 188 (rest) mem gas state substate)
      (Halted true ByteArray.empty (gas - 25) state substate) := by
  step jumpdestR
  step Gas.callvalueG (by code_fact) (by code_fact) (by gas_ok) (by stk_ok)
  step unR 0x15 instruction_iszero
  step pushR 2 (199 : U256)
  at_pc 194
  step jumpi0R hc
  step pushR 1 (0 : U256)
  at_pc 197
  step dupR 0
  step Gas.reshapeG (g' := gas - 25) rfl rfl (by gas_ok)
  exact specL (revert0K hfork (by code_fact) (by code_fact))

/-- The entry of `symbol` (pc 743) with a nonzero value: REVERT. -/
theorem symbol_value {rest : List U256} {mem : ByteArray} {gas : Nat}
    (hfork : .berlin ≤ fork) (hc : (isZero message.value) = 0)
    (hrest : rest.length ≤ 900) (hg : 25 ≤ gas) :
    Logic.SpecG fork (At CODE message 743 (rest) mem gas state substate)
      (Halted true ByteArray.empty (gas - 25) state substate) := by
  step jumpdestR
  step Gas.callvalueG (by code_fact) (by code_fact) (by gas_ok) (by stk_ok)
  step unR 0x15 instruction_iszero
  step pushR 2 (754 : U256)
  at_pc 749
  step jumpi0R hc
  step pushR 1 (0 : U256)
  at_pc 752
  step dupR 0
  step Gas.reshapeG (g' := gas - 25) rfl rfl (by gas_ok)
  exact specL (revert0K hfork (by code_fact) (by code_fact))

/-- From Berlin, a run of `CODE` from pc 0 that ends with no error has value 0: every
function of the table rejects a call that carries value. -/
theorem value_zero_of_ok (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    message.value = 0 := by
  obtain ⟨hsize, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  refine Classical.byContradiction fun hv => ?_
  have hc : (isZero message.value) = 0 := isZero_eq_zero_iff.mpr hv
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    obtain ⟨-, z, hz, hzr⟩ := ok_nameEntry hfork hsize' h start hrun hok
    exact no_okLE (B := 25) (fun g hg => name_value hfork hc (by simp) hg)
      (fun _ e h => reverted_error e h) hz hzr hok
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    exact no_okLE (B := 125) (fun g hg => approve_p0 hfork hsize hsize' h hc (by omega))
      (fun _ e h => reverted_error e h) start hrun hok
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    exact no_okLE (B := 147) (fun g hg => totalSupply_p0 hfork hsize hsize' h hc (by omega))
      (fun _ e h => reverted_error e h) start hrun hok
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    exact no_okLE (B := 169) (fun g hg => transferFrom_p0 hfork hsize hsize' h hc (by omega))
      (fun _ e h => reverted_error e h) start hrun hok
  | ⟨4, _⟩, hi =>
