import BnbVerify.Bnb.Gen
import BnbVerify.Bnb.Sep
import BnbVerify.Bnb.Gen.Loops

/-!
# The supply invariant of BNB is kept by every successful call

Generated by `scripts/gen_supply.py` from the success paths of `scripts/gen_paths.py`; do not
edit. Lean checks every statement against `CODE`.

- `supply_<fn>`: a run of `CODE` from pc 0 with the selector of `<fn>` that ends with no error
  keeps `Inv` (the sum of all `balanceOf` plus the sum of all `freezeOf` is `totalSupply`), under `Sep (callKeys message)`.
- `supply_preserved`: the same for any selector other than 0x3bed33ce.

`Sep (callKeys message)` is the hypothesis on keccak of BnbVerify/Bnb/Sep.lean; it is assumed,
not proved.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace BnbVerify

open UsdtVerify
open TokenKit
open BnbVerify.Paths BnbVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}

/-- A successful call of `totalSupply` keeps the invariant. -/
theorem supply_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hsep : Sep (callKeys message))
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state := by
  obtain ⟨hc1, hgas, hout, hg, hst, hsub⟩ :=
    ok_totalSupply hfork hsize' hsel start hrun hok
  rw [hst]
  clear hst hgas hout hg hsub start hrun hok
  try simp only [mask_idem, storageAt_readSlot] at *
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  unfold Inv Supply.Inv2 at hinv ⊢
  simp (disch := slot_side) only
    [Supply.D2_read, D_bal hsep, D_frz hsep, D_tot hsep, D_allow hsep, storageAt_readSlot]
  omega

