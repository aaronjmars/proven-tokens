theorem decimals_p0
    (hfork : .berlin ≤ fork)
    (hsize : 1 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 194 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 194) state substate) := by
  step enter hsize hsize' ⟨4, by decide⟩ (key := 0x313ce567) (dest := 621) (N := 169) (by decide) (by decide) (by decide) hsel (by omega)
  step b621_0 hc1 (by simp) (by omega)
  exact haltGas (b628_0 hfork (by simp) (by omega)) (by omega)

theorem decimals_p1
    (hfork : .berlin ≤ fork)
    (hsize : 1 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : (319 + (slotCost (coldIn substate message.currentTarget (2 : U256)))) ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted false (wordBytes (bitwiseAnd (255 : U256) (bitwiseAnd (255 : U256) (bitwiseAnd (255 : U256) (div (storageAt state message.currentTarget (2 : U256)) (1 : U256)))))) (gas - (319 + (slotCost (coldIn substate message.currentTarget (2 : U256))))) (readSlot state message.currentTarget (2 : U256)) (accessSlot substate message.currentTarget (2 : U256))) := by
  step enter hsize hsize' ⟨4, by decide⟩ (key := 0x313ce567) (dest := 621) (N := 169) (by decide) (by decide) (by decide) hsel (by omega)
  step b621_1 hc1 (by simp) (by omega)
  step b632_0 (by simp) (by omega)
  step b2817_0 hfork (by simp) (by omega)
  exact haltGas (b640_0 (by simp) (by omega)) (by omega)

theorem ok_decimals (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (319 + (slotCost (coldIn substate message.currentTarget (2 : U256)))) ≤ gas ∧
        s.output = (wordBytes (bitwiseAnd (255 : U256) (bitwiseAnd (255 : U256) (bitwiseAnd (255 : U256) (div (storageAt state message.currentTarget (2 : U256)) (1 : U256)))))) ∧
        s.gas = gas - (319 + (slotCost (coldIn substate message.currentTarget (2 : U256)))) ∧
        s.state = (readSlot state message.currentTarget (2 : U256)) ∧
        s.substate = (accessSlot substate message.currentTarget (2 : U256))) := by
  have hsize : 1 ≤ message.data.size := size_of_selector hsel (by decide)
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 194) (fun g hg => decimals_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactE (B := (319 + (slotCost (coldIn substate message.currentTarget (2 : U256))))) (cost := (319 + (slotCost (coldIn substate message.currentTarget (2 : U256))))) (by omega) (fun g hg => decimals_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

