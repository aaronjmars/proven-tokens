    (fun G hG => Gas.pushG (n := 1) (word := (0 : U256)) (by decide) (by code_fact) (by code_fact) (decode_push 1 (by decide)) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
