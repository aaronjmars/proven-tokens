theorem name_s226 (hfork : .berlin ≤ fork) {x0 : U256} {mem : ByteArray} {g : Nat} {S : State.TransactionState} {ss : Substate}
    {l s : Evm fork Nat}
    (h0 : At CODE message 226 [x0] mem g S ss l)
    (e0 : Ends fork l s) (hok : s.error = none) :
      (∃ (y0 : U256) (mem' : ByteArray) (g' : Nat) (S' : State.TransactionState) (ss' : Substate)
        (l' : Evm fork Nat), At CODE message 237 [y0] mem' g' S' ss' l' ∧
        Ends fork l' s ∧ g' < g ∧ Ro message.currentTarget S ss S' ss') ∨
      (∃ (y0 : U256) (mem' : ByteArray) (g' : Nat) (S' : State.TransactionState) (ss' : Substate)
        (l' : Evm fork Nat), At CODE message 233 [y0] mem' g' S' ss' l' ∧
        Ends fork l' s ∧ g' < g ∧ Ro message.currentTarget S ss S' ss') := by
  obtain ⟨g1, l1, h1, e1, hg1, hs1⟩ := Safe.stepE (pc' := 227) h0 e0 hok
    (fun G hG => Gas.jumpdestG (by code_fact) (by code_fact) hG) (by decide)
  obtain ⟨g2, l2, h2, e2, hg2, -⟩ := Safe.stepE (pc' := 228) h1 e1 hok
    (fun G hG => Gas.callvalueG (by code_fact) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  clear h1 e1
  obtain ⟨g3, l3, h3, e3, hg3, -⟩ := Safe.stepE (pc' := 229) h2 e2 hok
    (fun G hG => Gas.unaryG (byte := 0x15) (by code_fact) (by code_fact) (ofByte_of_decode rfl (Fork.frontier_le _)) instruction_iszero hG) (by decide)
  clear h2 e2
  obtain ⟨g4, l4, h4, e4, hg4, -⟩ := Safe.stepE (pc' := 232) h3 e3 hok
    (fun G hG => Gas.pushG (n := 2) (word := (237 : U256)) (by decide) (by code_fact) (by code_fact) (decode_push 2 (by decide)) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  clear h3 e3
  rcases Safe.jumpiE (pcT := 237) (pcF := 233) h4 e4 hok (by code_fact) (by code_fact)
      (by valid_dest) (by decide) (by decide) with
    ⟨g5, l5, h5, e5, hg5⟩ | ⟨g5, l5, h5, e5, hg5⟩
  · exact .inl ⟨_, _, _, _, _, _, h5, e5, by omega, by ro_reads⟩
  · exact .inr ⟨_, _, _, _, _, _, h5, e5, by omega, by ro_reads⟩

theorem name_s233 (hfork : .berlin ≤ fork) {x0 : U256} {mem : ByteArray} {g : Nat} {S : State.TransactionState} {ss : Substate}
    {l s : Evm fork Nat}
    (h0 : At CODE message 233 [x0] mem g S ss l)
