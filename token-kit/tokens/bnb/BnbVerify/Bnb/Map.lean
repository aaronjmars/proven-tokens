import UsdtVerify.Evm.Calldata
import UsdtVerify.Evm.GasRules
import EthLib.Execution.Proofs.Evm.Logic.Branch
import EthLib.Execution.Proofs.Evm.Logic.Stack
import BnbVerify.Bnb.Steps

/-!
# The dispatcher of BNB and the storage layout it reads

The storage of the BNB contract (Solidity 0.4.12, optimizer off), as the bytecode reads it:

- slot 0: `name`; slot 1: `symbol`; slot 2: `decimals` in the low byte;
- slot 3: `totalSupply`;
- slot 4: `owner` in the low 160 bits;
- slot 5: the base of the mapping `balanceOf` (`mapSlot a 5`);
- slot 6: the base of the mapping `freezeOf` (`mapSlot a 6`);
- slot 7: the base of the nested mapping `allowance` (`allowance[o][s]` at
  `mapSlot s (mapSlot o 7)`).

`mapSlot` and `storageAt` are generic (usdt-verify, Evm/Storage.lean).

The parts below keep their own headers:

- The dispatcher of BNB
- The selector table of BNB
-/

section

/-!
## The dispatcher of BNB

- At 0, `60 60 60 40 52` writes the word 0x60 at offset 0x40 of memory (the free memory pointer).
- At 5, `36 15 61 00 d9 57` jumps to 0xd9 (217, the fallback) when the call data is empty. There
  is no test that the call data has 4 bytes: a call data of 1 to 3 bytes is read with zeros
  after its end.
- At 11, the code divides the call data word at 0 by `2 ^ 224` and masks it to 32 bits.
- At 52, a table of 15 entries compares that selector with each key and jumps to its function.
-/

namespace BnbVerify

open UsdtVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic
open GasCosts

variable {fork : Fork} {message : Message fork} {state : State.TransactionState}
  {substate : Substate}

/-- The memory after the first write: 96 bytes, with the word 0x60 at offset 0x40. -/
def MEM0 : ByteArray := memoryWrite (memoryExtend .empty 96) 64 (wordBytes 0x60)

/-- The size word of a call data that is not empty is not 0. -/
theorem isZero_size (hsize : 1 ≤ message.data.size) (hsize' : message.data.size < 2 ^ 256) :
    isZero (BitVec.ofNat 256 message.data.size) = 0 := by
  have hne : (BitVec.ofNat 256 message.data.size : U256) ≠ 0 := by
    intro h
    have h2 := congrArg BitVec.toNat h
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hsize'] at h2
    have h0 : (0 : U256).toNat = 0 := rfl
    omega
  unfold isZero
  split
  · contradiction
  · rfl

/-- The size word of an empty call data is 0. -/
theorem isZero_size_empty (hsize : message.data.size = 0) :
    isZero (BitVec.ofNat 256 message.data.size) ≠ 0 := by
  rw [hsize]
  decide

/-- A call data whose selector is not 0 is not empty. -/
theorem size_of_selector {data : ByteArray} {k : Nat} (hsel : selector data = k) (hk : k ≠ 0) :
    1 ≤ data.size := by
  rcases Nat.eq_zero_or_pos data.size with h | h
  · exfalso
    apply hk
    rw [← hsel]
    have hz : ∀ j, EthLib.Base.byteAt data j = 0 := fun j =>
      EthLib.Base.byteAt_of_size_le (by omega)
    unfold selector
    rw [hz, hz, hz, hz]
    decide
  · exact h

/-- The code before the table: from a call data that is not empty, it computes the selector. -/
theorem prelude (hsize : 1 ≤ message.data.size) (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} (hg : 59 ≤ gas) :
    Gas.HoareG fork (At CODE message 0 [] .empty gas state substate)
      (At CODE message 52 [BitVec.ofNat 256 (selector message.data)] MEM0 (gas - 59) state
        substate) := by
  have hext : extendMemory ByteArray.empty.size [((BitVec.ofNat 256 (0x40 : UInt8).toNat : U256),
      (32 : U256))] = ⟨9, 96⟩ := by decide
  step push1R 0x60
  step push1R 0x40
  step Gas.mstoreG (by code_fact) (by code_fact) (by simp only [hext]; omega)
  step Gas.reshapeG rfl (by rw [hext]) (show _ = gas - 18 by simp only [hext]; omega)
  step Gas.calldatasizeG (by code_fact) (by code_fact) (by gas_ok) (by stk_ok)
  step unR 0x15 instruction_iszero
  step pushR 2 0x00d9
  step jumpi0R (isZero_size hsize hsize')
  step push1R 0x00
  step Gas.calldataloadG (by code_fact) (by code_fact) (by gas_ok)
  step pushR 29 (BitVec.ofNat 256 (2 ^ 224))
  step swapR 0
  step binR 0x04 (instruction_of_stackOnlyStep rfl)
  step pushR 4 (BitVec.ofNat 256 0xffffffff)
  step binR 0x16 (instruction_of_stackOnlyStep rfl)
  refine Gas.reshapeG ?_ (by rfl) (by gas_ok)
  have h0 : (BitVec.ofNat 256 (UInt8.toNat 0) : U256).toNat = 0 := by decide
  simp only [h0, List.cons.injEq, and_true]
  exact selector_word message.data

end BnbVerify

end

section

/-!
## The selector table of BNB

The table starts at 52 and has 15 entries of 11 bytes: DUP1, PUSH4 key, EQ, PUSH2 destination, JUMPI.

`ENTRIES` lists them as they are in the bytecode (generated by `scripts/map.py`; see docs/MAP.md).

After the table, at 217, the code handles a selector that no entry has (the fallback).
-/

namespace BnbVerify

open UsdtVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

/-- The entries of the selector table, each a key and its destination. -/
def ENTRIES : List (U256 × U256) := [
  (0x06fdde03, 226),
  (0x095ea7b3, 369),
  (0x18160ddd, 459),
  (0x23b872dd, 500),
  (0x313ce567, 621),
  (0x3bed33ce, 668),
  (0x42966c68, 703),
  (0x6623fc46, 762),
  (0x70a08231, 821),
  (0x8da5cb5b, 898),
  (0x95d89b41, 983),
  (0xa9059cbb, 1126),
  (0xcd4217c1, 1192),
  (0xd7a78db8, 1269),
  (0xdd62ed3e, 1328)]

/-- An entry of a table in front of the rest, with the rest as the first goal. -/
theorem Table.cons' {code : ByteArray} {n m : Fin 33} {pc : Nat} {key dest : U256}
    {entries : List (U256 × U256)} (rest : Table code n m (pc + entrySize n m) entries)
    (b0 : ByteAt code pc 0x80) (b1 : ByteAt code (pc + 1) (0x5f + UInt8.ofNat n.val))
    (hkey : pushData code (pc + 1) n = key) (b2 : ByteAt code (pc + 1 + (1 + n)) 0x14)
    (b3 : ByteAt code (pc + 1 + (1 + n) + 1) (0x5f + UInt8.ofNat m.val))
    (hdest : pushData code (pc + 1 + (1 + n) + 1) m = dest)
    (b4 : ByteAt code (pc + 1 + (1 + n) + 1 + (1 + m)) 0x57)
    (valid : isValidJumpDest (validJumpDestinations code) dest.toNat = true) :
    Table code n m pc ((key, dest) :: entries) :=
  ⟨b0, b1, hkey, b2, b3, hdest, b4, valid, rest⟩

/-- The code holds the selector table at 52, with keys of 4 bytes and destinations of 2. -/
theorem table : Table CODE 4 2 52 ENTRIES := by
  unfold ENTRIES
  repeat refine Table.cons' ?_ ⟨?_, ?_⟩ ⟨?_, ?_⟩ ?_ ⟨?_, ?_⟩ ⟨?_, ?_⟩ ?_ ⟨?_, ?_⟩ ?_
  all_goals first | exact True.intro | code_fact | valid_dest

variable {fork : Fork} {message : Message fork} {state : State.TransactionState}
  {substate : Substate}

/-- The dispatcher runs the prelude and the table. -/
theorem dispatch (hsize : 1 ≤ message.data.size) (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} (hg : 59 + 22 * tested (BitVec.ofNat 256 (selector message.data)) ENTRIES ≤ gas) :
    Gas.HoareG fork (At CODE message 0 [] .empty gas state substate)
      (At CODE message (branch (BitVec.ofNat 256 (selector message.data)) 52 (entrySize 4 2) ENTRIES)
        [BitVec.ofNat 256 (selector message.data)] MEM0
        (gas - 59 - 22 * tested (BitVec.ofNat 256 (selector message.data)) ENTRIES) state
        substate) :=
  (prelude hsize hsize' (by omega)).seq
    (Gas.branchTableG (by decide) (by decide) (by simp [STACK_LIMIT]) table (by omega))

end BnbVerify

end
