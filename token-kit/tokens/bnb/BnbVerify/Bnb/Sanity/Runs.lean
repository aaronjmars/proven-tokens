import BnbVerify.Bnb.Gen
import TokenKit.Evm.Witness
import TokenKit.Evm.Witness2

/-!
# Sanity: every success path of BNB has a concrete run

Generated by `scripts/gen_sanity.py` from the success paths of `scripts/gen_paths.py` and the
argument words of the configuration (`sanity`); do not edit.

`<fn>_runs`: in a state with one account at the contract `C`, where the slots listed in
`config/bnb.json` (`sanity.<fn>.state`) hold the word 5 and every other slot 0, the call of `<fn>`
with the argument words below (every amount is 1, so tokens really move) meets every hypothesis
of the success path theorem of `<fn>`; so there is a run from pc 0 that ends with no error and
with the stated output. No fact about keccak is used: a slot is the term `mapSlot ...`, whatever
its number is, and the proofs hold whether or not two of these slots are the same slot.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option maxRecDepth 4096

namespace BnbVerify.Sanity

open UsdtVerify
open TokenKit
open BnbVerify BnbVerify.Paths UsdtVerify.Gas

open EthLib.Base (Fork U256 Address)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork}

/-- The four bytes of the selector of `totalSupply()`. -/
def SEL_totalSupply : ByteArray := ⟨#[0x18, 0x16, 0x0d, 0xdd]⟩

theorem size_SEL_totalSupply : SEL_totalSupply.size = 4 := by decide

/-- The call `totalSupply()` from `caller` to `C`. -/
abbrev m_totalSupply (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C caller : Address) : Message fork :=
  sMsg b t C caller CODE SEL_totalSupply

/-- The success path `totalSupply_p1` is not empty: this call runs to the end with no error. -/
theorem totalSupply_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C caller : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_totalSupply b t C caller) 0 [] .empty gas (sState C []) ss evm ∧
      Ends fork evm s ∧ s.error = none ∧
      s.output = (wordBytes (storageAt (sState C []) (m_totalSupply b t C caller).currentTarget (3 : U256))) := by
  have hdata : (m_totalSupply b t C caller).data = SEL_totalSupply := rfl
  have hsz : (m_totalSupply b t C caller).data.size = 4 := size_SEL_totalSupply
  have hsl : selector (m_totalSupply b t C caller).data = selector SEL_totalSupply := rfl
  have hval : (m_totalSupply b t C caller).value = 0 := rfl
  have hspec := totalSupply_p1 (fork := fork) (message := (m_totalSupply b t C caller))
    (state := sState C []) (substate := ss)
    hfork
    (by rw [hsz]; decide)
    (by rw [hsz]; decide)
    (by rw [hsl]; decide)
    (by rw [hval]; decide)
    (Nat.le_refl _)
  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_totalSupply b t C caller) (sState C []) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, Or.inl ⟨reaches_toStep hr, hrun⟩, ?_, hH.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

