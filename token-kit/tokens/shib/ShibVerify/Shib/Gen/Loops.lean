theorem name_s191 (hfork : .berlin ≤ fork) {x0 : U256} {mem : ByteArray} {g : Nat} {S : State.TransactionState} {ss : Substate}
    {l s : Evm fork Nat}
    (h0 : At CODE message 191 [x0] mem g S ss l)
    (e0 : Ends fork l s) (hok : s.error = none) :
      (∃ (y0 y1 : U256) (mem' : ByteArray) (g' : Nat) (S' : State.TransactionState) (ss' : Substate)
        (l' : Evm fork Nat), At CODE message 203 [y0, y1] mem' g' S' ss' l' ∧
        Ends fork l' s ∧ g' < g ∧ Ro message.currentTarget S ss S' ss') ∨
      (∃ (y0 y1 : U256) (mem' : ByteArray) (g' : Nat) (S' : State.TransactionState) (ss' : Substate)
        (l' : Evm fork Nat), At CODE message 199 [y0, y1] mem' g' S' ss' l' ∧
        Ends fork l' s ∧ g' < g ∧ Ro message.currentTarget S ss S' ss') := by
  obtain ⟨g1, l1, h1, e1, hg1, hs1⟩ := Safe.stepE (pc' := 192) h0 e0 hok
    (fun G hG => Gas.jumpdestG (by code_fact) (by code_fact) hG) (by decide)
  obtain ⟨g2, l2, h2, e2, hg2, -⟩ := Safe.stepE (pc' := 193) h1 e1 hok
    (fun G hG => Gas.callvalueG (by code_fact) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  clear h1 e1
  obtain ⟨g3, l3, h3, e3, hg3, -⟩ := Safe.stepE (pc' := 194) h2 e2 hok
    (fun G hG => Gas.dupG 0 (by code_fact) (by code_fact) rfl hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  clear h2 e2
  obtain ⟨g4, l4, h4, e4, hg4, -⟩ := Safe.stepE (pc' := 195) h3 e3 hok
    (fun G hG => Gas.unaryG (byte := 0x15) (by code_fact) (by code_fact) (ofByte_of_decode rfl (Fork.frontier_le _)) instruction_iszero hG) (by decide)
  clear h3 e3
  obtain ⟨g5, l5, h5, e5, hg5, -⟩ := Safe.stepE (pc' := 198) h4 e4 hok
    (fun G hG => Gas.pushG (n := 2) (word := (203 : U256)) (by decide) (by code_fact) (by code_fact) (decode_push 2 (by decide)) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  clear h4 e4
  rcases Safe.jumpiE (pcT := 203) (pcF := 199) h5 e5 hok (by code_fact) (by code_fact)
      (by valid_dest) (by decide) (by decide) with
    ⟨g6, l6, h6, e6, hg6⟩ | ⟨g6, l6, h6, e6, hg6⟩
  · exact .inl ⟨_, _, _, _, _, _, _, h6, e6, by omega, by ro_reads⟩
  · exact .inr ⟨_, _, _, _, _, _, _, h6, e6, by omega, by ro_reads⟩

theorem name_s199 (hfork : .berlin ≤ fork) {x0 x1 : U256} {mem : ByteArray} {g : Nat} {S : State.TransactionState} {ss : Substate}
    {l s : Evm fork Nat}
    (h0 : At CODE message 199 [x0, x1] mem g S ss l)
    (e0 : Ends fork l s) (hok : s.error = none) :
      Ro message.currentTarget S ss s.state s.substate := by
  obtain ⟨g1, l1, h1, e1, hg1, -⟩ := Safe.stepE (pc' := 201) h0 e0 hok
    (fun G hG => Gas.pushG (n := 1) (word := (0 : U256)) (by decide) (by code_fact) (by code_fact) (decode_push 1 (by decide)) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  obtain ⟨g2, l2, h2, e2, hg2, -⟩ := Safe.stepE (pc' := 202) h1 e1 hok
    (fun G hG => Gas.dupG 0 (by code_fact) (by code_fact) rfl hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok)) (by decide)
  clear h1 e1
  obtain ⟨hst, hss⟩ := Safe.haltE h2 e2 hok (fun G hG => Gas.revertG (Nat.le_trans (by decide) hfork) (by code_fact) (by code_fact) hG)
  rw [hst, hss]
  ro_reads

