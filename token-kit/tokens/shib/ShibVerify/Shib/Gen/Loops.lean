  obtain ⟨g1, l1, h1, e1, -, -⟩ := Safe.stepE (pc' := 191) start hrun hok
    (fun G hG => enter hsize hsize' ⟨0, by decide⟩ (key := 0x06fdde03) (dest := 191)
      (N := 84) (by decide) (by decide) (by decide) hsel hG) rfl
  exact name_safe_191 hfork _ h1 e1 hok

