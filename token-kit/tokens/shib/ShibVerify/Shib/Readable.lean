/-- transfer(to, amount) from the caller `from`. Success needs: no value, 68 bytes of call data, a frame that may write, `from` and `to` not 0, `amount <= _balances[from]`, and (when `to` is not `from`) no overflow of `_balances[to]`. Then: returns 1; `_balances[from]` is the old word minus `amount` and `_balances[to]` the old word plus `amount` (when `to = from` the balance is unchanged); `_totalSupply` and every other slot keep their word; exactly one log, Transfer(from, to, amount). -/
theorem transfer_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xa9059cbb)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((message.value = 0) ∧
      (4 + 64 ≤ message.data.size) ∧
      (message.isStatic = false) ∧
      (hasAccount state message.currentTarget) ∧
      ((sender message) ≠ 0) ∧
      ((addrArg1 message) ≠ 0) ∧
      ((arg2 message).toNat ≤ (balance message state (sender message)).toNat) ∧
      ((addrArg1 message) ≠ (sender message) → (balance message state (addrArg1 message)).toNat + (arg2 message).toNat < 2 ^ 256)) ∧
    ((s.output = wordBytes 1) ∧
      ((addrArg1 message) ≠ (sender message) → (balance message s.state (sender message)).toNat = (balance message state (sender message)).toNat - (arg2 message).toNat ∧ (balance message s.state (addrArg1 message)).toNat = (balance message state (addrArg1 message)).toNat + (arg2 message).toNat) ∧
      ((addrArg1 message) = (sender message) → balance message s.state (sender message) = balance message state (sender message)) ∧
      (totalSupply message s.state = totalSupply message state) ∧
      (∀ k, k ≠ mapSlot (sender message) 0 → k ≠ mapSlot (addrArg1 message) 0 → storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs.push (log3 message.currentTarget TRANSFER (sender message) (addrArg1 message) (wordBytes (arg2 message))))) := by
  obtain ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstatic, hacc, hgas, hout, hg, hst, hsub⟩ :=
    ok_transfer hfork hsize' hsel start hrun hok
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, totalSupply, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2 hc3 hc4 hc5 hc6
  by_cases hd1 : (addrArg1 message) = (sender message)
  · simp only [balance, allowance, totalSupply, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL] at hd1
    try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2 hc3 hc4 hc5 hc6
    have v1 := Readable.value_of_cond hc1
    have z2 : 4 + 64 ≤ message.data.size := Readable.size_of_cond hsize hsize' hc2
    have n3 := Readable.ne_of_cond hc3
    have n4 := Readable.ne_of_cond hc4
    have l5 := Supply.le_of_cond_gt hc5
    have f5 := Supply.sub_fact hc5
    have b6 := Readable.add_bound hc6
    have f6 := Supply.add_fact hc6
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
    all_goals first
      | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
      | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close)
  · have hd1' : ¬((sender message) = (addrArg1 message)) := fun e => hd1 e.symm
    simp only [balance, allowance, totalSupply, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL] at hd1 hd1'
    try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, hd1, hd1', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2 hc3 hc4 hc5 hc6
    have v1 := Readable.value_of_cond hc1
    have z2 : 4 + 64 ≤ message.data.size := Readable.size_of_cond hsize hsize' hc2
    have n3 := Readable.ne_of_cond hc3
    have n4 := Readable.ne_of_cond hc4
    have l5 := Supply.le_of_cond_gt hc5
    have f5 := Supply.sub_fact hc5
    have b6 := Readable.add_bound hc6
    have f6 := Supply.add_fact hc6
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
    all_goals first
      | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, hd1, hd1', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
      | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_tot_bal hsep, slot_bal_tot hsep, slot_allow_bal hsep, slot_bal_allow hsep, slot_allow_tot hsep, slot_tot_allow hsep, hd1, hd1', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close)

/-- approve(spender, value) from the caller `owner`. Success needs: no value, 68 bytes of call data, a frame that may write, `owner` and `spender` not 0. Then: returns 1; `_allowances[owner][spender]` is `value`; `_totalSupply` and every other slot keep their word; exactly one log, Approval(owner, spender, value). -/
theorem approve_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x095ea7b3)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((message.value = 0) ∧
      (4 + 64 ≤ message.data.size) ∧
      (message.isStatic = false) ∧
      (hasAccount state message.currentTarget) ∧
      ((sender message) ≠ 0) ∧
