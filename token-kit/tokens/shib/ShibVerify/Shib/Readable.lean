/-- decimals(): no value; returns the low byte of slot 5; writes nothing and logs nothing. -/
theorem decimals_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
