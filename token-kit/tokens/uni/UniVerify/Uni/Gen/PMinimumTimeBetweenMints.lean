theorem ok_minimumTimeBetweenMints (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x5c11d62f)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        394 ≤ gas ∧
        s.output = (wordBytes (31536000 : U256)) ∧
        s.gas = gas - 394 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => minimumTimeBetweenMints_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := 394) (cost := 394) (fun g hg => minimumTimeBetweenMints_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

