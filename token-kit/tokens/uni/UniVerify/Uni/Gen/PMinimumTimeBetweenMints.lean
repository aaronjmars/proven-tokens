  step b283_0 hd6 (by simp) (by omega)
  have hd7 : (equal (1544672815 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b294_0 hd7 (by simp) (by omega)
