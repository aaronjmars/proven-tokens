theorem ok_mvSrc5_ends {a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 : U256} {mem : ByteArray} (hfork : .berlin ≤ fork)
    (hmem_size : mem.size = 800)
    (hmem_fp : loadWord (memoryReadBytes mem 64 32) 0 32 = (642 : U256))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 6946 [a0, a1, a2, (7703 : U256), a0, a2, a1, a3, (4379 : U256), a3, a4, a5, a6, a7, a8, a9, a10, a11, a1, (633 : U256), a12] mem gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    mvSrc5_ends fork message state substate gas s a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 :=
  ok_mvSrc5 hfork hmem_size hmem_fp start hrun hok

end UniVerify.Paths
