theorem size_SEL_totalSupply : SEL_totalSupply.size = 4 := by decide

/-- The call `totalSupply()` from `Witness.CALLER1` to `C`. -/
abbrev m_totalSupply (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C : Address) : Message fork :=
  sMsg b t C Witness.CALLER1 CODE SEL_totalSupply

set_option maxHeartbeats 1000000 in
/-- The success path `totalSupply_p1` is not empty: this call runs to the end with no error. -/
theorem totalSupply_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_totalSupply b t C) 0 [] .empty gas (sState C []) ss evm ∧
      (∀ {bound : Nat} (runChild : MessageRunner fork Nat bound),
        GasMeter.gasHeld evm.gas ≤ bound → EndsL runChild evm s) ∧ s.error = none ∧
      s.output = (wordBytes (storageAt (sState C []) (m_totalSupply b t C).currentTarget (0 : U256))) ∧
      s.state = (readSlot (sState C []) (m_totalSupply b t C).currentTarget (0 : U256)) := by
