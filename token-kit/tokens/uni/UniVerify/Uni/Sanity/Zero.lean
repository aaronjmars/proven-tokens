  have hsz : (m_totalSupply b t C).data.size = 4 := size_SEL_totalSupply
  have hsl : selector (m_totalSupply b t C).data = selector SEL_totalSupply := rfl
  have hval : (m_totalSupply b t C).value = 0 := rfl
  have hcw : (m_totalSupply b t C).caller.toU256 = Witness.CALLER1W := Witness.caller1_toU256
  have hct : (m_totalSupply b t C).currentTarget = C := rfl
  have hacc : hasAccount (sState C []) C := hasAccount_sState C _
  have hspec := totalSupply_p1 (fork := fork) (message := (m_totalSupply b t C))
