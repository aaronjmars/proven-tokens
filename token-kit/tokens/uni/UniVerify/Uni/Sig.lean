    (h2 : loadWord (memoryReadBytes M 770 32) 0 32 = sigR)
    (h3 : loadWord (memoryReadBytes M 802 32) 0 32 = sigS)
    (hdel : ∀ c, state.getCode (state.getAccount (toAddressMasked 1)).codeHash = .ok c →
