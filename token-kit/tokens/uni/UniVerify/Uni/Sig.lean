/-- Completeness for `delegateBySig`, under EthLib's real runner, from Paris and before
Glamsterdam.

A run of a fresh frame of `CODE` on a message with the selector of `delegateBySig` that ends
with no error: the message carries no value, its call data holds the six arguments,
`delegatee` is a clean address word and `v` is one byte, the gas covered the code before the
call and 3000 for ECRECOVER, and the run ended as `Paths.delegateBySigTail_ends` says
(generated, `Gen/PDelegateBySigTail.lean`) from the state with the reads of the call recorded:
the recovered word is not 0 as an address, `nonce` is `nonces[signatory]`, the time stamp is
not after `expiry`, the nonce is incremented, `delegates[signatory]` is written, the
DelegateChanged log, and then the moves of the votes (`Paths.mvSrc5_ends`).

The recovered word is `recoveredWord (sigInput digest v r s)`: `recoveredWord` is EthLib's
`Precompiles.Ecrecover.compute` read as a word, and nothing is assumed about it. -/
theorem ok_delegateBySig_real (hparis : .paris ≤ fork) (hglam : fork < .glamsterdam)
    (hsize' : message.data.size < 2 ^ 256) (hsel : selector message.data = 0xc3cda520)
    (hdel : ∀ c, state.getCode (state.getAccount (toAddressMasked 1)).codeHash = .ok c →
      .pectra ≤ fork → delegatedAddress c = none)
    {gas bound : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (within : GasMeter.gasHeld evm.gas ≤ bound)
    (hrun : Evm.runFrame (step fork) (step_decreases fork) bound (processRunner fork bound) evm
      within = .ok s)
    (hok : s.error = none) :
    (isZero message.value) ≠ 0 ∧
    (isZero (signedLessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (192 : U256))) ≠ 0 ∧
    (equal (loadWord message.data 4 32) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) ≠ 0 ∧
    (equal (loadWord message.data 100 32) (bitwiseAnd (255 : U256) (loadWord message.data 100 32))) ≠ 0 ∧
    3814 ≤ gas ∧
    3000 ≤ (sigCall fork (substate) ((gas - 3814))).subCall ∧
    Paths.delegateBySigTail_ends fork message
      ((state.recordAccountRead (toAddressMasked 1)).recordAccountRead message.currentTarget)
      { substate with accessedAddresses := (substate).accessedAddresses.insert (toAddressMasked 1) }
      ((gas - 3814) - 2 - ((sigCall fork (substate) ((gas - 3814))).cost + 0) +
        ((sigCall fork (substate) ((gas - 3814))).subCall - 3000))
      s (delegDigest message) (delegStruct message) (domainSepName message) (loadWord message.data 164 32) (loadWord message.data 132 32) (loadWord message.data 100 32) (loadWord message.data 68 32) (loadWord message.data 36 32) (loadWord message.data 4 32) (BitVec.ofNat 256 (selector message.data))
      (recoveredWord (sigInput (delegDigest message) (bitwiseAnd (255 : U256) (loadWord message.data 100 32)) (loadWord message.data 132 32) (loadWord message.data 164 32))) := by
  have hberlin : Fork.berlin ≤ fork := Nat.le_trans (by decide) hparis
  obtain ⟨hc1, hc2, hc3, hc4, hcg, z, hz, w, hzr⟩ :=
    Paths.ok_delegateBySig hberlin hsize' hsel start ⟨within, hrun⟩ hok
  obtain ⟨msz, m64, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, mout, m0, m1, m2, m3, -⟩ :=
    Paths.delegateBySig_p4_mem (message := message)
  have core := deleg_call hparis hglam msz m64 mout m0 m1 m2 m3 hdel hz w hzr hok
  exact ⟨hc1, hc2, hc3, hc4, hcg, core.1, core.2⟩

/-- Completeness for `permit`, under EthLib's real runner, from Paris and before Glamsterdam.

A run of a fresh frame of `CODE` on a message with the selector of `permit` that ends with no
error is one of two cases, by the amount (the largest word stands for the largest `uint96`;
another amount must be below `2^96`). In both: the message carries no value, its call data
holds the seven arguments, `owner` and `spender` are clean address words and `v` is one byte,
the frame may write, the contract has its account, the gas covered the code before the call
and 3000 for ECRECOVER, and the run ended as `Paths.permitMaxTail_ends` or
`Paths.permitTail_ends` says (generated) from the state `permitS1` (the nonce of the owner
already incremented) with the reads of the call recorded: the recovered word is not 0 as an
address and equals the owner, the time stamp is not after the deadline, the exact write of
the allowance, the Approval log and the exact gas.

The recovered word is `recoveredWord (sigInput digest v r s)`: nothing is assumed about it. -/
theorem ok_permit_real (hparis : .paris ≤ fork) (hglam : fork < .glamsterdam)
    (hsize' : message.data.size < 2 ^ 256) (hsel : selector message.data = 0xd505accf)
    (hdel : ∀ c, state.getCode (state.getAccount (toAddressMasked 1)).codeHash = .ok c →
      .pectra ≤ fork → delegatedAddress c = none)
    {gas bound : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (within : GasMeter.gasHeld evm.gas ≤ bound)
    (hrun : Evm.runFrame (step fork) (step_decreases fork) bound (processRunner fork bound) evm
      within = .ok s)
    (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
    (isZero (signedLessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (224 : U256))) ≠ 0 ∧
    (equal (loadWord message.data 4 32) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) ≠ 0 ∧
    (equal (loadWord message.data 36 32) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32))) ≠ 0 ∧
    (equal (loadWord message.data 132 32) (bitwiseAnd (255 : U256) (loadWord message.data 132 32))) ≠ 0 ∧
    (isZero (equal (loadWord message.data 68 32) (115792089237316195423570985008687907853269984665640564039457584007913129639935 : U256))) = 0 ∧
    message.isStatic = false ∧
    hasAccount state message.currentTarget ∧
    permitPreMax message state substate ≤ gas ∧
    3000 ≤ (sigCall fork ((permitSS1 message state substate)) ((gas - permitPreMax message state substate))).subCall ∧
    Paths.permitMaxTail_ends fork message
      (((permitS1 message state).recordAccountRead (toAddressMasked 1)).recordAccountRead message.currentTarget)
      { (permitSS1 message state substate) with accessedAddresses := ((permitSS1 message state substate)).accessedAddresses.insert (toAddressMasked 1) }
      ((gas - permitPreMax message state substate) - 2 - ((sigCall fork ((permitSS1 message state substate)) ((gas - permitPreMax message state substate))).cost + 0) +
        ((sigCall fork ((permitSS1 message state substate)) ((gas - permitPreMax message state substate))).subCall - 3000))
      s (permitDigestMax message state) (permitStructMax message state) (domainSepName message) (loadWord message.data 196 32) (loadWord message.data 164 32) (loadWord message.data 132 32) (loadWord message.data 100 32) (loadWord message.data 68 32) (loadWord message.data 36 32) (loadWord message.data 4 32) (BitVec.ofNat 256 (selector message.data))
      (recoveredWord (sigInput (permitDigestMax message state) (bitwiseAnd (255 : U256) (loadWord message.data 132 32)) (loadWord message.data 164 32) (loadWord message.data 196 32)))) ∨
    ((isZero message.value) ≠ 0 ∧
    (isZero (signedLessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (224 : U256))) ≠ 0 ∧
    (equal (loadWord message.data 4 32) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) ≠ 0 ∧
    (equal (loadWord message.data 36 32) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32))) ≠ 0 ∧
    (equal (loadWord message.data 132 32) (bitwiseAnd (255 : U256) (loadWord message.data 132 32))) ≠ 0 ∧
    (isZero (equal (loadWord message.data 68 32) (115792089237316195423570985008687907853269984665640564039457584007913129639935 : U256))) ≠ 0 ∧
    (lessThan (loadWord message.data 68 32) (79228162514264337593543950336 : U256)) ≠ 0 ∧
    message.isStatic = false ∧
    hasAccount state message.currentTarget ∧
    permitPre message state substate ≤ gas ∧
    3000 ≤ (sigCall fork ((permitSS1 message state substate)) ((gas - permitPre message state substate))).subCall ∧
    Paths.permitTail_ends fork message
      (((permitS1 message state).recordAccountRead (toAddressMasked 1)).recordAccountRead message.currentTarget)
      { (permitSS1 message state substate) with accessedAddresses := ((permitSS1 message state substate)).accessedAddresses.insert (toAddressMasked 1) }
      ((gas - permitPre message state substate) - 2 - ((sigCall fork ((permitSS1 message state substate)) ((gas - permitPre message state substate))).cost + 0) +
        ((sigCall fork ((permitSS1 message state substate)) ((gas - permitPre message state substate))).subCall - 3000))
      s (permitDigest message state) (permitStruct message state) (domainSepCopy message) (loadWord message.data 68 32) (loadWord message.data 196 32) (loadWord message.data 164 32) (loadWord message.data 132 32) (loadWord message.data 100 32) (loadWord message.data 68 32) (loadWord message.data 36 32) (loadWord message.data 4 32) (BitVec.ofNat 256 (selector message.data))
      (recoveredWord (sigInput (permitDigest message state) (bitwiseAnd (255 : U256) (loadWord message.data 132 32)) (loadWord message.data 164 32) (loadWord message.data 196 32)))) := by
  have hberlin : Fork.berlin ≤ fork := Nat.le_trans (by decide) hparis
  have hdel' : ∀ c, (permitS1 message state).getCode
      ((permitS1 message state).getAccount (toAddressMasked 1)).codeHash = .ok c →
      .pectra ≤ fork → delegatedAddress c = none := by
    intro c h
    rw [getCode_writeSlot, getAccount_writeSlot] at h
    exact hdel c h
  rcases Paths.ok_permit hberlin hsize' hsel start ⟨within, hrun⟩ hok with
    ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstat, hacc, hcg, z, hz, w, hzr⟩ |
    ⟨hc1, hc2, hc3, hc4, hc5, hc6, hc7, hstat, hacc, hcg, z, hz, w, hzr⟩
  · obtain ⟨msz, m64, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, mout, m0, m1, m2, m3, -⟩ :=
      Paths.permit_p6_mem (message := message) (state := state)
    have core := permit_callMax hparis hglam msz m64 mout m0 m1 m2 m3 hdel' hz w hzr hok
    exact Or.inl ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstat, hacc, hcg, core.1, core.2⟩
  · obtain ⟨msz, m64, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, mout, m0, m1, m2, m3, -⟩ :=
      Paths.permit_p9_mem (message := message) (state := state)
    have core := permit_call hparis hglam msz m64 mout m0 m1 m2 m3 hdel' hz w hzr hok
    exact Or.inr ⟨hc1, hc2, hc3, hc4, hc5, hc6, hc7, hstat, hacc, hcg, core.1, core.2⟩

