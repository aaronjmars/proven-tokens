import UniVerify.Uni.Gen
import UniVerify.Uni.Sep

/-!
# What the chained segments of UNI leave unchanged

Generated by `tokens/uni/scripts/gen_supply_keys.py` from the success paths of `scripts/gen_paths.py`; do
not edit. Lean checks every statement against `CODE`.

- `<seg>_frame`: if the run of the segment `<seg>` ends with no error (`<seg>_ends`, the
  conclusion of `ok_<seg>_ends`), then every storage word of the contract at a slot `k` that
  is not `CkSlot D k` is the same at the end as at the start of the segment, when the delegates
  whose checkpoints the segment writes are in the list `D` (hypotheses `hk<i>`).

No hypothesis on keccak is used: the statement is about the slots the segment writes.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace UniVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open UniVerify.Paths UniVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}
variable {D : List U256}

/-- A run of the segment `mvDst0` that ends with no error changes no storage word of the contract
but at the checkpoint slots of the delegates of `D`. -/
theorem mvDst0_frame {gas : Nat} {s : Evm fork Nat} {a0 a1 a2 a3 a4 a5 : U256} {mem : ByteArray}
    (h : mvDst0_ends fork message state substate gas s a0 a1 a2 a3 a4 a5 mem)
    (hk1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a1 ∈ D)
    (k : U256) (hk : ¬ CkSlot D k) :
    storageAt s.state message.currentTarget k = storageAt state message.currentTarget k := by
  unfold mvDst0_ends at h
  rcases h with
    ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hc3, hc4, hc5, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hc3, hc4, hc5, hc6, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hc3, hc4, hc5, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hgas, hout, hg, hst, hsub⟩
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hc5 hc6 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hc5 hc6 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hc5 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hc5 hc6 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hc5 hc6 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hc5 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]

