theorem delta_step (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel5 : selector message.data ≠ 0xc3cda520)
    (hsel6 : selector message.data ≠ 0xd505accf)
    (hsep : Sep (callKeys message) (ckKeys message state))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Dsum message.currentTarget s.state = Dsum message.currentTarget state := by
  obtain ⟨_, _, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0xdd62ed3e := hi
    exact delta_allowance hfork hsize' h hsep start hrun hok
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0xe7a324dc := hi
    exact delta_delegationTypehash hfork hsize' h hsep start hrun hok
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0xf1127ed8 := hi
    exact delta_checkpoints hfork hsize' h hsep start hrun hok
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0xfca3b5aa := hi
    exact delta_setMinter hfork hsize' h hsep start hrun hok
  | ⟨4, _⟩, hi =>
    have h : selector message.data = 0xb4b5ea57 := hi
    exact delta_getCurrentVotes hfork hsize' h hsep start hrun hok
  | ⟨5, _⟩, hi =>
    have h : selector message.data = 0xc3cda520 := hi
    exact absurd h hsel5
  | ⟨6, _⟩, hi =>
    have h : selector message.data = 0xd505accf := hi
    exact absurd h hsel6
  | ⟨7, _⟩, hi =>
    have h : selector message.data = 0x782d6fe1 := hi
    exact delta_getPriorVotes hfork hsize' h start hrun hok
  | ⟨8, _⟩, hi =>
    have h : selector message.data = 0x7ecebe00 := hi
    exact delta_nonces hfork hsize' h hsep start hrun hok
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0x95d89b41 := hi
    exact delta_symbol hfork hsize' h start hrun hok
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    exact delta_transfer hfork hsize' h hsep start hrun hok
  | ⟨11, _⟩, hi =>
    have h : selector message.data = 0x6fcfff45 := hi
    exact delta_numCheckpoints hfork hsize' h hsep start hrun hok
  | ⟨12, _⟩, hi =>
    have h : selector message.data = 0x70a08231 := hi
    exact delta_balanceOf hfork hsize' h hsep start hrun hok
  | ⟨13, _⟩, hi =>
    have h : selector message.data = 0x76c71ca1 := hi
    exact delta_mintCap hfork hsize' h hsep start hrun hok
  | ⟨14, _⟩, hi =>
    have h : selector message.data = 0x40c10f19 := hi
    exact delta_mint hfork hsize' h hsep start hrun hok
  | ⟨15, _⟩, hi =>
    have h : selector message.data = 0x587cde1e := hi
    exact delta_delegates hfork hsize' h hsep start hrun hok
  | ⟨16, _⟩, hi =>
    have h : selector message.data = 0x5c11d62f := hi
    exact delta_minimumTimeBetweenMints hfork hsize' h hsep start hrun hok
  | ⟨17, _⟩, hi =>
    have h : selector message.data = 0x5c19a95c := hi
    exact delta_delegate hfork hsize' h hsep start hrun hok
  | ⟨18, _⟩, hi =>
    have h : selector message.data = 0x30adf81f := hi
    exact delta_permitTypehash hfork hsize' h hsep start hrun hok
  | ⟨19, _⟩, hi =>
    have h : selector message.data = 0x30b36cef := hi
    exact delta_mintingAllowedAfter hfork hsize' h hsep start hrun hok
  | ⟨20, _⟩, hi =>
    have h : selector message.data = 0x313ce567 := hi
    exact delta_decimals hfork hsize' h hsep start hrun hok
  | ⟨21, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    exact delta_totalSupply hfork hsize' h hsep start hrun hok
  | ⟨22, _⟩, hi =>
    have h : selector message.data = 0x20606b70 := hi
    exact delta_domainTypehash hfork hsize' h hsep start hrun hok
  | ⟨23, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    exact delta_transferFrom hfork hsize' h hsep start hrun hok
  | ⟨24, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    exact delta_name hfork hsize' h start hrun hok
  | ⟨25, _⟩, hi =>
    have h : selector message.data = 0x07546172 := hi
    exact delta_minter hfork hsize' h hsep start hrun hok
  | ⟨26, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    exact delta_approve hfork hsize' h hsep start hrun hok
  | ⟨n + 27, hn⟩, _ => exact absurd hn (by omega)

