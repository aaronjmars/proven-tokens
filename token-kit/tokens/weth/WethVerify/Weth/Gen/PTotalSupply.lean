theorem totalSupply_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 153 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 153) state substate) := by
  step enter hsize hsize' ⟨2, by decide⟩ (key := 0x18160ddd) (dest := 417) (N := 128) (by decide) (by decide) (by decide) hsel (by omega)
  step b417_0 hc1 (by simp) (by omega)
  exact haltGas (b424_0 hfork (by simp) (by omega)) (by omega)

theorem totalSupply_p1
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : 166 ≤ gas) :
    Gas.HoareG fork (At CODE message 0 [] .empty gas state substate)
      (At CODE message 1648 [(0 : U256), (436 : U256), (BitVec.ofNat 256 (selector message.data))] (memW [(0 : U256), (0 : U256), (96 : U256)]) (gas - 166) state substate) := by
  step enter hsize hsize' ⟨2, by decide⟩ (key := 0x18160ddd) (dest := 417) (N := 128) (by decide) (by decide) (by decide) hsel (by omega)
  step b417_1 hc1 (by simp) (by omega)
  step b428_0 (by simp) (by omega)
  step b1645_0 (by simp) (by omega)
  exact restate rfl rfl rfl (by omega) rfl rfl

theorem ok_totalSupply (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    {gas bound : Nat} {runChild : MessageRunner fork Nat bound} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (within : GasMeter.gasHeld evm.gas ≤ bound)
    (hrun : Evm.runFrame (step fork) (step_decreases fork) bound runChild evm within = .ok s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        166 ≤ gas ∧
        ∃ (z : Evm fork Nat) (w : GasMeter.gasHeld z.gas ≤ bound),
          At CODE message 1648 [(0 : U256), (436 : U256), (BitVec.ofNat 256 (selector message.data))] (memW [(0 : U256), (0 : U256), (96 : U256)]) (gas - 166) state substate z ∧
          Evm.runFrame (step fork) (step_decreases fork) bound runChild z w = .ok s) := by
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 153) (fun g hg => totalSupply_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start (Ends.run hrun) hok).elim
  ·
    obtain ⟨hcg, z, w, hz, hzr⟩ := ok_split (B := 166) (c := 166) (by omega) (fun g hg => totalSupply_p1 hfork hsize hsize' hsel hc1 (by omega)) start within hrun hok
    exact ⟨hc1, hcg, z, w, hz, hzr⟩

