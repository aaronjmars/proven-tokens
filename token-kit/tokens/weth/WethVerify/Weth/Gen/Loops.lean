/-- A run of `CODE` from pc 0 with the selector of `name()` that ends with no error
only reads: every storage word is as before and no log is added. -/
theorem ro_name (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    {state : State.TransactionState} {substate : Substate}
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    Ro message.currentTarget state substate s.state s.substate := by
  obtain ⟨g1, l1, h1, e1, -, -⟩ := Safe.stepE (pc' := 185) start hrun hok
    (fun G hG => enter hsize hsize' ⟨0, by decide⟩ (key := 0x06fdde03) (dest := 185)
      (N := 84) (by decide) (by decide) (by decide) hsel hG) rfl
  exact name_safe_185 hfork _ h1 e1 hok

