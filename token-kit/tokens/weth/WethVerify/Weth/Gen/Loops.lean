/-- A run of `CODE` from pc 0 with the selector of `symbol()` that ends with no error
only reads: every storage word is as before and no log is added. -/
theorem ro_symbol (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    {state : State.TransactionState} {substate : Substate}
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    Ro message.currentTarget state substate s.state s.substate := by
  obtain ⟨g1, l1, h1, e1, -, -⟩ := Safe.stepE (pc' := 738) start hrun hok
    (fun G hG => enter hsize hsize' ⟨7, by decide⟩ (key := 0x95d89b41) (dest := 738)
      (N := 238) (by decide) (by decide) (by decide) hsel hG) rfl
  exact symbol_safe_738 hfork _ h1 e1 hok

