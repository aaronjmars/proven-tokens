variable {fork : Fork}

/-- The four bytes of the selector of `balanceOf(address)`. -/
def SEL_balanceOf : ByteArray := ⟨#[0x70, 0xa0, 0x82, 0x31]⟩

theorem size_SEL_balanceOf : SEL_balanceOf.size = 4 := by decide

/-- The call `balanceOf(1)` from `caller` to `C`. -/
abbrev m_balanceOf (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C caller : Address) : Message fork :=
  sMsg b t C caller CODE (data1 SEL_balanceOf 1)

/-- The success path `balanceOf_p1` is not empty: this call runs to the end with no error. -/
theorem balanceOf_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C caller : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_balanceOf b t C caller) 0 [] .empty gas (sState C []) ss evm ∧
      Ends fork evm s ∧ s.error = none ∧
      s.output = (wordBytes (storageAt (sState C []) (m_balanceOf b t C caller).currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord (m_balanceOf b t C caller).data 4 32)) (3 : U256)))) := by
  have hdata : (m_balanceOf b t C caller).data = data1 SEL_balanceOf 1 := rfl
  have hsz : (m_balanceOf b t C caller).data.size = 36 := by
    rw [hdata]; exact size_data1 size_SEL_balanceOf _
  have hsl : selector (m_balanceOf b t C caller).data = selector SEL_balanceOf := by
    rw [hdata]; exact selector_data1 size_SEL_balanceOf _
  have hA1 : loadWord (m_balanceOf b t C caller).data 4 32 = 1 := by
    rw [hdata]; exact Witness.arg1_data1 size_SEL_balanceOf _
  have hval : (m_balanceOf b t C caller).value = 0 := rfl
  have hspec := balanceOf_p1 (fork := fork) (message := (m_balanceOf b t C caller))
    (state := sState C []) (substate := ss)
    hfork
    (by rw [hsz]; decide)
    (by rw [hsz]; decide)
    (by rw [hsl]; decide)
    (by rw [hval]; decide)
    (Nat.le_refl _)
  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_balanceOf b t C caller) (sState C []) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, Or.inl ⟨reaches_toStep hr, hrun⟩, ?_, hH.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

