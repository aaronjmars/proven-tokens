import WethVerify.Weth.Gen
import WethVerify.Weth.Gen.Loops
import WethVerify.Weth.Sep

/-!
# Each call that the generator followed to its end keeps WETH9 solvent

Generated by `scripts/gen_solvent.py` from the success paths of `scripts/gen_paths.py`; do not
edit. Lean checks every statement against `CODE`.

`solvent_<fn>`: a run of `CODE` from pc 0 into `<fn>` that ends with no error, from a state where
the sum of all balances plus the value of the message is at most the ether of the contract
(`Backed message.value`: the message layer has already credited the value), ends in a state where
the sum of all balances is at most the ether of the contract (`Solvent`).

`Sep (callKeys message)` is the hypothesis on keccak of WethVerify/Weth/Sep.lean; it is assumed,
not proved.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace WethVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open WethVerify.Paths WethVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}

/-- A successful call of `balanceOf` keeps the contract solvent. -/
theorem solvent_balanceOf (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x70a08231)
    (hsep : Sep (callKeys message))
    (hinv : Backed message.value message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    Solvent message.currentTarget s.state := by
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by
    simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by
    simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by
    simp [callKeys]
  have hall := ok_balanceOf hfork hsize hsize' hsel start hrun hok
  clear start hrun hok
  obtain ⟨hc1, hgas, hout, hg, hst, hsub⟩ := hall
  rw [hst]
  clear hst hgas hout hg hsub
  try simp only [mask_idem, storageAt_readSlot] at *
  unfold Solvent Backed Supply.Solvent Supply.Backed etherOf at *
  simp (disch := supply_side) only
    [Supply.sumBal_read, sum_bal hsep, sum_allow hsep, read_bal_allow hsep,
      storageAt_readSlot,
      getAccount_writeSlot, getAccount_readSlot, Supply.add_toNat]
  omega

