/-- deposit() credits the value of the message to the caller `dst`, with any value and any call data it accepts. Success needs a frame that may write. Then: returns nothing; `balanceOf[dst]` is the old word plus the value modulo 2^256 (the bytecode does not check the addition); every other slot keeps its word; exactly one log, Deposit(dst, value). -/
theorem deposit_readable (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xd0e30db0)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((message.isStatic = false) ∧
      (hasAccount state message.currentTarget)) ∧
    ((s.output = ByteArray.empty) ∧
      ((balance message s.state (sender message)).toNat = ((balance message state (sender message)).toNat + message.value.toNat) % 2 ^ 256) ∧
      (∀ k, k ≠ mapSlot (sender message) 3 → storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs.push (Readable.log2 message.currentTarget DEPOSIT (sender message) (wordBytes message.value)))) := by
  obtain ⟨hstatic, hacc, hgas, hout, hg, hst, hsub⟩ :=
    ok_deposit hfork hsize hsize' hsel start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, DEPOSIT, WITHDRAWAL]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close)

/-- approve(guy, wad) from the caller `src`. Success needs: no value, a frame that may write. Then: returns 1; `allowance[src][guy]` is `wad`; every other slot keeps its word; exactly one log, Approval(src, guy, wad). -/
theorem approve_readable (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x095ea7b3)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((message.value = 0) ∧
      (message.isStatic = false) ∧
      (hasAccount state message.currentTarget)) ∧
    ((s.output = wordBytes 1) ∧
      (allowance message s.state (sender message) (addrArg1 message) = (arg2 message)) ∧
      (∀ k, k ≠ mapSlot (addrArg1 message) (mapSlot (sender message) 4) → storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs.push (log3 message.currentTarget APPROVAL (sender message) (addrArg1 message) (wordBytes (arg2 message))))) := by
  obtain ⟨hc1, hstatic, hacc, hgas, hout, hg, hst, hsub⟩ :=
    ok_approve hfork hsize hsize' hsel start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, DEPOSIT, WITHDRAWAL]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1
  have v1 := Readable.value_of_cond hc1
  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close)

/-- transfer(dst, wad) from the caller `src`. Success needs: no value, a frame that may write, `wad <= balanceOf[src]`. Then: returns 1; `balanceOf[src]` is the old word minus `wad` and `balanceOf[dst]` the old word plus `wad` modulo 2^256 (the bytecode does not check the addition; when `dst = src` the balance is unchanged); every other slot keeps its word; exactly one log, Transfer(src, dst, wad). -/
theorem transfer_readable (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xa9059cbb)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((message.value = 0) ∧
      (message.isStatic = false) ∧
      (hasAccount state message.currentTarget) ∧
      ((arg2 message).toNat ≤ (balance message state (sender message)).toNat)) ∧
    ((s.output = wordBytes 1) ∧
      ((addrArg1 message) ≠ (sender message) → (balance message s.state (sender message)).toNat = (balance message state (sender message)).toNat - (arg2 message).toNat ∧ (balance message s.state (addrArg1 message)).toNat = ((balance message state (addrArg1 message)).toNat + (arg2 message).toNat) % 2 ^ 256) ∧
      ((addrArg1 message) = (sender message) → (balance message s.state (sender message)).toNat = (balance message state (sender message)).toNat) ∧
      (∀ k, k ≠ mapSlot (sender message) 3 → k ≠ mapSlot (addrArg1 message) 3 → storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs.push (log3 message.currentTarget TRANSFER (sender message) (addrArg1 message) (wordBytes (arg2 message))))) := by
  obtain ⟨hc1, hc2, hstatic, hacc, hgas, hout, hg, hst, hsub⟩ :=
    ok_transfer hfork hsize hsize' hsel start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, DEPOSIT, WITHDRAWAL]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2
  by_cases hd1 : (addrArg1 message) = (sender message)
  · simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, DEPOSIT, WITHDRAWAL] at hd1
    try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, hd1, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2
    have v1 := Readable.value_of_cond hc1
    have l2 := Supply.le_of_cond_lt hc2
    have f2 := Supply.sub_fact_lt hc2
    refine ⟨⟨?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_⟩
