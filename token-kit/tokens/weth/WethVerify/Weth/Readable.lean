/-- The fallback, for call data shorter than 4 bytes, credits the value of the message to the caller `dst`, with any value and any call data it accepts. Success needs a frame that may write. Then: returns nothing; `balanceOf[dst]` is the old word plus the value modulo 2^256 (the bytecode does not check the addition); every other slot keeps its word; exactly one log, Deposit(dst, value). -/
theorem fallbackShort_readable (hfork : .berlin ≤ fork)
    (hsize : message.data.size < 4)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((message.isStatic = false) ∧
      (hasAccount state message.currentTarget)) ∧
    ((s.output = ByteArray.empty) ∧
      ((balance message s.state (sender message)).toNat = ((balance message state (sender message)).toNat + message.value.toNat) % 2 ^ 256) ∧
      (∀ k, k ≠ mapSlot (sender message) 3 → storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs.push (Readable.log2 message.currentTarget DEPOSIT (sender message) (wordBytes message.value)))) := by
  obtain ⟨hstatic, hacc, hgas, hout, hg, hst, hsub⟩ :=
    ok_fallbackShort hfork hsize start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, sender, addrArg1, addrArg2, arg1, arg2, arg3, TRANSFER, APPROVAL, DEPOSIT, WITHDRAWAL]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, slot_bal_bal hsep, slot_allow_bal hsep, slot_bal_allow hsep, Readable.logs_logSub2, Readable.log2, Supply.add_toNat, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close)

