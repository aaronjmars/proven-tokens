import OndoVerify.Ondo.Gen
import TokenKit.Evm.Precompile
import TokenKit.Evm.Call

/-!
# `delegateBySig` under EthLib's real runner

Generated by tokens/ondo/scripts/gen_sig.py from work/paths.json.

`delegateBySig(delegatee, nonce, expiry, v, r, s)` (selector `0xc3cda520`) builds an EIP-712
digest in memory and calls the precompile at address 1 (ECRECOVER) with STATICCALL. The
generated paths stop at the frame before `GAS STATICCALL` (pc 5175, `Paths.ok_delegateBySig`)
and start again after it (`Paths.ok_delegateBySigTail_ends`). This file joins them across the
call, for `processRunner`, with no assumption on what the precompile returns: the output is
EthLib's own `Precompiles.Ecrecover.compute` (through `TokenKit.recoveredWord`).

- `sigInput`: the 128 bytes given to ECRECOVER (digest, `v`, `r`, `s`).
- `domainSepName`: the domain separator as the code builds it (keccak of the domain type hash,
  the hash of the name, the chain id and the address of the contract).
- `delegStruct`, `delegDigest`: the struct hash and the digest, as the code builds them (keccak
  of memory bytes: they are not reduced to the Solidity encoding).
- `deleg_call`: across the call, for a memory that holds the four input words.
- `ok_delegateBySig_real`: completeness under the real runner.

Scope: from Paris and before Glamsterdam (EthLib's rules of STATICCALL). `hdel`: the account
at address 1 holds no EIP-7702 delegation code (a fact of the state, true on chain).

A fact about the real contract that these statements show: `delegateBySig` reads
`nonces[signatory]` after the call, for the recovered address.
-/

set_option maxRecDepth 4096

namespace OndoVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open OndoVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256 Address toAddressMasked)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

/-- The 128 bytes given to ECRECOVER: the digest, `v`, `r` and `s`. -/
def sigInput (digest v r s : U256) : ByteArray :=
  wordBytes digest ++ wordBytes v ++ wordBytes r ++ wordBytes s

/-- The gas of the call of ECRECOVER from a frame with `gas` at GAS, and what the caller pays:
EthLib's `messageCallGas` for the gas that GAS pushed, no memory growth, and the access of
address 1. -/
abbrev sigCall (fork : Fork) (substate : Substate) (gas : Nat) :=
  messageCallGas fork 0 (BitVec.ofNat 256 (gas - 2)).toNat (gas - 2) 0
    (callBaseCost fork (decide (toAddressMasked 1 ∉ substate.accessedAddresses)) +
      routeCost fork (substate.accessedAddresses.insert (toAddressMasked 1)) none)

variable {fork : Fork} {message : Message fork} {state : State.TransactionState}
  {substate : Substate}

/-- The domain separator as `delegateBySig` builds it. -/
def domainSepName (m : Message fork) : U256 :=
  (keccak (memW [(63630494520926674092677056046569304749177344945028501797992170511073678501990 : U256), (11728014798259287791660541725762641888834453204448758778175956289505542894862 : U256), (BitVec.ofNat 256 m.blockEnv.chainId.toNat), m.currentTarget.toU256]))

/-- The struct hash of a `delegateBySig` message. -/
def delegStruct (m : Message fork) : U256 :=
  (keccak (memW [(103359069561928152843793640083012950350530901667116492021891118459870908603103 : U256), (bitwiseAnd (loadWord m.data 4 32) (1461501637330902918203684832716283019655932542975 : U256)), (loadWord m.data 36 32), (loadWord m.data 68 32)]))

/-- The digest of a `delegateBySig` message. -/
def delegDigest (m : Message fork) : U256 :=
  keccak (topBytes 2 (11309588061646438093662687302255421419811724423900836950936401294474059186176 : U256) (memW [domainSepName m, delegStruct m]))

/-- From Paris and before Glamsterdam, under the real runner: a run from the frame of `delegateBySig` before `GAS STATICCALL` (pc 5175) that ends with no error. The call of ECRECOVER got at least 3000 gas, and the run ended as `Paths.delegateBySigTail_ends` says from the frame after the call, with the recovered word `recoveredWord (sigInput digest v r s)`. -/
theorem deleg_call (hparis : .paris ≤ fork) (hglam : fork < .glamsterdam)
    {dg sh ds sigS sigR sigV expiry nonce delegatee sel v : U256} {M : ByteArray} {gas : Nat}
    (hsz : M.size = 800) (hfp : loadWord (memoryReadBytes M 64 32) 0 32 = (642 : U256))
    (hout : loadWord (memoryReadBytes M 610 32) 0 32 = (0 : U256))
    (h0 : loadWord (memoryReadBytes M 642 32) 0 32 = dg)
    (h1 : loadWord (memoryReadBytes M 674 32) 0 32 = v)
    (h2 : loadWord (memoryReadBytes M 706 32) 0 32 = sigR)
    (h3 : loadWord (memoryReadBytes M 738 32) 0 32 = sigS)
    (hdel : ∀ c, state.getCode (state.getAccount (toAddressMasked 1)).codeHash = .ok c →
      .pectra ≤ fork → delegatedAddress c = none)
    {bound : Nat} {z s : Evm fork Nat}
    (start : At CODE message 5175 [(1 : U256), (642 : U256), (128 : U256), (610 : U256), (32 : U256), (770 : U256), (1 : U256), (0 : U256), dg, sh, ds, sigS, sigR, sigV, expiry, nonce, delegatee, (670 : U256), sel]
      M gas state substate z)
    (within : GasMeter.gasHeld z.gas ≤ bound)
    (hrun : Evm.runFrame (step fork) (step_decreases fork) bound (processRunner fork bound) z
      within = .ok s)
    (hok : s.error = none) :
    3000 ≤ (sigCall fork substate gas).subCall ∧
    Paths.delegateBySigTail_ends fork message
      ((state.recordAccountRead (toAddressMasked 1)).recordAccountRead message.currentTarget)
      { substate with accessedAddresses := (substate).accessedAddresses.insert (toAddressMasked 1) }
      (gas - 2 - ((sigCall fork (substate) (gas)).cost + 0) +
        ((sigCall fork (substate) (gas)).subCall - 3000))
      s dg sh ds sigS sigR sigV expiry nonce delegatee sel (recoveredWord (sigInput dg v sigR sigS)) := by
  have hberlin : Fork.berlin ≤ fork := Nat.le_trans (by decide) hparis
  have tin : (642 : U256).toNat = 642 := by decide
  have t128 : (128 : U256).toNat = 128 := by decide
  have tout : (610 : U256).toNat = 610 := by decide
  have t32 : (32 : U256).toNat = 32 := by decide
  have hE : extendMemory M.size [((642 : U256), (128 : U256)), ((610 : U256), (32 : U256))] =
      ⟨0, 0⟩ := extendMemory_two (by rw [hsz]; decide) (by rw [hsz]; decide)
  obtain ⟨hg, after, hat, w, hr⟩ := ecrecover_call_ok hparis hglam (q := 5177) rfl
    (by code_fact) (by code_fact) (by code_fact) (by code_fact) (by code_fact)
    (by code_fact) (by code_fact) (by code_fact) (by code_fact)
    (by code_fact) (by code_fact) (by code_fact) (by code_fact)
    (by code_fact) (by code_fact) (by code_fact) (by code_fact)
    (by simp [STACK_LIMIT]) hdel start within hrun hok
  rw [hE] at hg hat
  simp only [memoryExtend_zero, tin, t128, tout, t32] at hat
  have hdata : memoryReadBytes M 642 128 = sigInput dg v sigR sigS :=
    read4_raw h0 h1 h2 h3 hsz (by decide)
  rw [hdata] at hat
  have hfit : 610 + 32 ≤ M.size := by rw [hsz]; decide
  refine ⟨hg, ?_⟩
  exact Paths.ok_delegateBySigTail_ends hberlin
    ((size_ecrecover_write _ hfit).trans hsz)
    ((congrArg (loadWord · 0 32) (read_ecrecover_other _ hfit (.inl (by decide)))).trans hfp)
    (load_ecrecover _ hfit hout) hat ⟨w, hr⟩ hok


/-- Completeness for `delegateBySig`, under EthLib's real runner, from Paris and before
Glamsterdam.

A run of a fresh frame of `CODE` on a message with the selector of `delegateBySig` that ends
with no error: the message carries no value, its call data holds the six arguments,
`delegatee` is a clean address word and `v` is one byte, the gas covered the code before the
call and 3000 for ECRECOVER, and the run ended as `Paths.delegateBySigTail_ends` says
(generated, `Gen/PDelegateBySigTail.lean`) from the state with the reads of the call recorded:
the recovered word is not 0 as an address, `nonce` is `nonces[signatory]`, the time stamp is
not after `expiry`, the nonce is incremented, `delegates[signatory]` is written, the
DelegateChanged log, and then the moves of the votes (a `Paths.mvSrc<n>_ends`).

The recovered word is `recoveredWord (sigInput digest v r s)`: `recoveredWord` is EthLib's
`Precompiles.Ecrecover.compute` read as a word, and nothing is assumed about it. -/
theorem ok_delegateBySig_real (hparis : .paris ≤ fork) (hglam : fork < .glamsterdam)
    (hsize' : message.data.size < 2 ^ 256) (hsel : selector message.data = 0xc3cda520)
    (hdel : ∀ c, state.getCode (state.getAccount (toAddressMasked 1)).codeHash = .ok c →
      .pectra ≤ fork → delegatedAddress c = none)
    {gas bound : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (within : GasMeter.gasHeld evm.gas ≤ bound)
    (hrun : Evm.runFrame (step fork) (step_decreases fork) bound (processRunner fork bound) evm
      within = .ok s)
    (hok : s.error = none) :
    (isZero message.value) ≠ 0 ∧
    (isZero (signedLessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (192 : U256))) ≠ 0 ∧
    (equal (loadWord message.data 4 32) (bitwiseAnd (loadWord message.data 4 32) (1461501637330902918203684832716283019655932542975 : U256))) ≠ 0 ∧
    (equal (loadWord message.data 100 32) (bitwiseAnd (loadWord message.data 100 32) (255 : U256))) ≠ 0 ∧
    1382 ≤ gas ∧
    3000 ≤ (sigCall fork (substate) ((gas - 1382))).subCall ∧
    Paths.delegateBySigTail_ends fork message
      ((state.recordAccountRead (toAddressMasked 1)).recordAccountRead message.currentTarget)
      { substate with accessedAddresses := (substate).accessedAddresses.insert (toAddressMasked 1) }
      ((gas - 1382) - 2 - ((sigCall fork (substate) ((gas - 1382))).cost + 0) +
        ((sigCall fork (substate) ((gas - 1382))).subCall - 3000))
      s (delegDigest message) (delegStruct message) (domainSepName message) (loadWord message.data 164 32) (loadWord message.data 132 32) (loadWord message.data 100 32) (loadWord message.data 68 32) (loadWord message.data 36 32) (loadWord message.data 4 32) (BitVec.ofNat 256 (selector message.data))
      (recoveredWord (sigInput (delegDigest message) (bitwiseAnd (loadWord message.data 100 32) (255 : U256)) (loadWord message.data 132 32) (loadWord message.data 164 32))) := by
  have hberlin : Fork.berlin ≤ fork := Nat.le_trans (by decide) hparis
  obtain ⟨hc1, hc2, hc3, hc4, hcg, z, hz, w, hzr⟩ :=
    Paths.ok_delegateBySig hberlin hsize' hsel start ⟨within, hrun⟩ hok
  obtain ⟨msz, m64, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, mout, m0, m1, m2, m3, -⟩ :=
    Paths.delegateBySig_p4_mem (message := message)
  have core := deleg_call hparis hglam msz m64 mout m0 m1 m2 m3 hdel hz w hzr hok
  exact ⟨hc1, hc2, hc3, hc4, hcg, core.1, core.2⟩

end OndoVerify
