import OndoVerify.Ondo.Gen
import OndoVerify.Ondo.Sep
import OndoVerify.Ondo.Arith

/-!
# What the chained segments of ONDO leave unchanged

Generated by `scripts/gen_supply_chain.py` from the success paths of `scripts/gen_paths.py`; do
not edit. Lean checks every statement against `CODE`.

- `<seg>_frame`: if the run of the segment `<seg>` ends with no error (`<seg>_ends`, the
  conclusion of `ok_<seg>_ends`), then every storage word of the contract at a slot `k` that
  is not `CkSlot k` is the same at the end as at the start of the segment.

No hypothesis on keccak is used: the statement is about the slots the segment writes.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace OndoVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open OndoVerify.Paths OndoVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}

variable {A D : List U256} {R : U256}

/-- A run of the segment `wck47` that ends with no error changes no storage word of the contract
but at the checkpoint slots of the delegates of `D`. -/
theorem wck47_frame {gas : Nat} {s : Evm fork Nat} {a0 a1 a2 a3 a4 a5 a6 a7 : U256} {mem : ByteArray}
    (h : wck47_ends fork message state substate gas s a0 a1 a2 a3 a4 a5 a6 a7 mem)
    (hk2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a2 ∈ D)
    (k : U256) (hk : ¬ CkSlot D k) :
    storageAt s.state message.currentTarget k = storageAt state message.currentTarget k := by
  unfold wck47_ends at h
  rcases h with
    ⟨hc1, hc2, hc3, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hc3, hc4, hstat, hacc, hgas, hout, hg, hst, hsub⟩ |
    ⟨hc1, hc2, hstat, hacc, hgas, hout, hg, hst, hsub⟩
  · rw [hst]
    clear hc1 hc2 hc3 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hc3 hc4 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]
  · rw [hst]
    clear hc1 hc2 hgas hout hg hst hsub
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, storageAt_readSlot, st_ck hk, st_num hk]

