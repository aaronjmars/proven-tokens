    (h : core1_ends fork message state substate gas s a0 a1 a2 a3 mem)
    (hb1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a1 ∈ A)
    (hb2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a2 ∈ A)
    (hd1 : delegOf message.currentTarget state (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a1) ∈ D)
    (hd2 : delegOf message.currentTarget state (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a2) ∈ D)
