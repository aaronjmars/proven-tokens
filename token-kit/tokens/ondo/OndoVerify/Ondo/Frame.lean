/-- A run of the segment `core0` that ends with no error keeps the sum of the balances minus
the total supply, when its address words are in `A` and their delegates at the start of the
segment are in `D`. `hsep` is the hypothesis on keccak (not proved). -/
theorem core0_delta (hsep : Sep A D R) {gas : Nat} {s : Evm fork Nat} {a0 a1 a2 a3 : U256} {mem : ByteArray}
    (h : core0_ends fork message state substate gas s a0 a1 a2 a3 mem)
    (hb1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a1 ∈ A)
    (hb2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a2 ∈ A)
    (hd1 : delegOf message.currentTarget state (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a1) ∈ D)
    (hd2 : delegOf message.currentTarget state (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) a2) ∈ D)
    :
    Dsum message.currentTarget s.state = Dsum message.currentTarget state := by
  unfold core0_ends at h
  unfold delegOf at hd1 hd2
  rcases h with
    ⟨hc1, hc2, hstat, hacc, hgas, hch⟩
  · rw [Dsum_frame hsep (mvSrc2_frame hch (by key_mem_sep hsep) (by key_mem_sep hsep))]
    clear hgas hch
    try simp only [and_mask_comm, mask_idem, mask_toU256', and_m96_comm, m96_idem, storageAt_readSlot] at *
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, mask_toU256', and_m96_comm, m96_idem, storageAt_readSlot, D_rd, D_bal hsep, D_tot hsep, D_allow hsep, D_cliff hsep, D_flag hsep, D_inv hsep, D_role hsep, D_deleg hsep, D_nonce hsep, m96_or]
    first
      | done
      | (try generalize Dsum _ _ = d at *
         word_omega hc1 hc2)

