  unfold core1_ends at h
  unfold delegOf at hd1 hd2
  rcases h with
    ⟨hc1, hc2, hstat, hacc, hgas, hch⟩
  · rw [Dsum_frame hsep (mvSrc3_frame hch (by key_mem_sep hsep) (by key_mem_sep hsep))]
    clear hgas hch
    try simp only [and_mask_comm, mask_idem, mask_toU256', and_m96_comm, m96_idem, storageAt_readSlot] at *
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, mask_toU256', and_m96_comm, m96_idem, storageAt_readSlot, D_rd, D_bal hsep, D_tot hsep, D_allow hsep, D_cliff hsep, D_flag hsep, D_inv hsep, D_role hsep, D_deleg hsep, D_nonce hsep, m96_or]
    first
      | done
      | (try generalize Dsum _ _ = d at *
         word_omega hc1 hc2)

