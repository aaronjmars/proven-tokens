open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork}

/-- The four bytes of the selector of `totalSupply()`. -/
def SEL_totalSupply : ByteArray := ⟨#[0x18, 0x16, 0x0d, 0xdd]⟩

theorem size_SEL_totalSupply : SEL_totalSupply.size = 4 := by decide

/-- The call `totalSupply()` from `Witness.CALLER1` to `C`. -/
abbrev m_totalSupply (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C : Address) : Message fork :=
  sMsg b t C Witness.CALLER1 CODE SEL_totalSupply

set_option maxHeartbeats 1000000 in
/-- The success path `totalSupply_p1` is not empty: this call runs to the end with no error. -/
theorem totalSupply_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_totalSupply b t C) 0 [] .empty gas (sState C []) ss evm ∧
      (∀ {bound : Nat} (runChild : MessageRunner fork Nat bound),
        GasMeter.gasHeld evm.gas ≤ bound → EndsL runChild evm s) ∧ s.error = none ∧
      s.output = (wordBytes (storageAt (sState C []) (m_totalSupply b t C).currentTarget (4 : U256))) ∧
      s.state = (readSlot (sState C []) (m_totalSupply b t C).currentTarget (4 : U256)) := by
  have hdata : (m_totalSupply b t C).data = SEL_totalSupply := rfl
  have hsz : (m_totalSupply b t C).data.size = 4 := size_SEL_totalSupply
  have hsl : selector (m_totalSupply b t C).data = selector SEL_totalSupply := rfl
  have hval : (m_totalSupply b t C).value = 0 := rfl
  have hcw : (m_totalSupply b t C).caller.toU256 = Witness.CALLER1W := Witness.caller1_toU256
  have hct : (m_totalSupply b t C).currentTarget = C := rfl
  have hacc : hasAccount (sState C []) C := hasAccount_sState C _
  have hspec := totalSupply_p1 (fork := fork) (message := (m_totalSupply b t C))
    (state := sState C []) (substate := ss)
    hfork
    (by rw [hsz]; decide)
    (by rw [hsz]; decide)
    (by rw [hsl]; decide)
    (by
      simp (disch := supply_side) only
        [hval, hsz, hcw, hct, storageAt_readSlot, Readable.storageAt_writeSlot_ite, storageAt_sState_cons, storageAt_sState_nil]
      <;> decide +kernel)
    (Nat.le_refl _)
  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_totalSupply b t C) (sState C []) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, fun rc within => Witness.endsL_of_reaches hr hrun rc within, ?_,
    hH.2.2.1, hH.2.2.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

