theorem ok_symbol (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        572 ≤ gas ∧
        s.output = (memoryReadBytes (memoryWrite (memoryExtend (memW [(0 : U256), (0 : U256), (192 : U256), (0 : U256), (4 : U256), (35871000557718127122438195202175558420611167967113333054775826157475194732544 : U256), (32 : U256), (4 : U256), (35871000557718127122438195202175558420611167967113333054775826157475194732544 : U256)]) 32) 260 (wordBytes (0 : U256))) 192 96) ∧
        s.gas = gas - 572 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => symbol_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := 572) (cost := 572) (fun g hg => symbol_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

