/-!
# The paths of valueSent and their completeness

Generated by `scripts/gen_paths.py` from the runtime bytecode; do not edit. Lean checks every
statement against `CODE`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096
set_option maxHeartbeats 3200000

namespace OndoVerify.Paths

open UsdtVerify
open TokenKit
open OndoVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic
open GasCosts

variable {fork : Fork} {message : Message fork}

open OndoVerify.Blocks UsdtVerify.Complete UsdtVerify.Gas TokenKit.Complete

variable {state : State.TransactionState} {substate : Substate}

variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

theorem valueSent_p0
    (hfork : .berlin ≤ fork)
    (hv : message.value ≠ 0)
    {gas : Nat} (hg : 45 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 45) state substate) := by
  have hd1 : (isZero message.value) = 0 := by exact isZero_eq_zero_iff.mpr hv
  step b0_0 hd1 (by simp) (by omega)
  exact haltGasL (b12_0 hfork (by simp) (by omega)) (by omega)

theorem ok_valueSent (hfork : .berlin ≤ fork)
    (hv : message.value ≠ 0)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    False := by
  exact (no_okLE (B := 45) (fun g hg => valueSent_p0 hfork hv (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim

end OndoVerify.Paths
