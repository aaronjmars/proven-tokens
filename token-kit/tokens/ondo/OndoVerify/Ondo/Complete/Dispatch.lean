import UsdtVerify.Evm.GasRules
import OndoVerify.Ondo.Gen.PValueSent
import OndoVerify.Ondo.Gen.PShort
import OndoVerify.Ondo.Gen.POther

/-!
# Completeness of the dispatcher

Generated by `scripts/gen_dispatch.py` (mode `walk`); do not edit.

Every call data falls in one of three cases (`selector_cases`): fewer than 4 bytes; 4 bytes or
more whose selector is no key of the table; or the selector is the key of entry `i` of the
table, for some `i : Fin 42`.

The paths of the three fallbacks (Gen/PValueSent.lean: a call with a value; Gen/PShort.lean:
fewer than 4 bytes; Gen/POther.lean: a selector that is no key) all end in a revert, for
every gas, out of gas included (`ok_valueSent`, `ok_short`, `ok_other`).

- `ends_ok_dispatch` / `runFrame_ok_dispatch`: from Berlin, for a fresh frame of `CODE` at pc 0
  with call data of size below `2^256`, any gas, any gas bound and any message runner: if the
  loop of the interpreter ends with no error, then the call data has 4 bytes or more, its
  selector is the key of some entry `i` of the table, and the call value is 0.

The code runs opcodes outside the simulated set of usdt-verify (SHR), so the statements are over
the loop of the interpreter (`EndsL`, TokenKit/Evm/SafeL.lean), not over the `Ends` of
usdt-verify.
-/

namespace OndoVerify.Complete

open UsdtVerify
open TokenKit TokenKit.Complete

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic hiding SpecG SpecG.not_ok StepG
open UsdtVerify.Gas
open GasCosts

/-- Every call data has fewer than 4 bytes, or a selector that is no key of the table, or the
selector of entry `i` of the table. -/
theorem selector_cases (data : ByteArray) :
    data.size < 4 ∨
      (4 ≤ data.size ∧ BitVec.ofNat 256 (selector data) ∉ ENTRIES.map Prod.fst) ∨
      (4 ≤ data.size ∧ ∃ i : Fin 42, selector data = ENTRIES[i].1.toNat) := by
  by_cases hs : data.size < 4
  · exact .inl hs
  by_cases hm : BitVec.ofNat 256 (selector data) ∈ ENTRIES.map Prod.fst
  · refine .inr (.inr ⟨by omega, ?_⟩)
    obtain ⟨e, he, hk⟩ := List.mem_map.mp hm
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem he
    have hlen : ENTRIES.length = 42 := rfl
    refine ⟨⟨i, hlen ▸ hi⟩, ?_⟩
    have hlt : selector data < 2 ^ 256 :=
      Nat.lt_of_lt_of_le (selector_lt data) (by decide)
    show selector data = (ENTRIES[i]).1.toNat
    rw [hk, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt]
  · exact .inr (.inl ⟨by omega, hm⟩)

variable {fork : Fork} {message : Message fork} {state : State.TransactionState}
  {substate : Substate}

/-- From Berlin, a fresh frame of `CODE` at pc 0, with any gas, and call data of size below
`2^256`: if the loop of the interpreter runs it to a frame with no error (`EndsL`), then the call
data has at least 4 bytes, its selector is the key of some entry `i` of the table, and the call
value is 0. -/
theorem ends_ok_dispatch (hfork : .berlin ≤ fork) (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} {bound : Nat} {runChild : MessageRunner fork Nat bound} {evm : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm) {s : Evm fork Nat}
    (hrun : TokenKit.EndsL runChild evm s) (hok : s.error = none) :
    4 ≤ message.data.size ∧ message.value = 0 ∧
      ∃ i : Fin 42, selector message.data = ENTRIES[i].1.toNat := by
  by_cases hv : message.value = 0
  · rcases selector_cases message.data with hs | ⟨hs, hunk⟩ | ⟨hs, i, hi⟩
    · exact (Paths.ok_short hfork hs start hrun hok).elim
    · exact (Paths.ok_other hfork hs hsize' hunk start hrun hok).elim
    · exact ⟨hs, hv, i, hi⟩
  · exact (Paths.ok_valueSent hfork hv start hrun hok).elim

/-- From Berlin, a fresh frame of `CODE` at pc 0, with any gas, and call data of size below
`2^256`: if the loop of the interpreter ends with no error, for any gas bound and any message
runner, then the call data has at least 4 bytes, its selector is the key of some entry `i` of the
table, and the call value is 0. -/
theorem runFrame_ok_dispatch (hfork : .berlin ≤ fork) (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} {bound : Nat} {runChild : MessageRunner fork Nat bound} {evm : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (within : GasMeter.gasHeld evm.gas ≤ bound) {s : Evm fork Nat}
    (hrun : Evm.runFrame (step fork) (step_decreases fork) bound runChild evm within = .ok s)
    (hok : s.error = none) :
    4 ≤ message.data.size ∧ message.value = 0 ∧
      ∃ i : Fin 42, selector message.data = ENTRIES[i].1.toNat :=
  ends_ok_dispatch hfork hsize' start ⟨within, hrun⟩ hok

end OndoVerify.Complete
