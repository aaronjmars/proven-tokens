import OndoVerify.Ondo.Gen
import OndoVerify.Ondo.Gen.Loops
import OndoVerify.Ondo.Sep
import OndoVerify.Ondo.Frame
import OndoVerify.Ondo.Arith

/-!
# The supply invariant of ONDO is kept by every successful call

Generated by `scripts/gen_supply_chain.py` from the success paths of `scripts/gen_paths.py`; do
not edit. Lean checks every statement against `CODE`.

`Dsum` is the difference of the invariant (the sum of the `uint96` balances of all addresses minus `totalSupply`); the invariant `Inv` is `Dsum = 0`.

- `delta_<fn>`: a run of `CODE` from pc 0 with the selector of `<fn>` that ends with no error
  ends with the same `Dsum` it started with, under `Sep (callKeys message) (ckKeys message state) (loadWord message.data 4 32)`. Nothing is assumed
  about the start state.
- `supply_<fn>`: so the run keeps `Inv`.
- `delta_step`, `supply_preserved`: the same for any selector other than 0xc3cda520.

`Sep (callKeys message) (ckKeys message state) (loadWord message.data 4 32)` is the hypothesis on keccak of OndoVerify/Ondo/Sep.lean; it is assumed,
not proved.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace OndoVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open OndoVerify.Paths OndoVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}
variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

/-- A successful call of `totalSupply` leaves `Dsum` as it was. -/
theorem delta_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hsep : Sep (callKeys message) (ckKeys message state) (loadWord message.data 4 32))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Dsum message.currentTarget s.state = Dsum message.currentTarget state := by
  rcases ok_totalSupply hfork hsize' hsel start hrun hok with
    ⟨hc1, hgas, hout, hg, hst, hsub⟩
  · rw [hst]
    clear hgas hout hg hst hsub start hrun hok
    try simp only [and_mask_comm, mask_idem, mask_toU256', and_m96_comm, m96_idem, storageAt_readSlot] at *
    have hm1 : message.caller.toU256 ∈ callKeys message := by simp [callKeys]
    have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
    have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
    simp (disch := slot_side) only
      [and_mask_comm, mask_idem, mask_toU256', and_m96_comm, m96_idem, storageAt_readSlot, D_rd, D_bal hsep, D_tot hsep, D_allow hsep, D_cliff hsep, D_flag hsep, D_inv hsep, D_role hsep, D_deleg hsep, D_nonce hsep, m96_or]
    first
      | done
      | (try generalize Dsum _ _ = d at *
         word_omega hc1)

/-- A successful call of `totalSupply` keeps the invariant. -/
theorem supply_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hsep : Sep (callKeys message) (ckKeys message state) (loadWord message.data 4 32))
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state := by
  have h := delta_totalSupply hfork hsize' hsel hsep start hrun hok
  unfold Inv SupplyMask.Inv at hinv ⊢
  unfold Dsum at h
  rw [h]
  exact hinv

