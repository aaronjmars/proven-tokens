/-- A successful call of `symbol` leaves `Dsum` as it was. -/
theorem delta_symbol (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    (hsep : Sep (callKeys message) (ckKeys message state) (loadWord message.data 4 32))
