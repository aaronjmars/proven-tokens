theorem ok_isBlacklisted (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xfe575a87)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (isZero (signedLessThan (sub (add (4 : U256) (sub (BitVec.ofNat 256 message.data.size) (4 : U256))) (4 : U256)) (32 : U256))) ≠ 0 ∧
        (equal (loadWord message.data 4 32) (bitwiseAnd (loadWord message.data 4 32) (1461501637330902918203684832716283019655932542975 : U256))) ≠ 0 ∧
        (915 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256))))) ≤ gas ∧
        s.output = (wordBytes (isZero (isZero (bitwiseAnd (255 : U256) (div (storageAt state message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256))) (1 : U256)))))) ∧
        s.gas = gas - (915 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256))))) ∧
        s.state = (readSlot state message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256))) ∧
        s.substate = (accessSlot substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256)))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => isBlacklisted_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    by_cases hc2 : (isZero (signedLessThan (sub (add (4 : U256) (sub (BitVec.ofNat 256 message.data.size) (4 : U256))) (4 : U256)) (32 : U256))) = 0
    ·
      exact (no_okLE (B := 351) (fun g hg => isBlacklisted_p1 hfork hsize hsize' hsel hc1 hc2 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
    ·
      by_cases hc3 : (equal (loadWord message.data 4 32) (bitwiseAnd (loadWord message.data 4 32) (1461501637330902918203684832716283019655932542975 : U256))) = 0
      ·
        exact (no_okLE (B := 513) (fun g hg => isBlacklisted_p2 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
      ·
        obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (915 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256)))))) (cost := (915 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32))) (1 : U256)))))) (fun g hg => isBlacklisted_p3 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) start hrun hok
        exact ⟨hc1, hc2, hc3, hcg, ho, hgas, hst, hss⟩

