  step b196_0 hd4 (by simp) (by omega)
  have hd5 : (equal (826074471 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b207_0 hd5 (by simp) (by omega)
  step b559_0 (by simp) (by omega)
  step b2208_0 hfork (by simp) (by omega)
  step b567_0 (by simp) (by omega)
  step b6976_0 (by simp) (by omega)
