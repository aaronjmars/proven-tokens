import WbtVerify.Wbt.Readable
import WbtVerify.Wbt.Seq

/-!
# No successful call of WBT makes the total supply larger

Generated by `scripts/gen_nomint.py`; do not edit.

The bytecode has no function that mints: among the 22 selectors, only `burn` and
`destroyBlackFunds` write slot 5 (`_totalSupply`), and both write a smaller or equal word.

- `total_le`: from Berlin, a run of `CODE` from pc 0 that ends with no error, with any selector,
  ends with a word of slot 5 that is at most the word of slot 5 at its start, under
  `Sep (callKeys message)` (the hypothesis on keccak of Sep.lean, not proved).
- `supply_never_grows`: so the word of slot 5 never grows along a finite sequence of successful
  calls and of changes that keep the storage of the contract (`Calls` of Seq.lean).

With `inv_calls` (Seq.lean): if the sum of all balances is `_totalSupply` at the start of such a
sequence, it is at its end, and that common number is at most what it was. The tokens that exist
were put in storage by the constructor, which is not part of the runtime code and is not covered
here.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace WbtVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open WbtVerify.Paths WbtVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256 Address)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

/-- From Berlin, a run of `CODE` from pc 0 that ends with no error, with any selector: the word
of slot 5 (`_totalSupply`) does not grow. `hsep` is the hypothesis on keccak (not proved). -/
theorem total_le {fork : Fork} {message : Message fork}
    {state : State.TransactionState} {substate : Substate}
    {bound : Nat} {runChild : MessageRunner fork Nat bound}
    (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    (storageAt s.state message.currentTarget 5).toNat ≤
      (storageAt state message.currentTarget 5).toNat := by
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by
    simp [callKeys]
  obtain ⟨_, _, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0xa457c2d7 := hi
    have r := (Readable.decreaseAllowance_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat r.2.2.1)
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    have r := (Readable.transfer_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat r.2.2.2.1)
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0xdd62ed3e := hi
    have r := (Readable.allowance_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0xf2fde38b := hi
    have r := (Readable.transferOwnership_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.2.1 5 (by decide)))
  | ⟨4, _⟩, hi =>
    have h : selector message.data = 0xf3bdc228 := hi
    have r := (Readable.destroyBlackFunds_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_trans (Nat.le_of_eq r.2.2.1) (Nat.sub_le _ _)
  | ⟨5, _⟩, hi =>
    have h : selector message.data = 0xfe575a87 := hi
    have r := (Readable.isBlacklisted_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨6, _⟩, hi =>
    have h : selector message.data = 0x70a08231 := hi
    have r := (Readable.balanceOf_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨7, _⟩, hi =>
    have h : selector message.data = 0x715018a6 := hi
    have r := (Readable.renounceOwnership_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.2.1 5 (by decide)))
  | ⟨8, _⟩, hi =>
    have h : selector message.data = 0x8456cb59 := hi
    have r := (Readable.pause_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.2.1 5 (by decide)))
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0x8da5cb5b := hi
    have r := (Readable.owner_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0x95d89b41 := hi
    exact Nat.le_of_eq (congrArg BitVec.toNat
      ((Loops.ro_symbol hfork hsize' h start hrun hok).storage _ 5))
  | ⟨11, _⟩, hi =>
    have h : selector message.data = 0x2f54bf6e := hi
    have r := (Readable.isOwner_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨12, _⟩, hi =>
    have h : selector message.data = 0x313ce567 := hi
    have r := (Readable.decimals_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨13, _⟩, hi =>
    have h : selector message.data = 0x39509351 := hi
    have r := (Readable.increaseAllowance_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat r.2.2.1)
  | ⟨14, _⟩, hi =>
    have h : selector message.data = 0x3f4ba83a := hi
    have r := (Readable.unpause_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.2.1 5 (by decide)))
  | ⟨15, _⟩, hi =>
    have h : selector message.data = 0x42966c68 := hi
    have r := (Readable.burn_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_trans (Nat.le_of_eq r.2.1) (Nat.sub_le _ _)
  | ⟨16, _⟩, hi =>
    have h : selector message.data = 0x5c975abb := hi
    have r := (Readable.paused_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨17, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    exact Nat.le_of_eq (congrArg BitVec.toNat
      ((Loops.ro_name hfork hsize' h start hrun hok).storage _ 5))
  | ⟨18, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    have r := (Readable.approve_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat r.2.2.1)
  | ⟨19, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    have r := (Readable.totalSupply_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat (r.2.1 5))
  | ⟨20, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    have r := (Readable.transferFrom_readable hfork hsize' h hsep start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat r.2.2.2.2.1)
  | ⟨21, _⟩, hi =>
    have h : selector message.data = 0x2d5a5d34 := hi
    have r := (Readable.blacklistAccount_readable hfork hsize' h start hrun hok).2
    exact Nat.le_of_eq (congrArg BitVec.toNat
      (r.2.2.1 5 (fun e => (hsep.black _ hm2).2 e.symm)))
  | ⟨n + 22, hn⟩, _ => exact absurd hn (by omega)

/-- One successful call does not make the word of slot 5 larger. -/
theorem total_le_goodCall {C : Address} {S S' : State.TransactionState}
    (h : GoodCall C S S') : (storageAt S' C 5).toNat ≤ (storageAt S C 5).toNat := by
  obtain ⟨fork, message, substate, gas, bound, runChild, evm, s, within, hC, hfork, hsize, K,
    start, hrun, hok, rfl⟩ := h
  subst hC
  exact total_le hfork hsize K start ⟨within, hrun⟩ hok

/-- The word of slot 5 (`_totalSupply`) never grows along a finite sequence of successful calls
to `C` and of changes that keep the storage of `C`. Each call carries its own hypothesis on
keccak `Sep (callKeys message)`. -/
theorem supply_never_grows {C : Address} {S S' : State.TransactionState}
    (h : Calls C S S') : (storageAt S' C 5).toNat ≤ (storageAt S C 5).toNat := by
  induction h with
  | nil => exact Nat.le_refl _
  | call hg _ ih => exact Nat.le_trans ih (total_le_goodCall hg)
  | other hu _ ih => exact Nat.le_trans ih (Nat.le_of_eq (congrArg BitVec.toNat (hu 5)))

end WbtVerify
