    ((message.value = 0) ∧
      (4 + 32 ≤ message.data.size) ∧
      (arg1 message = (addrArg1 message))) ∧
    ((s.output = wordBytes (isZero (isZero (equal (addrArg1 message) (ownerOf message state))))) ∧
      (∀ k, storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs)) := by
  obtain ⟨hc1, hc2, hc3, hgas, hout, hg, hst, hsub⟩ :=
    ok_isOwner hfork hsize' hsel start hrun hok
