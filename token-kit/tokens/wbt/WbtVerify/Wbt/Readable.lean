    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, Readable.div_one, mul_one_right, zero_or, and_255_comm, and_255_idem, logs_logSub1, Readable.logs_logSub2, log1, Readable.log2, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)

