  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  first
    | (with_reducible rfl)
    | (simp (disch := supply_side) only
        [Supply.D_read, D_bal hsep, D_tot hsep, D_allow hsep, D_black hsep, D_owner hsep, D_paused hsep, storageAt_readSlot, zero_toNat] <;>
       omega)

/-- A successful call of `renounceOwnership` keeps the invariant. -/
theorem supply_renounceOwnership (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x715018a6)
    (hsep : Sep (callKeys message))
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state := by
  unfold Inv Supply.Inv at hinv ⊢
  rw [delta_renounceOwnership hfork hsize' hsel hsep start hrun hok]
  exact hinv

/-- A successful call of `name` leaves `D` as it was: it only reads. -/
theorem delta_name (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Supply.D 3 5 message.currentTarget s.state = Supply.D 3 5 message.currentTarget state :=
  D_congr (fun n => (Loops.ro_name hfork hsize' hsel start hrun hok).storage _ n)

