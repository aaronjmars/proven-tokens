import WbtVerify.Wbt.Gen
import WbtVerify.Wbt.Gen.Loops
import WbtVerify.Wbt.Sep
import WbtVerify.Wbt.Lib

/-!
# The supply invariant of WBT is kept by every successful call

Generated by `scripts/gen_supply.py` from the success paths of the path generator;
do not edit. Lean checks every statement against `CODE`.

`D` (`Supply.D 3 5`) is the sum of the balance words of the 2^160 addresses minus the
word of slot 5 (`_totalSupply`). The invariant `Inv` is `D = 0`.

- `delta_<fn>`: a run of `CODE` from pc 0 with the selector of `<fn>` that ends with no error
  ends with the same `D` it started with, under `Sep (callKeys message)`. Nothing is assumed
  about the start state. So the sum of the balances moves exactly as `_totalSupply` does: it is
  unchanged by every function but `burn` and `destroyBlackFunds`, where both go down by the same
  amount (the readable corollaries of WbtVerify/Wbt/Readable.lean give the amount).
- `supply_<fn>`: so the run keeps `Inv`.
- `delta_step`, `supply_preserved`: the same for any selector of the table.

`Sep (callKeys message)` is the hypothesis on keccak of WbtVerify/Wbt/Sep.lean; it is assumed,
not proved.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace WbtVerify

open UsdtVerify
open TokenKit TokenKit.Complete
open WbtVerify.Paths WbtVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}
variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

/-- A successful call of `totalSupply` leaves `D` as it was. -/
theorem delta_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Supply.D 3 5 message.currentTarget s.state = Supply.D 3 5 message.currentTarget state := by
  obtain ⟨hc1, hgas, hout, hg, hst, hsub⟩ :=
    ok_totalSupply hfork hsize' hsel start hrun hok
  rw [hst]
  clear hst hgas hout hg hsub start hrun hok
  try simp only [and_mask_comm, mask_idem, storageAt_readSlot] at *
  have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  first
    | (with_reducible rfl)
    | (simp (disch := supply_side) only
        [Supply.D_read, D_bal hsep, D_tot hsep, D_allow hsep, D_black hsep, D_owner hsep, D_paused hsep, storageAt_readSlot, zero_toNat] <;>
       omega)

/-- A successful call of `totalSupply` keeps the invariant. -/
theorem supply_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hsep : Sep (callKeys message))
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state := by
  unfold Inv Supply.Inv at hinv ⊢
  rw [delta_totalSupply hfork hsize' hsel hsep start hrun hok]
  exact hinv

