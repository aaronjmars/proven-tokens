/-- From Berlin, a run of `CODE` from pc 0 that ends with no error, with any selector,
ends with the `D` it started with: the sum of all balances and `_totalSupply` move by the same amount.
`hsep` is the hypothesis on keccak (not proved). -/
theorem delta_step (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Supply.D 3 5 message.currentTarget s.state = Supply.D 3 5 message.currentTarget state := by
  obtain ⟨_, _, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0xa457c2d7 := hi
    exact delta_decreaseAllowance hfork hsize' h hsep start hrun hok
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    exact delta_transfer hfork hsize' h hsep start hrun hok
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0xdd62ed3e := hi
    exact delta_allowance hfork hsize' h hsep start hrun hok
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0xf2fde38b := hi
    exact delta_transferOwnership hfork hsize' h hsep start hrun hok
  | ⟨4, _⟩, hi =>
    have h : selector message.data = 0xf3bdc228 := hi
    exact delta_destroyBlackFunds hfork hsize' h hsep start hrun hok
  | ⟨5, _⟩, hi =>
    have h : selector message.data = 0xfe575a87 := hi
    exact delta_isBlacklisted hfork hsize' h hsep start hrun hok
  | ⟨6, _⟩, hi =>
    have h : selector message.data = 0x70a08231 := hi
    exact delta_balanceOf hfork hsize' h hsep start hrun hok
  | ⟨7, _⟩, hi =>
    have h : selector message.data = 0x715018a6 := hi
    exact delta_renounceOwnership hfork hsize' h hsep start hrun hok
  | ⟨8, _⟩, hi =>
    have h : selector message.data = 0x8456cb59 := hi
    exact delta_pause hfork hsize' h hsep start hrun hok
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0x8da5cb5b := hi
    exact delta_owner hfork hsize' h hsep start hrun hok
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0x95d89b41 := hi
    exact delta_symbol hfork hsize' h start hrun hok
  | ⟨11, _⟩, hi =>
    have h : selector message.data = 0x2f54bf6e := hi
    exact delta_isOwner hfork hsize' h hsep start hrun hok
  | ⟨12, _⟩, hi =>
    have h : selector message.data = 0x313ce567 := hi
    exact delta_decimals hfork hsize' h hsep start hrun hok
  | ⟨13, _⟩, hi =>
    have h : selector message.data = 0x39509351 := hi
    exact delta_increaseAllowance hfork hsize' h hsep start hrun hok
  | ⟨14, _⟩, hi =>
    have h : selector message.data = 0x3f4ba83a := hi
    exact delta_unpause hfork hsize' h hsep start hrun hok
  | ⟨15, _⟩, hi =>
    have h : selector message.data = 0x42966c68 := hi
    exact delta_burn hfork hsize' h hsep start hrun hok
  | ⟨16, _⟩, hi =>
    have h : selector message.data = 0x5c975abb := hi
    exact delta_paused hfork hsize' h hsep start hrun hok
  | ⟨17, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    exact delta_name hfork hsize' h start hrun hok
  | ⟨18, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    exact delta_approve hfork hsize' h hsep start hrun hok
  | ⟨19, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    exact delta_totalSupply hfork hsize' h hsep start hrun hok
  | ⟨20, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    exact delta_transferFrom hfork hsize' h hsep start hrun hok
  | ⟨21, _⟩, hi =>
    have h : selector message.data = 0x2d5a5d34 := hi
    exact delta_blacklistAccount hfork hsize' h hsep start hrun hok
  | ⟨n + 22, hn⟩, _ => exact absurd hn (by omega)

