    (by rw [hsl]; decide)
    rfl
    hacc
    (by
      simp (disch := supply_side) only
        [hval, hsz, hcw, hct, storageAt_readSlot, Readable.storageAt_writeSlot_ite, storageAt_sState_cons, storageAt_sState_nil]
      <;> decide +kernel)
