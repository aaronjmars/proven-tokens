/-- From pc 4762 (the answer of the owner has a nonzero bit after its first 4 bytes): the decoder reverts. -/
theorem tail_mask (hfork : .berlin ≤ fork) {bound : Nat}
    {runChild : MessageRunner fork Nat bound} {s : Evm fork Nat} {B : Nat}
    {R : List U256} {m rd : ByteArray} {st : State.TransactionState} {ss : Substate}
    (hR : R.length ≤ 100)
    (h : RunsTo runChild s CODE message B 4762 (R) m st ss rd)
    (hok : s.error = none) : False := by
  ls 4764 (lpushAny 1)
  ls 4765 (ldup 0)
  exact h.reverts (fun G hG => Logic.revertG (Nat.le_trans (by decide) hfork) (by code_fact)
    (by code_fact) hG) hok

