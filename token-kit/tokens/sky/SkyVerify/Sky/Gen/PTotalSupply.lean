theorem totalSupply_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 45 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 45) state substate) := by
  step b0_0 hc1 (by simp) (by omega)
  exact haltGasL (b12_0 hfork (by simp) (by omega)) (by omega)

theorem totalSupply_p1
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : (263 + (slotCost (coldIn substate message.currentTarget (1 : U256)))) ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted false (wordBytes (storageAt state message.currentTarget (1 : U256))) (gas - (263 + (slotCost (coldIn substate message.currentTarget (1 : U256))))) (readSlot state message.currentTarget (1 : U256)) (accessSlot substate message.currentTarget (1 : U256))) := by
  step b0_1 hc1 (by simp) (by omega)
  have hd1 : (lessThan (BitVec.ofNat 256 message.data.size) (4 : U256)) = 0 := by exact size_lt4_zero hsize hsize'
  step b16_0 hd1 (by simp) (by omega)
  have hd2 : (greaterThan (1889567281 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b26_0 hfork hd2 (by simp) (by omega)
  have hd3 : (greaterThan (826074471 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b184_0 hd3 (by simp) (by omega)
  have hd4 : (equal (117300739 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b255_0 hd4 (by simp) (by omega)
  have hd5 : (equal (157198259 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b267_0 hd5 (by simp) (by omega)
  have hd6 : (equal (404098525 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b278_0 hd6 (by simp) (by omega)
  step b424_0 hfork (by simp) (by omega)
  step b433_0 (by simp) (by omega)
  exact haltGasL (b380_0 (by simp) (by omega)) (by omega)

theorem ok_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (263 + (slotCost (coldIn substate message.currentTarget (1 : U256)))) ≤ gas ∧
        s.output = (wordBytes (storageAt state message.currentTarget (1 : U256))) ∧
        s.gas = gas - (263 + (slotCost (coldIn substate message.currentTarget (1 : U256)))) ∧
        s.state = (readSlot state message.currentTarget (1 : U256)) ∧
        s.substate = (accessSlot substate message.currentTarget (1 : U256))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => totalSupply_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (263 + (slotCost (coldIn substate message.currentTarget (1 : U256))))) (cost := (263 + (slotCost (coldIn substate message.currentTarget (1 : U256))))) (fun g hg => totalSupply_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

