theorem ok_versionEntry (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x54fd4d50)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        208 ≤ gas ∧
        ∃ z : Evm fork Nat,
          At CODE message 560 [(BitVec.ofNat 256 (selector message.data))] (memW [(0 : U256), (0 : U256), (128 : U256)]) (gas - 208) state substate z ∧
          EndsL runChild z s) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => versionEntry_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, z, hz, hzr⟩ := ok_splitLE (B := 208) (c := 208) (by omega) (fun g hg => versionEntry_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, z, hz, hzr⟩

