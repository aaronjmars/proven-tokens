theorem ok_permitBytes (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x9fd5a6cf)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (isZero (signedLessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (160 : U256))) ≠ 0 ∧
        (equal (loadWord message.data 4 32) (bitwiseAnd (loadWord message.data 4 32) (1461501637330902918203684832716283019655932542975 : U256))) ≠ 0 ∧
        (equal (loadWord message.data 36 32) (bitwiseAnd (loadWord message.data 36 32) (1461501637330902918203684832716283019655932542975 : U256))) ≠ 0 ∧
        (isZero (greaterThan (loadWord message.data 132 32) (18446744073709551615 : U256))) ≠ 0 ∧
        (signedLessThan (add (add (4 : U256) (loadWord message.data 132 32)) (31 : U256)) (BitVec.ofNat 256 message.data.size)) ≠ 0 ∧
        513 ≤ gas ∧
        ∃ z : Evm fork Nat,
          At CODE message 4202 [(add (4 : U256) (loadWord message.data 132 32)), (18446744073709551615 : U256), (add (4 : U256) (loadWord message.data 132 32)), (0 : U256), (loadWord message.data 100 32), (loadWord message.data 68 32), (loadWord message.data 36 32), (loadWord message.data 4 32), (4 : U256), (BitVec.ofNat 256 message.data.size), (761 : U256), (558 : U256), (BitVec.ofNat 256 (selector message.data))] (memW [(0 : U256), (0 : U256), (128 : U256)]) (gas - 513) state substate z ∧
          EndsL runChild z s) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => permitBytes_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    by_cases hc2 : (isZero (signedLessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (160 : U256))) = 0
    ·
      exact (no_okLE (B := 217) (fun g hg => permitBytes_p1 hfork hsize hsize' hsel hc1 hc2 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
    ·
      by_cases hc3 : (equal (loadWord message.data 4 32) (bitwiseAnd (loadWord message.data 4 32) (1461501637330902918203684832716283019655932542975 : U256))) = 0
      ·
        exact (no_okLE (B := 282) (fun g hg => permitBytes_p2 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
      ·
        by_cases hc4 : (equal (loadWord message.data 36 32) (bitwiseAnd (loadWord message.data 36 32) (1461501637330902918203684832716283019655932542975 : U256))) = 0
        ·
          exact (no_okLE (B := 375) (fun g hg => permitBytes_p3 hfork hsize hsize' hsel hc1 hc2 hc3 hc4 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
        ·
          by_cases hc5 : (isZero (greaterThan (loadWord message.data 132 32) (18446744073709551615 : U256))) = 0
          ·
            exact (no_okLE (B := 472) (fun g hg => permitBytes_p4 hfork hsize hsize' hsel hc1 hc2 hc3 hc4 hc5 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
          ·
            by_cases hc6 : (signedLessThan (add (add (4 : U256) (loadWord message.data 132 32)) (31 : U256)) (BitVec.ofNat 256 message.data.size)) = 0
            ·
              exact (no_okLE (B := 515) (fun g hg => permitBytes_p5 hfork hsize hsize' hsel hc1 hc2 hc3 hc4 hc5 hc6 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
