theorem ok_other (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : BitVec.ofNat 256 (selector message.data) ∉ ENTRIES.map Prod.fst)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    False := by
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => other_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    by_cases hc2 : (greaterThan (1889567281 : U256) (BitVec.ofNat 256 (selector message.data))) = 0
    ·
      by_cases hc3 : (greaterThan (2681579215 : U256) (BitVec.ofNat 256 (selector message.data))) = 0
      ·
        exact (no_okLE (B := 257) (fun g hg => other_p1 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
      ·
        exact (no_okLE (B := 236) (fun g hg => other_p2 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
    ·
      by_cases hc3 : (greaterThan (826074471 : U256) (BitVec.ofNat 256 (selector message.data))) = 0
      ·
        exact (no_okLE (B := 236) (fun g hg => other_p3 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
      ·
        exact (no_okLE (B := 238) (fun g hg => other_p4 hfork hsize hsize' hsel hc1 hc2 hc3 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim

