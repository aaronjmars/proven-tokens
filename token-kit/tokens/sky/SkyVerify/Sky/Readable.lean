import SkyVerify.Sky.Invariant
import TokenKit.Evm.Readable
import TokenKit.Evm.ReadableOpt
import TokenKit.Evm.SupplyUnchecked

/-!
# Readable corollaries of the success paths of SKY

Generated by `scripts/gen_readable.py` from the descriptions in the configuration of the token
(`readable`) and the success paths of `scripts/gen_paths.py`; do not edit. Each theorem is proved
from the raw-term theorem `ok_<fn>`.

`<fn>_readable`: a run of `CODE` from pc 0 with the selector of `<fn>` that ends with no error.
The first group of claims is what the call and the START state must satisfy; the second is the
output, the END storage as a function of the start storage, and the logs. For a function that
writes, the theorem takes `Sep (callKeys message)` (the hypothesis on keccak of Sep.lean, not
proved): without it two of the slots could be the same slot.

Words of the call: `sender` is the caller, `addrArg1` and `addrArg2` the first two arguments
masked to 160 bits (as the bytecode masks them), `arg1`, `arg2`, `arg3` the argument words.
Numbers are compared as natural numbers (`.toNat`), so no claim wraps.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace SkyVerify.Readable

open UsdtVerify
open TokenKit TokenKit.Complete TokenKit.Readable
open SkyVerify SkyVerify.Paths SkyVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256 Address)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}
variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

/-- `_balances[a]` of the called contract in the state `S`. -/
abbrev balance (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot a 2)

/-- `_allowances[o][sp]` of the called contract in the state `S`. -/
abbrev allowance (m : Message fork) (S : State.TransactionState) (o sp : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot sp (mapSlot o 3))

/-- `_totalSupply` of the called contract in the state `S`. -/
abbrev totalSupply (m : Message fork) (S : State.TransactionState) : U256 :=
  storageAt S m.currentTarget 1

/-- The caller, as an address word. -/
abbrev sender (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) m.caller.toU256

/-- The first argument, masked to an address word. -/
abbrev addrArg1 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 4 32)

/-- The second argument, masked to an address word. -/
abbrev addrArg2 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 36 32)

/-- The argument words. -/
abbrev arg1 (m : Message fork) : U256 := loadWord m.data 4 32
abbrev arg2 (m : Message fork) : U256 := loadWord m.data 36 32
abbrev arg3 (m : Message fork) : U256 := loadWord m.data 68 32

/-- The caller, as a word (an address word: below 2^160). -/
abbrev callerW (m : Message fork) : U256 := m.caller.toU256

/-- The address of the called contract, as a word. -/
abbrev thisW (m : Message fork) : U256 := m.currentTarget.toU256

/-- The chain id of the block, as a word (what CHAINID pushes). -/
abbrev chainIdW (m : Message fork) : U256 := BitVec.ofNat 256 m.blockEnv.chainId.toNat

/-- `wards[a]` of the called contract in the state `S` (1: `a` may call rely, deny and mint). -/
abbrev wardOf (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot a 0)

/-- `nonces[a]` of the called contract in the state `S`. -/
abbrev nonceOf (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot a 4)

/-- `PERMIT_TYPEHASH`, a constant of the code. -/
abbrev PERMIT_TYPEHASH : U256 :=
  (49955707469362902507454157297736832118868343942642399513960811609542965143241 : U256)

/-- The domain separator that the code holds as a constant and returns when the chain id is 1. -/
abbrev DOMAIN_SEPARATOR_MAINNET : U256 :=
  (88021402408547776102591478376141464261910208107393209539845231887077057693780 : U256)

/-- The domain separator that the code computes when the chain id is not 1: the keccak of five words (the EIP-712 domain type hash, the hash of the name, the hash of the version, the chain id, the address of the contract). -/
abbrev domainSeparatorOf (m : Message fork) : U256 :=
  keccak (memW [(63076024560530113402979550242307453568063438748328787417531900361828837441551 : U256), (42607552171995751425823498296870486043198744678280595602348571221231826827713 : U256), (90743482286830539503240959006302832933333810038750515972785732718729991261126 : U256), (BitVec.ofNat 256 m.blockEnv.chainId.toNat), m.currentTarget.toU256])

/-- The topic of the event `Transfer(address,address,uint256)`. -/
abbrev TRANSFER : U256 := (100389287136786176327247604509743168900146139575972864366142685224231313322991 : U256)

/-- The topic of the event `Approval(address,address,uint256)`. -/
abbrev APPROVAL : U256 := (63486140976153616755203102783360879283472101686154884697241723088393386309925 : U256)

/-- The topic of the event `Rely(address)`. -/
abbrev RELY : U256 := (99986234382112180548053307940146098591310749102190014697170127658504464915040 : U256)

/-- The topic of the event `Deny(address)`. -/
abbrev DENY : U256 := (10976212123044202199007331841938769688047881638844999939251365927447214499099 : U256)

/-- totalSupply(). Success needs no value. Then: returns the word of slot 1 (`totalSupply`); no slot changes; no log. -/
theorem totalSupply_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((message.value = 0)) ∧
    ((s.output = wordBytes (totalSupply message state)) ∧
      (∀ k, storageAt s.state message.currentTarget k = storageAt state message.currentTarget k) ∧
      (s.substate.logs = substate.logs)) := by
  obtain ⟨hc1, hgas, hout, hg, hst, hsub⟩ :=
    ok_totalSupply hfork hsize' hsel start hrun hok
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  clear hgas hg start hrun hok
  try simp only [balance, allowance, totalSupply, sender, addrArg1, addrArg2, arg1, arg2, arg3, callerW, thisW, chainIdW, wardOf, nonceOf, PERMIT_TYPEHASH, DOMAIN_SEPARATOR_MAINNET, domainSeparatorOf, TRANSFER, APPROVAL, RELY, DENY]
  rw [hst, hout, hsub]
  clear hst hout hsub
  have hm1 : message.caller.toU256 ∈ callKeys message := by simp [callKeys]
  have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
  have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, mask_toU256', Readable.logs_logSub2, Readable.log2, Supply.add_sub_self, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1
  have v1 := Readable.value_of_cond hc1
  refine ⟨?_, ?_, ?_, ?_⟩
  all_goals first
    | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, mask_toU256', Readable.logs_logSub2, Readable.log2, Supply.add_sub_self, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, mask_toU256', Readable.logs_logSub2, Readable.log2, Supply.add_sub_self, eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)

