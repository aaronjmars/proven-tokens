/-- From Berlin, a run of `CODE` from pc 0 that ends with no error, with any selector other than 0x9fd5a6cf, 0xd505accf,
keeps the invariant: if the sum of all balances was `totalSupply` before, it is after.
`hsep` is the hypothesis on keccak (not proved). -/
theorem supply_preserved (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel0 : selector message.data ≠ 0x9fd5a6cf)
    (hsel4 : selector message.data ≠ 0xd505accf)
    (hsep : Sep (callKeys message))
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state := by
  obtain ⟨_, _, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0x9fd5a6cf := hi
    exact absurd h hsel0
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    exact supply_transfer hfork hsize' h hsep hinv start hrun hok
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0xbf353dbb := hi
    exact supply_wards hfork hsize' h hsep hinv start hrun hok
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0xcd0d0096 := hi
    exact supply_deploymentChainId hfork hsize' h hsep hinv start hrun hok
  | ⟨4, _⟩, hi =>
    have h : selector message.data = 0xd505accf := hi
    exact absurd h hsel4
  | ⟨5, _⟩, hi =>
    have h : selector message.data = 0xdd62ed3e := hi
    exact supply_allowance hfork hsize' h hsep hinv start hrun hok
  | ⟨6, _⟩, hi =>
    have h : selector message.data = 0x70a08231 := hi
    exact supply_balanceOf hfork hsize' h hsep hinv start hrun hok
  | ⟨7, _⟩, hi =>
    have h : selector message.data = 0x7ecebe00 := hi
    exact supply_nonces hfork hsize' h hsep hinv start hrun hok
  | ⟨8, _⟩, hi =>
    have h : selector message.data = 0x95d89b41 := hi
    exact supply_symbol hfork hsize' h hinv start hrun hok
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0x9c52a7f1 := hi
    exact supply_deny hfork hsize' h hsep hinv start hrun hok
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0x9dc29fac := hi
    exact supply_burn hfork hsize' h hsep hinv start hrun hok
  | ⟨11, _⟩, hi =>
    have h : selector message.data = 0x313ce567 := hi
    exact supply_decimals hfork hsize' h hsep hinv start hrun hok
  | ⟨12, _⟩, hi =>
    have h : selector message.data = 0x3644e515 := hi
    exact supply_domainSeparator hfork hsize' h hsep hinv start hrun hok
  | ⟨13, _⟩, hi =>
    have h : selector message.data = 0x40c10f19 := hi
    exact supply_mint hfork hsize' h hsep hinv start hrun hok
  | ⟨14, _⟩, hi =>
    have h : selector message.data = 0x54fd4d50 := hi
    exact supply_version hfork hsize' h hinv start hrun hok
  | ⟨15, _⟩, hi =>
    have h : selector message.data = 0x65fae35e := hi
    exact supply_rely hfork hsize' h hsep hinv start hrun hok
  | ⟨16, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    exact supply_name hfork hsize' h hinv start hrun hok
  | ⟨17, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    exact supply_approve hfork hsize' h hsep hinv start hrun hok
  | ⟨18, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    exact supply_totalSupply hfork hsize' h hsep hinv start hrun hok
  | ⟨19, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    exact supply_transferFrom hfork hsize' h hsep hinv start hrun hok
  | ⟨20, _⟩, hi =>
    have h : selector message.data = 0x30adf81f := hi
    exact supply_permitTypehash hfork hsize' h hsep hinv start hrun hok
  | ⟨n + 21, hn⟩, _ => exact absurd hn (by omega)

