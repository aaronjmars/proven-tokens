/-- From Berlin, a run of `CODE` from pc 0 that ends with no error: `D` is unchanged, or the call is `mint` and `D` grows by `((loadWord message.data 36 32).toNat : Int)`;
the slots 1, 3 keep their word. `hsep` is the hypothesis on keccak (not proved). -/
theorem supply_step (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    (Supply.D 0 1 message.currentTarget s.state = Supply.D 0 1 message.currentTarget state ∨
      (selector message.data = 0x40c10f19 ∧
        Supply.D 0 1 message.currentTarget s.state = Supply.D 0 1 message.currentTarget state + ((loadWord message.data 36 32).toNat : Int))) ∧
      storageAt s.state message.currentTarget 1 = storageAt state message.currentTarget 1 ∧
      storageAt s.state message.currentTarget 3 = storageAt state message.currentTarget 3 := by
  obtain ⟨_, _, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    have hd := delta_name hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    have hd := delta_approve hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    have hd := delta_totalSupply hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    have hd := delta_transferFrom hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨4, _⟩, hi =>
    have h : selector message.data = 0x313ce567 := hi
    have hd := delta_decimals hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨5, _⟩, hi =>
    have h : selector message.data = 0x40c10f19 := hi
    have hd := delta_mint hfork hsize' h hsep start hrun hok
    exact ⟨Or.inr (⟨h, hd.1⟩), hd.2⟩
  | ⟨6, _⟩, hi =>
    have h : selector message.data = 0x414d784e := hi
    have hd := delta_DECIMAL_ZEROS hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨7, _⟩, hi =>
    have h : selector message.data = 0x66188463 := hi
    have hd := delta_decreaseApproval hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨8, _⟩, hi =>
    have h : selector message.data = 0x70a08231 := hi
    have hd := delta_balanceOf hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0x95d89b41 := hi
    have hd := delta_symbol hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0x9c1e03a0 := hi
    have hd := delta_crowdsale hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨11, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    have hd := delta_transfer hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨12, _⟩, hi =>
    have h : selector message.data = 0xd73dd623 := hi
    have hd := delta_increaseApproval hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨13, _⟩, hi =>
    have h : selector message.data = 0xdd62ed3e := hi
    have hd := delta_allowance hfork hsize' h hsep start hrun hok
    exact ⟨Or.inl hd.1, hd.2⟩
  | ⟨n + 14, hn⟩, _ => exact absurd hn (by omega)

end QntVerify
