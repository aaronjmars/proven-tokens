import QntVerify.Qnt.Gen
import QntVerify.Qnt.Sep

/-!
# What every successful call of QNT does to the sum of the balances

Generated by `scripts/gen_supply.py` (mode `delta`) from the success paths of
`scripts/gen_paths.py`; do not edit. Lean checks every statement against `CODE`.

`D` is the sum of all balances minus the word of the total supply slot (1); the invariant
"the sum of all balances is the total supply" is `D = 0`.

- `delta_<fn>`: a run of `CODE` from pc 0 with the selector of `<fn>` that ends with no error
  ends with `D` as stated (unchanged, but `mint`: plus `((loadWord message.data 36 32).toNat : Int)`), and with the word of each of the slots 1, 3 unchanged,
  under `Sep (callKeys message)`.
- `supply_step`: the same for any selector of the table.

`Sep (callKeys message)` is the hypothesis on keccak of QntVerify/Qnt/Sep.lean; it is assumed,
not proved.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace QntVerify

open UsdtVerify
open TokenKit
open QntVerify.Paths QntVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

variable {fork : Fork} {message : Message fork}
variable {state : State.TransactionState} {substate : Substate}

/-- A successful call of `name`: `D` is unchanged, the slots 1, 3 keep their word. -/
theorem delta_name (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    (hsep : Sep (callKeys message))
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    Supply.D 0 1 message.currentTarget s.state = Supply.D 0 1 message.currentTarget state ∧
      storageAt s.state message.currentTarget 1 = storageAt state message.currentTarget 1 ∧
      storageAt s.state message.currentTarget 3 = storageAt state message.currentTarget 3 := by
  rcases ok_name hfork hsize' hsel start hrun hok with
    ⟨hc1, hgas, hout, hg, hst, hsub⟩
  · rw [hst]
    clear hst hgas hout hg hsub start hrun hok
    try simp only [mask_idem, storageAt_readSlot] at *
    have hm1 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) message.caller.toU256 ∈ callKeys message := by simp [callKeys]
    have hm2 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32) ∈ callKeys message := by simp [callKeys]
    have hm3 : bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32) ∈ callKeys message := by simp [callKeys]
    refine ⟨?_, ?_, ?_⟩
    · first
        | (simp (disch := supply_side) only
            [Supply.D_read, D_bal hsep, D_tot hsep, D_allow hsep, storageAt_readSlot]
           first | done | (generalize Supply.D 0 1 message.currentTarget state = d0; omega))
        | (with_reducible rfl)
    · first
        | (simp (disch := first | decide | supply_side) only
            [storageAt_readSlot, keep_bal hsep, keep_allow hsep]; done)
        | (with_reducible rfl)
    · first
        | (simp (disch := first | decide | supply_side) only
            [storageAt_readSlot, keep_bal hsep, keep_allow hsep]; done)
        | (with_reducible rfl)

