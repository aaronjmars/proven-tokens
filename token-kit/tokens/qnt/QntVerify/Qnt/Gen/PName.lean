open QntVerify.Blocks QntVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

variable {state : State.TransactionState} {substate : Substate}

theorem name_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 109 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 109) state substate) := by
  step enter hsize hsize' ⟨0, by decide⟩ (key := 0x06fdde03) (dest := 213) (N := 84) (by decide) (by decide) (by decide) hsel (by omega)
  step b213_0 hc1 (by simp) (by omega)
  exact haltGas (b220_0 hfork (by simp) (by omega)) (by omega)

theorem name_p1
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : 589 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted false (memW [(32 : U256), (5 : U256), (36844734289029646329610895024640871465484553708195300207132374707301909528576 : U256)]) (gas - 589) state substate) := by
  step enter hsize hsize' ⟨0, by decide⟩ (key := 0x06fdde03) (dest := 213) (N := 84) (by decide) (by decide) (by decide) hsel (by omega)
  step b213_1 hc1 (by simp) (by omega)
  step b224_0 (by simp) (by omega)
  step b1443_0 (by simp) (by omega)
  step b232_0 (by simp) (by omega)
  step b266_0 (by simp) (by omega)
  step b269_0 (by simp) (by omega)
  step b278_0 (by simp) (by omega)
  step b269_1 (by simp) (by omega)
  step b296_0 (by simp) (by omega)
  step b316_0 hfork (by simp) (by omega)
  exact haltGas (b341_0 (by simp) (by omega)) (by omega)

theorem ok_name (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        589 ≤ gas ∧
        s.output = (memW [(32 : U256), (5 : U256), (36844734289029646329610895024640871465484553708195300207132374707301909528576 : U256)]) ∧
        s.gas = gas - 589 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 109) (fun g hg => name_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactE (B := 589) (cost := 589) (by omega) (fun g hg => name_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

end QntVerify.Paths
