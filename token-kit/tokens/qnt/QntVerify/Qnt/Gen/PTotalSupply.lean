theorem ok_totalSupply (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (238 + (slotCost (coldIn substate message.currentTarget (1 : U256)))) ≤ gas ∧
        s.output = (wordBytes (storageAt state message.currentTarget (1 : U256))) ∧
        s.gas = gas - (238 + (slotCost (coldIn substate message.currentTarget (1 : U256)))) ∧
        s.state = (readSlot state message.currentTarget (1 : U256)) ∧
        s.substate = (accessSlot substate message.currentTarget (1 : U256))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 153) (fun g hg => totalSupply_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactE (B := (238 + (slotCost (coldIn substate message.currentTarget (1 : U256))))) (cost := (238 + (slotCost (coldIn substate message.currentTarget (1 : U256))))) (by omega) (fun g hg => totalSupply_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

