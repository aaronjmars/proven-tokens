theorem DECIMAL_ZEROS_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x414d784e)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 241 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 241) state substate) := by
  step enter hsize hsize' ⟨6, by decide⟩ (key := 0x414d784e) (dest := 720) (N := 216) (by decide) (by decide) (by decide) hsel (by omega)
  step b720_0 hc1 (by simp) (by omega)
  exact haltGas (b727_0 hfork (by simp) (by omega)) (by omega)

theorem DECIMAL_ZEROS_p1
