  step b720_1 hc1 (by simp) (by omega)
  step b731_0 (by simp) (by omega)
  step b3034_0 (by simp) (by omega)
  exact haltGas (b739_0 (by simp) (by omega)) (by omega)

theorem ok_DECIMAL_ZEROS (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x414d784e)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        318 ≤ gas ∧
        s.output = (wordBytes (1000000000000000000 : U256)) ∧
        s.gas = gas - 318 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 241) (fun g hg => DECIMAL_ZEROS_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactE (B := 318) (cost := 318) (by omega) (fun g hg => DECIMAL_ZEROS_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

