open QntVerify.Blocks QntVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

variable {state : State.TransactionState} {substate : Substate}

theorem symbol_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 307 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 307) state substate) := by
  step enter hsize hsize' ⟨9, by decide⟩ (key := 0x95d89b41) (dest := 928) (N := 282) (by decide) (by decide) (by decide) hsel (by omega)
  step b928_0 hc1 (by simp) (by omega)
  exact haltGas (b935_0 hfork (by simp) (by omega)) (by omega)

theorem symbol_p1
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : 787 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted false (memW [(32 : U256), (3 : U256), (36775734552990421843304898699955537258571255722722795306813745125739387158528 : U256)]) (gas - 787) state substate) := by
  step enter hsize hsize' ⟨9, by decide⟩ (key := 0x95d89b41) (dest := 928) (N := 282) (by decide) (by decide) (by decide) hsel (by omega)
  step b928_1 hc1 (by simp) (by omega)
  step b939_0 (by simp) (by omega)
  step b3775_0 (by simp) (by omega)
  step b947_0 (by simp) (by omega)
  step b981_0 (by simp) (by omega)
  step b984_0 (by simp) (by omega)
  step b993_0 (by simp) (by omega)
  step b984_1 (by simp) (by omega)
  step b1011_0 (by simp) (by omega)
  step b1031_0 hfork (by simp) (by omega)
  exact haltGas (b1056_0 (by simp) (by omega)) (by omega)

theorem ok_symbol (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x95d89b41)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        787 ≤ gas ∧
        s.output = (memW [(32 : U256), (3 : U256), (36775734552990421843304898699955537258571255722722795306813745125739387158528 : U256)]) ∧
        s.gas = gas - 787 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 307) (fun g hg => symbol_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactE (B := 787) (cost := 787) (by omega) (fun g hg => symbol_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

end QntVerify.Paths
