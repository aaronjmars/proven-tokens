/-!
# The paths of decimals and their completeness

Generated by `scripts/gen_paths.py` from the runtime bytecode; do not edit. Lean checks every
statement against `CODE`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace QntVerify.Paths

open UsdtVerify
open TokenKit
open QntVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic
open GasCosts

variable {fork : Fork} {message : Message fork}

open QntVerify.Blocks QntVerify.Complete UsdtVerify.Complete UsdtVerify.Gas

variable {state : State.TransactionState} {substate : Substate}

theorem decimals_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 197 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 197) state substate) := by
  step enter hsize hsize' ⟨4, by decide⟩ (key := 0x313ce567) (dest := 607) (N := 172) (by decide) (by decide) (by decide) hsel (by omega)
  step b607_0 hc1 (by simp) (by omega)
  exact haltGas (b614_0 hfork (by simp) (by omega)) (by omega)

theorem decimals_p1
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : 286 ≤ gas) :
    Gas.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted false (wordBytes (18 : U256)) (gas - 286) state substate) := by
  step enter hsize hsize' ⟨4, by decide⟩ (key := 0x313ce567) (dest := 607) (N := 172) (by decide) (by decide) (by decide) hsel (by omega)
  step b607_1 hc1 (by simp) (by omega)
  step b618_0 (by simp) (by omega)
  step b2706_0 (by simp) (by omega)
  exact haltGas (b626_0 (by simp) (by omega)) (by omega)

theorem ok_decimals (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : Ends fork evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        286 ≤ gas ∧
        s.output = (wordBytes (18 : U256)) ∧
        s.gas = gas - 286 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okE (B := 197) (fun g hg => decimals_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => halted_true_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactE (B := 286) (cost := 286) (by omega) (fun g hg => decimals_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

end QntVerify.Paths
