/-- The four bytes of the selector of `name()`. -/
def SEL_name : ByteArray := ⟨#[0x06, 0xfd, 0xde, 0x03]⟩

theorem size_SEL_name : SEL_name.size = 4 := by decide

/-- The call `name()` from `caller` to `C`. -/
abbrev m_name (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C caller : Address) : Message fork :=
  sMsg b t C caller CODE SEL_name

/-- The success path `name_p1` is not empty: this call runs to the end with no error. -/
theorem name_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C caller : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_name b t C caller) 0 [] .empty gas (sState C []) ss evm ∧
      Ends fork evm s ∧ s.error = none ∧
      s.output = (memW [(32 : U256), (5 : U256), (36844734289029646329610895024640871465484553708195300207132374707301909528576 : U256)]) := by
  have hdata : (m_name b t C caller).data = SEL_name := rfl
  have hsz : (m_name b t C caller).data.size = 4 := size_SEL_name
  have hsl : selector (m_name b t C caller).data = selector SEL_name := rfl
  have hval : (m_name b t C caller).value = 0 := rfl
  have hspec := name_p1 (fork := fork) (message := (m_name b t C caller))
    (state := sState C []) (substate := ss)
    hfork
    (by rw [hsz]; decide)
    (by rw [hsz]; decide)
    (by rw [hsl]; decide)
    (by rw [hval]; decide)
    (Nat.le_refl _)
  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_name b t C caller) (sState C []) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, Or.inl ⟨reaches_toStep hr, hrun⟩, ?_, hH.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

