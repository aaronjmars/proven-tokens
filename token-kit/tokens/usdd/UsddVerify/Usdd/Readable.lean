  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, mask_toU256', eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1 hc2
