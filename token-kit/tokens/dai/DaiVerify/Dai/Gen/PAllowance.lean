theorem ok_allowance (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0xdd62ed3e)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        (isZero (lessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (64 : U256))) ≠ 0 ∧
        (577 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256)))))) ≤ gas ∧
        s.output = (wordBytes (storageAt state message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))) ∧
        s.gas = gas - (577 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256)))))) ∧
        s.state = (readSlot state message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256)))) ∧
        s.substate = (accessSlot substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 45) (fun g hg => allowance_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    by_cases hc2 : (isZero (lessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (64 : U256))) = 0
    ·
      exact (no_okLE (B := 275) (fun g hg => allowance_p1 hfork hsize hsize' hsel hc1 hc2 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
    ·
      obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (577 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))))) (cost := (577 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))))) (fun g hg => allowance_p2 hfork hsize hsize' hsel hc1 hc2 (by omega)) start hrun hok
      exact ⟨hc1, hc2, hcg, ho, hgas, hst, hss⟩

