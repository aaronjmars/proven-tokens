theorem nonces_p0
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x7ecebe00)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 45 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 45) state substate) := by
  step b0_0 hc1 (by simp) (by omega)
  exact haltGasL (b12_0 hfork (by simp) (by omega)) (by omega)

theorem nonces_p1
    (hfork : .berlin ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x7ecebe00)
    (hc1 : (isZero message.value) ≠ 0)
    (hc2 : (isZero (lessThan (sub (BitVec.ofNat 256 message.data.size) (4 : U256)) (32 : U256))) = 0)
    {gas : Nat} (hg : 188 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 188) state substate) := by
  step b0_1 hc1 (by simp) (by omega)
  have hd1 : (lessThan (BitVec.ofNat 256 message.data.size) (4 : U256)) = 0 := by exact size_lt4_zero hsize hsize'
  step b16_0 hd1 (by simp) (by omega)
  have hd2 : (greaterThan (2127478272 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b26_1 hfork hd2 (by simp) (by omega)
  have hd3 : (greaterThan (2835717307 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b43_1 hd3 (by simp) (by omega)
  have hd4 : (equal (2127478272 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b124_0 hd4 (by simp) (by omega)
  step b1185_0 hc2 (by simp) (by omega)
  exact haltGasL (b1203_0 hfork (by simp) (by omega)) (by omega)

