/-- A run of `CODE` from pc 0 with the selector of `name()` that ends with no error
only reads: every storage word is as before and no log is added. -/
theorem ro_name (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x06fdde03)
    {state : State.TransactionState} {substate : Substate}
