  clear h1 e1
  obtain ⟨g3, l3, h3, e3, hg3, -⟩ := SafeL.stepE (pc' := 431) h2 e2 hok
    (fun G hG => hoareL (Gas.pushG (n := 2) (word := (1045 : U256)) (by decide) (by code_fact) (by code_fact) (decode_push 2 (by decide)) (by code_fact) hG (by first | exact Nat.le_of_ble_eq_true rfl | stk_ok))) (by decide)
