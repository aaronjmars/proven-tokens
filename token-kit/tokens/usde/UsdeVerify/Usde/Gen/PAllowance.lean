        ·
          obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (634 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))))) (cost := (634 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))))) (fun g hg => allowance_p4 hfork hsize hsize' hsel hc1 hc2 hc3 hc4 (by omega)) start hrun hok
