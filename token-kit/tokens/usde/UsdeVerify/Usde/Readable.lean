    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, mask_toU256', and_high_comm, add_sub_same, mask_or_high, mask_or_high_addr, mask_and_high, eq_false (by decide : (0 : U256) ≠ 1), eq_false (by decide : (1 : U256) ≠ 0), eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)

