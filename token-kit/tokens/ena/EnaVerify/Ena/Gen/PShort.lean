/-!
# The paths of short and their completeness

Generated by `scripts/gen_paths.py` from the runtime bytecode; do not edit. Lean checks every
statement against `CODE`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 4096

namespace EnaVerify.Paths

open UsdtVerify
open TokenKit
open EnaVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic
open GasCosts

variable {fork : Fork} {message : Message fork}

open EnaVerify.Blocks UsdtVerify.Complete UsdtVerify.Gas TokenKit.Complete

variable {state : State.TransactionState} {substate : Substate}

variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

theorem short_p0
    (hfork : .shapella ≤ fork)
    (hsize : message.data.size < 4)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 44 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 44) state substate) := by
  step b0_0 hc1 (by simp) (by omega)
  exact haltGasL (b12_0 hfork (by simp) (by omega)) (by omega)

theorem short_p1
    (hfork : .shapella ≤ fork)
    (hsize : message.data.size < 4)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : 69 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 69) state substate) := by
  step b0_1 hc1 (by simp) (by omega)
  have hd1 : (lessThan (BitVec.ofNat 256 message.data.size) (4 : U256)) ≠ 0 := by exact size_lt4_ne hsize
  step b15_1 hd1 (by simp) (by omega)
  exact haltGasL (b421_0 hfork (by simp) (by omega)) (by omega)

theorem ok_short (hfork : .shapella ≤ fork)
    (hsize : message.data.size < 4)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    False := by
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 44) (fun g hg => short_p0 hfork hsize hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    exact (no_okLE (B := 69) (fun g hg => short_p1 hfork hsize hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim

end EnaVerify.Paths
