variable {fork : Fork} {message : Message fork}

open EnaVerify.Blocks EnaVerify.Complete UsdtVerify.Complete UsdtVerify.Gas TokenKit.Complete

variable {state : State.TransactionState} {substate : Substate}

variable {bound : Nat} {runChild : MessageRunner fork Nat bound}

theorem decimals_p0
    (hfork : .shapella ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) = 0)
    {gas : Nat} (hg : 44 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted true ByteArray.empty (gas - 44) state substate) := by
  step b0_0 hc1 (by simp) (by omega)
  exact haltGasL (b12_0 hfork (by simp) (by omega)) (by omega)

theorem decimals_p1
    (hfork : .shapella ≤ fork)
    (hsize : 4 ≤ message.data.size)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    (hc1 : (isZero message.value) ≠ 0)
    {gas : Nat} (hg : 257 ≤ gas) :
    Logic.SpecG fork (At CODE message 0 [] .empty gas state substate)
      (Halted false (wordBytes (18 : U256)) (gas - 257) state substate) := by
  step b0_1 hc1 (by simp) (by omega)
  have hd1 : (lessThan (BitVec.ofNat 256 message.data.size) (4 : U256)) = 0 := by exact size_lt4_zero hsize hsize'
  step b15_0 hd1 (by simp) (by omega)
  have hd2 : (greaterThan (2043438992 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b25_0 hfork hd2 (by simp) (by omega)
  have hd3 : (greaterThan (910484757 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b232_0 hd3 (by simp) (by omega)
  have hd4 : (greaterThan (599290589 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b339_1 hd4 (by simp) (by omega)
  have hd5 : (equal (599290589 : U256) (BitVec.ofNat 256 (selector message.data))) = 0 := by rw [hsel]; decide +kernel
  step b351_0 hd5 (by simp) (by omega)
  have hd6 : (equal (826074471 : U256) (BitVec.ofNat 256 (selector message.data))) ≠ 0 := by rw [hsel]; decide +kernel
  step b362_0 hd6 (by simp) (by omega)
  step b527_0 (by simp) (by omega)
  step b530_0 (by simp) (by omega)
  exact haltGasL (b446_3 (by simp) (by omega)) (by omega)

theorem ok_decimals (hfork : .shapella ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x313ce567)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((isZero message.value) ≠ 0 ∧
        257 ≤ gas ∧
        s.output = (wordBytes (18 : U256)) ∧
        s.gas = gas - 257 ∧
        s.state = state ∧
        s.substate = substate) := by
  obtain ⟨hsize, -, -⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  by_cases hc1 : (isZero message.value) = 0
  ·
    exact (no_okLE (B := 44) (fun g hg => decimals_p0 hfork hsize hsize' hsel hc1 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
  ·
    obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := 257) (cost := 257) (fun g hg => decimals_p1 hfork hsize hsize' hsel hc1 (by omega)) start hrun hok
    exact ⟨hc1, hcg, ho, hgas, hst, hss⟩

end EnaVerify.Paths
