        ·
          exact (no_okLE (B := 361) (fun g hg => allowance_p3 hfork hsize hsize' hsel hc1 hc2 hc3 hc4 (by omega)) (fun _ e h => reverted_error e h) start hrun hok).elim
        ·
          obtain ⟨hcg, -, ho, hgas, hst, hss⟩ := ok_exactLE (B := (631 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))))) (cost := (631 + (slotCost (coldIn substate message.currentTarget (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 36 32)) (mapSlot (bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord message.data 4 32)) (3 : U256))))))) (fun g hg => allowance_p4 hfork hsize hsize' hsel hc1 hc2 hc3 hc4 (by omega)) start hrun hok
