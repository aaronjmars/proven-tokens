  simpa using he

/-- The four bytes of the selector of `acceptOwnership()`. -/
def SEL_acceptOwnership : ByteArray := ⟨#[0x79, 0xba, 0x50, 0x97]⟩

theorem size_SEL_acceptOwnership : SEL_acceptOwnership.size = 4 := by decide

/-- The call `acceptOwnership()` from `Witness.CALLER1` to `C`. -/
abbrev m_acceptOwnership (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C : Address) : Message fork :=
  sMsg b t C Witness.CALLER1 CODE SEL_acceptOwnership

set_option maxHeartbeats 1000000 in
