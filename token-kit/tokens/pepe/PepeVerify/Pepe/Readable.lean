  try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, eq_false (by decide : (6 : U256) ≠ 7), eq_false (by decide : (6 : U256) ≠ 8), eq_false (by decide : (6 : U256) ≠ 9), eq_false (by decide : (7 : U256) ≠ 6), eq_false (by decide : (7 : U256) ≠ 8), eq_false (by decide : (7 : U256) ≠ 9), eq_false (by decide : (8 : U256) ≠ 6), eq_false (by decide : (8 : U256) ≠ 7), eq_false (by decide : (8 : U256) ≠ 9), eq_false (by decide : (9 : U256) ≠ 6), eq_false (by decide : (9 : U256) ≠ 7), eq_false (by decide : (9 : U256) ≠ 8), eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte] at hc1
  have v1 := Readable.value_of_cond hc1
  refine ⟨?_, ?_, ?_, ?_⟩
  all_goals first
    | (simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, eq_false (by decide : (6 : U256) ≠ 7), eq_false (by decide : (6 : U256) ≠ 8), eq_false (by decide : (6 : U256) ≠ 9), eq_false (by decide : (7 : U256) ≠ 6), eq_false (by decide : (7 : U256) ≠ 8), eq_false (by decide : (7 : U256) ≠ 9), eq_false (by decide : (8 : U256) ≠ 6), eq_false (by decide : (8 : U256) ≠ 7), eq_false (by decide : (8 : U256) ≠ 9), eq_false (by decide : (9 : U256) ≠ 6), eq_false (by decide : (9 : U256) ≠ 7), eq_false (by decide : (9 : U256) ≠ 8), eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]; done)
    | ((try simp (disch := slot_side) only [Readable.storageAt_writeSlot_ite, storageAt_readSlot, mask_idem, Readable.logs_logSub, Readable.logs_storeSub, Readable.logs_accessSlot, Readable.log3, Readable.low_byte, and_mask_comm, eq_false (by decide : (6 : U256) ≠ 7), eq_false (by decide : (6 : U256) ≠ 8), eq_false (by decide : (6 : U256) ≠ 9), eq_false (by decide : (7 : U256) ≠ 6), eq_false (by decide : (7 : U256) ≠ 8), eq_false (by decide : (7 : U256) ≠ 9), eq_false (by decide : (8 : U256) ≠ 6), eq_false (by decide : (8 : U256) ≠ 7), eq_false (by decide : (8 : U256) ≠ 9), eq_false (by decide : (9 : U256) ≠ 6), eq_false (by decide : (9 : U256) ≠ 7), eq_false (by decide : (9 : U256) ≠ 8), eq_self, ne_eq, not_true_eq_false, not_false_eq_true, ↓reduceIte]); readable_close08)

