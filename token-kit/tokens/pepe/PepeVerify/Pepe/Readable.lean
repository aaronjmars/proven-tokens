/-- `_balances[a]` of the called contract in the state `S`. -/
abbrev balance (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot a 1)

/-- `_allowances[o][sp]` of the called contract in the state `S`. -/
abbrev allowance (m : Message fork) (S : State.TransactionState) (o sp : U256) : U256 :=
  storageAt S m.currentTarget (mapSlot sp (mapSlot o 2))

/-- `_totalSupply` of the called contract in the state `S`. -/
abbrev totalSupply (m : Message fork) (S : State.TransactionState) : U256 :=
  storageAt S m.currentTarget 3

/-- The caller, as an address word. -/
abbrev sender (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) m.caller.toU256

/-- The first argument, masked to an address word. -/
abbrev addrArg1 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 4 32)

/-- The second argument, masked to an address word. -/
abbrev addrArg2 (m : Message fork) : U256 := bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (loadWord m.data 36 32)

/-- The argument words. -/
abbrev arg1 (m : Message fork) : U256 := loadWord m.data 4 32
abbrev arg2 (m : Message fork) : U256 := loadWord m.data 36 32
abbrev arg3 (m : Message fork) : U256 := loadWord m.data 68 32

/-- The fourth argument word. -/
abbrev arg4 (m : Message fork) : U256 := loadWord m.data 100 32

/-- `owner()` of the called contract in the state `S`: the address in slot 0. -/
abbrev ownerOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (storageAt S m.currentTarget 0)

/-- `uniswapV2Pair` of the called contract in the state `S`: the address in slot 9. -/
abbrev pairOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd (1461501637330902918203684832716283019655932542975 : U256) (storageAt S m.currentTarget 9)

/-- The byte of `limited` of the called contract in the state `S` (not 0: limited). -/
abbrev limitedOf (m : Message fork) (S : State.TransactionState) : U256 :=
  bitwiseAnd 255 (storageAt S m.currentTarget 6)

/-- The byte of `blacklists[a]` of the called contract in the state `S` (not 0: blacklisted). -/
abbrev blacklisted (m : Message fork) (S : State.TransactionState) (a : U256) : U256 :=
  bitwiseAnd 255 (storageAt S m.currentTarget (mapSlot a 10))

/-- `maxHoldingAmount` and `minHoldingAmount` of the called contract in the state `S`. -/
abbrev maxHolding (m : Message fork) (S : State.TransactionState) : U256 :=
  storageAt S m.currentTarget 7
abbrev minHolding (m : Message fork) (S : State.TransactionState) : U256 :=
  storageAt S m.currentTarget 8

/-- The topic of the event `Transfer(address,address,uint256)`. -/
abbrev TRANSFER : U256 := (100389287136786176327247604509743168900146139575972864366142685224231313322991 : U256)

/-- The topic of the event `Approval(address,address,uint256)`. -/
abbrev APPROVAL : U256 := (63486140976153616755203102783360879283472101686154884697241723088393386309925 : U256)

/-- The topic of the event `OwnershipTransferred(address,address)`. -/
abbrev OWNERSHIP : U256 := (63267312222310607310220992301550539520881909915348243260808268974908359596000 : U256)

/-- totalSupply(). Success needs no value. Then: returns `_totalSupply`; no slot changes; no log. -/
theorem totalSupply_readable (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x18160ddd)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    ((message.value = 0)) ∧
