  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_transferOwnership b t C) (sState C [(0, Witness.CALLER1W)]) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, fun rc within => Witness.endsL_of_reaches hr hrun rc within, ?_,
    hH.2.2.1, hH.2.2.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

/-- The four bytes of the selector of `renounceOwnership()`. -/
def SEL_renounceOwnership : ByteArray := ⟨#[0x71, 0x50, 0x18, 0xa6]⟩

theorem size_SEL_renounceOwnership : SEL_renounceOwnership.size = 4 := by decide

/-- The call `renounceOwnership()` from `Witness.CALLER1` to `C`. -/
abbrev m_renounceOwnership (b : BlockEnvironment fork) (t : TransactionEnvironment fork)
    (C : Address) : Message fork :=
  sMsg b t C Witness.CALLER1 CODE SEL_renounceOwnership

set_option maxHeartbeats 1000000 in
/-- The success path `renounceOwnership_p3` is not empty: this call runs to the end with no error. -/
theorem renounceOwnership_runs (hfork : .berlin ≤ fork) (b : BlockEnvironment fork)
    (t : TransactionEnvironment fork) (C : Address) (ss : Substate) :
    ∃ (gas : Nat) (evm s : Evm fork Nat),
      At CODE (m_renounceOwnership b t C) 0 [] .empty gas (sState C [(0, Witness.CALLER1W)]) ss evm ∧
      (∀ {bound : Nat} (runChild : MessageRunner fork Nat bound),
        GasMeter.gasHeld evm.gas ≤ bound → EndsL runChild evm s) ∧ s.error = none ∧
      s.output = ByteArray.empty ∧
      s.state = (writeSlot (readSlot (readSlot (sState C [(0, Witness.CALLER1W)]) (m_renounceOwnership b t C).currentTarget (0 : U256)) (m_renounceOwnership b t C).currentTarget (0 : U256)) (m_renounceOwnership b t C).currentTarget (0 : U256) (bitwiseOr (0 : U256) (bitwiseAnd (storageAt (readSlot (sState C [(0, Witness.CALLER1W)]) (m_renounceOwnership b t C).currentTarget (0 : U256)) (m_renounceOwnership b t C).currentTarget (0 : U256)) (115792089237316195423570985007226406215939081747436879206741300988257197096960 : U256)))) := by
  have hdata : (m_renounceOwnership b t C).data = SEL_renounceOwnership := rfl
  have hsz : (m_renounceOwnership b t C).data.size = 4 := size_SEL_renounceOwnership
  have hsl : selector (m_renounceOwnership b t C).data = selector SEL_renounceOwnership := rfl
  have hval : (m_renounceOwnership b t C).value = 0 := rfl
  have hcw : (m_renounceOwnership b t C).caller.toU256 = Witness.CALLER1W := Witness.caller1_toU256
  have hct : (m_renounceOwnership b t C).currentTarget = C := rfl
  have hacc : hasAccount (sState C [(0, Witness.CALLER1W)]) C := hasAccount_sState C _
  have hspec := renounceOwnership_p3 (fork := fork) (message := (m_renounceOwnership b t C))
    (state := sState C [(0, Witness.CALLER1W)]) (substate := ss)
    hfork
    (by rw [hsz]; decide)
    (by rw [hsz]; decide)
    (by rw [hsl]; decide)
    rfl
    hacc
    (by
      simp (disch := supply_side) only
        [hval, hsz, hcw, hct, storageAt_readSlot, Readable.storageAt_writeSlot_ite, storageAt_sState_cons, storageAt_sState_nil]
      <;> decide +kernel)
    (by
      simp (disch := supply_side) only
        [hval, hsz, hcw, hct, storageAt_readSlot, Readable.storageAt_writeSlot_ite, storageAt_sState_cons, storageAt_sState_nil]
      <;> decide +kernel)
    (Nat.lt_succ_self _)
  obtain ⟨s, hr, hrun, hH⟩ := hspec (sFrame (m_renounceOwnership b t C) (sState C [(0, Witness.CALLER1W)]) ss _)
    (at_sFrame _ rfl _ _ _)
  refine ⟨_, _, s, at_sFrame _ rfl _ _ _, fun rc within => Witness.endsL_of_reaches hr hrun rc within, ?_,
    hH.2.2.1, hH.2.2.2.2.1⟩
  obtain ⟨-, he, -⟩ := hH
  simpa using he

