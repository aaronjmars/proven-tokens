    Ro message.currentTarget state substate s.state s.substate := by
  obtain ⟨hc1, -, z, hz, hzr⟩ := Paths.ok_nameEntry hfork hsize' hsel start hrun hok
  exact name_safe_327 hfork _ hz hzr hok

theorem symbol_s335 (hfork : .berlin ≤ fork) {x0 x1 : U256} {mem : ByteArray} {g : Nat} {S : State.TransactionState} {ss : Substate}
