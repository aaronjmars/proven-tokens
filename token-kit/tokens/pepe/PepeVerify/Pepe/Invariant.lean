/-- From Berlin, a run of `CODE` from pc 0 that ends with no error, with any selector,
keeps the invariant: if the sum of all balances was `_totalSupply` before, it is after.
`hsep` is the hypothesis on keccak (not proved). -/
theorem supply_preserved (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsep : Sep (callKeys message))
    (hinv : Inv message.currentTarget state)
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Inv message.currentTarget s.state := by
  obtain ⟨_, _, i, hi⟩ := ends_ok_dispatch hfork hsize' start hrun hok
  match i, hi with
  | ⟨0, _⟩, hi =>
    have h : selector message.data = 0x8da5cb5b := hi
    exact supply_owner hfork hsize' h hsep hinv start hrun hok
  | ⟨1, _⟩, hi =>
    have h : selector message.data = 0x95d89b41 := hi
    exact supply_symbol hfork hsize' h hinv start hrun hok
  | ⟨2, _⟩, hi =>
    have h : selector message.data = 0xa457c2d7 := hi
    exact supply_decreaseAllowance hfork hsize' h hsep hinv start hrun hok
  | ⟨3, _⟩, hi =>
    have h : selector message.data = 0xa9059cbb := hi
    exact supply_transfer hfork hsize' h hsep hinv start hrun hok
  | ⟨4, _⟩, hi =>
    have h : selector message.data = 0xdd62ed3e := hi
    exact supply_allowance hfork hsize' h hsep hinv start hrun hok
  | ⟨5, _⟩, hi =>
    have h : selector message.data = 0xf2fde38b := hi
    exact supply_transferOwnership hfork hsize' h hsep hinv start hrun hok
  | ⟨6, _⟩, hi =>
    have h : selector message.data = 0x49bd5a5e := hi
    exact supply_uniswapV2Pair hfork hsize' h hsep hinv start hrun hok
  | ⟨7, _⟩, hi =>
    have h : selector message.data = 0x70a08231 := hi
    exact supply_balanceOf hfork hsize' h hsep hinv start hrun hok
  | ⟨8, _⟩, hi =>
    have h : selector message.data = 0x715018a6 := hi
    exact supply_renounceOwnership hfork hsize' h hsep hinv start hrun hok
  | ⟨9, _⟩, hi =>
    have h : selector message.data = 0x860a32ec := hi
    exact supply_limited hfork hsize' h hsep hinv start hrun hok
  | ⟨10, _⟩, hi =>
    have h : selector message.data = 0x89f9a1d3 := hi
    exact supply_maxHoldingAmount hfork hsize' h hsep hinv start hrun hok
  | ⟨11, _⟩, hi =>
    have h : selector message.data = 0x23b872dd := hi
    exact supply_transferFrom hfork hsize' h hsep hinv start hrun hok
  | ⟨12, _⟩, hi =>
    have h : selector message.data = 0x313ce567 := hi
    exact supply_decimals hfork hsize' h hsep hinv start hrun hok
  | ⟨13, _⟩, hi =>
    have h : selector message.data = 0x39509351 := hi
    exact supply_increaseAllowance hfork hsize' h hsep hinv start hrun hok
  | ⟨14, _⟩, hi =>
    have h : selector message.data = 0x3aa633aa := hi
    exact supply_setRule hfork hsize' h hsep hinv start hrun hok
  | ⟨15, _⟩, hi =>
    have h : selector message.data = 0x404e5129 := hi
    exact supply_blacklist hfork hsize' h hsep hinv start hrun hok
  | ⟨16, _⟩, hi =>
    have h : selector message.data = 0x42966c68 := hi
    exact supply_burn hfork hsize' h hsep hinv start hrun hok
  | ⟨17, _⟩, hi =>
    have h : selector message.data = 0x06fdde03 := hi
    exact supply_name hfork hsize' h hinv start hrun hok
  | ⟨18, _⟩, hi =>
    have h : selector message.data = 0x095ea7b3 := hi
    exact supply_approve hfork hsize' h hsep hinv start hrun hok
  | ⟨19, _⟩, hi =>
    have h : selector message.data = 0x16c02129 := hi
    exact supply_blacklists hfork hsize' h hsep hinv start hrun hok
  | ⟨20, _⟩, hi =>
    have h : selector message.data = 0x18160ddd := hi
    exact supply_totalSupply hfork hsize' h hsep hinv start hrun hok
  | ⟨21, _⟩, hi =>
    have h : selector message.data = 0x1ab99e12 := hi
    exact supply_minHoldingAmount hfork hsize' h hsep hinv start hrun hok
  | ⟨n + 22, hn⟩, _ => exact absurd hn (by omega)

end PepeVerify
